#helpHead b{font-size:16px}#helpHead input{flex:1;max-width:340px}
#helpMain{display:flex;min-height:0;flex:1}
#helpNav{width:230px;flex:none;overflow:auto;border-right:1px solid var(--line);padding:8px 0}
#helpNav a{display:block;padding:6px 14px;color:var(--fg);text-decoration:none;font-size:13px;cursor:pointer}
#helpNav a:hover,#helpNav a.cur{background:var(--hover,#2b2f36)}
#helpBody{flex:1;overflow:auto;padding:6px 24px 30px;font-size:14px;line-height:1.55}
#helpBody h2{font-size:18px;margin:22px 0 8px;padding-top:6px;border-top:1px solid var(--line)}#helpBody h2:first-child{border-top:0}
#helpBody h3{font-size:15px;margin:14px 0 4px}
#helpBody kbd{display:inline-block;min-width:18px;padding:0 5px;border:1px solid var(--line);border-bottom-width:2px;border-radius:4px;font:12px/18px system-ui,sans-serif;text-align:center;background:var(--bg)}
#helpBody table{border-collapse:collapse;margin:6px 0 10px}#helpBody td{border-top:1px solid var(--line);padding:4px 12px 4px 0;vertical-align:top}
#helpBody .note{color:var(--mut);font-size:13px}
#helpBody .ver{color:var(--mut);font-size:12px}
