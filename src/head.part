<!doctype html>
<html lang="ru" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Просмотр DXF</title>
<!--@@PWAHEAD@@-->
<style>
:root{--prevw:480px;--treew:270px;--lthumb:76px;--bg:#1b1d21;--panel:#24272c;--line:#363a41;--line2:#2c2f35;--fg:#e6e6e6;--mut:#9aa0a8;--acc:#4ea1ff;--warn:#e5b54a;--err:#ff6b6b;
  --cv:#0f1012;--btn:#30343a;--btnh:#5a6069;--inp:#16181b;--on:#25425f;--hover:#2c3138;--pair:#3a2b2a;--pairb:#7a4a44;--ph:#5c626b;
  --tile:180px;--listw:380px}
:root[data-theme=light]{--bg:#eef0f3;--panel:#ffffff;--line:#d3d7dd;--line2:#e7e9ed;--fg:#1d2024;--mut:#67707b;--acc:#1f6fd1;--warn:#c98a00;--err:#d93636;
  --cv:#f7f8fa;--btn:#f3f4f6;--btnh:#9aa1ab;--inp:#ffffff;--on:#dbe8fb;--hover:#edf3fb;--pair:#fbece9;--pairb:#d9a59c;--ph:#9aa0a8}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0;height:100%;background:var(--bg);color:var(--fg);font:14px/1.35 system-ui,"Segoe UI",Roboto,sans-serif}
body{display:flex;flex-direction:column;overflow:hidden}
header{display:flex;flex-wrap:wrap;gap:6px;align-items:center;padding:8px;background:var(--panel);border-bottom:1px solid var(--line)}
.brand{font-weight:700;letter-spacing:.5px;margin-right:4px}
.brand small{color:var(--mut);font-weight:400}
button{background:var(--btn);color:var(--fg);border:1px solid var(--line);border-radius:6px;padding:7px 11px;font:inherit;cursor:pointer;white-space:nowrap}
button:hover{border-color:var(--btnh)}
button.on{background:var(--on);border-color:var(--acc)}
input[type=search],select{background:var(--inp);color:var(--fg);border:1px solid var(--line);border-radius:6px;padding:7px 8px;font:inherit}
input[type=search]{flex:1 1 140px;min-width:90px}
input[type=range]{width:110px}
#logBadge{background:var(--warn);color:#000;border-radius:9px;padding:0 6px;font-size:12px;font-weight:700;margin-left:4px}
#status{padding:4px 10px;color:var(--mut);font-size:12px;min-height:22px}
#status.flash{color:var(--warn)}
#cmpBar,#selBar{display:flex;gap:10px;align-items:center;padding:5px 10px;background:var(--on);font-size:13px;flex-wrap:wrap}
#cmpBar .sp{flex:1}
#cmpBar b{font-weight:600}
#selBar{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);z-index:9;border:1px solid var(--acc);border-radius:10px;box-shadow:0 6px 24px rgba(0,0,0,.4)}
.tile.sel{outline:2px dashed var(--warn);outline-offset:-3px}
.cmpb{position:absolute;left:4px;top:4px;border-radius:5px;padding:0 6px;font-size:11px;font-weight:700;cursor:pointer;color:#fff}
.cmpb.same{background:#2e8b57}.cmpb.diff{background:#d9822b}.cmpb.new{background:#3a7bd5}
body.follower header,body.follower #updBar,body.follower #status,body.follower #work,body.follower #cmpBar{display:none!important}
#updBar{background:var(--on);padding:6px 10px;display:flex;gap:10px;align-items:center}

/* рабочая область: сетка или список + просмотр */
#work{flex:1;display:flex;min-height:0}
#tree{flex:none;width:var(--treew);overflow:auto;border-right:1px solid var(--line);background:var(--panel);padding:4px 0 10px;font-size:13px}
.tr{display:flex;align-items:center;gap:2px;padding:4px 8px 4px 0;cursor:pointer;white-space:nowrap;user-select:none}
.tr:hover{background:var(--hover)}
.tr.sel{background:var(--on);box-shadow:inset 3px 0 0 var(--acc)}
.tr .cr{width:18px;flex:none;text-align:center;color:var(--mut);font-size:11px}
.tr .tn{overflow:hidden;text-overflow:ellipsis;flex:1}
.tr .tc{color:var(--mut);font-size:11px;margin-left:6px;flex:none}
.tr.all{font-weight:600}
.tree-h{display:flex;align-items:center;padding:4px 8px 6px;color:var(--mut);font-size:12px;border-bottom:1px solid var(--line2);margin-bottom:4px}
.tree-h .sp{flex:1}
.tree-h button{padding:2px 7px;font-size:12px}
main#gridWrap{flex:1;overflow:auto;padding:8px;min-height:0;min-width:0}
body.explorer main#gridWrap{flex:none;width:var(--listw);padding:4px}
body.gridprev main#gridWrap{flex:1;width:auto;padding:8px}
body.gridprev #dock{flex:none;width:var(--prevw)}
.splitter{flex:none;width:6px;cursor:col-resize;background:var(--line);touch-action:none}
.splitter:hover,.splitter.drag{background:var(--acc)}
#dock{flex:1;min-width:0;display:flex}
#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(var(--tile),1fr));gap:8px}
#empty{max-width:560px;margin:10vh auto;text-align:center;color:var(--mut);line-height:1.6;border:2px dashed var(--line);border-radius:12px;padding:30px 20px}
body.drag main#gridWrap{outline:2px dashed var(--acc);outline-offset:-6px}
.tile{background:var(--panel);border:1px solid var(--line);border-radius:8px;overflow:hidden;cursor:pointer;user-select:none}
.tile:hover{border-color:var(--btnh)}
.tile.cur{border-color:var(--acc);box-shadow:0 0 0 2px var(--acc)}
body.kbd .tile:hover:not(.cur){border-color:var(--line)}
body.kbd #grid.list .tile:hover:not(.cur){background:transparent;border-color:transparent}
.th{position:relative;aspect-ratio:4/3;background:var(--cv)}
.th img{width:100%;height:100%;object-fit:contain;display:block}
.ph{position:absolute;inset:0;display:grid;place-items:center;color:var(--ph);font-size:12px}
.badge{position:absolute;top:4px;right:4px;background:var(--warn);color:#000;border-radius:10px;padding:0 6px;font-size:11px;font-weight:700}
.badge.err{background:var(--err);color:#fff}
.tag{position:absolute;left:4px;bottom:4px;background:#b8483f;color:#fff;border-radius:4px;padding:0 5px;font-size:10px;font-weight:700}
.tx{padding:5px 7px;min-width:0}
.nm{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.meta{font-size:11px;color:var(--mut);margin-top:2px}
.meta:empty{display:none}
#grid.wrapnm .nm{white-space:normal;word-break:break-word}
#grid.nonm .nm{display:none}
#grid.nocap .tx{display:none}
.xfb{position:absolute;right:4px;bottom:4px;background:var(--acc);color:#fff;border-radius:4px;padding:0 5px;font-size:10px;font-weight:700}
.szbox{display:flex;align-items:center;gap:3px}
.szbox button{padding:5px 9px}
/* режим «Проводник»: строки */
#grid.list{display:flex;flex-direction:column;gap:2px}
#grid.list .tile{display:flex;align-items:center;gap:8px;padding:3px 6px 3px 3px;border-radius:6px;border-color:transparent;background:transparent}
#grid.list .tile:hover{background:var(--hover)}
#grid.list .tile.cur{background:var(--on);border-color:var(--acc);box-shadow:none}
#grid.list .th{width:var(--lthumb);flex:none;border-radius:4px;overflow:hidden}
#grid.list .tag{display:none}
#grid.list .badge{top:2px;right:2px;font-size:10px;padding:0 5px}
#grid.list .tx{flex:1;padding:0}
#grid.list .nm{white-space:normal;word-break:break-word;font-size:13px}

/* окно просмотра */
#viewer{display:flex;flex-direction:column;background:var(--cv);min-width:0}
#dock>#viewer{flex:1}
#viewer.full{position:fixed;inset:0;z-index:10}
.vbar{display:flex;gap:6px;align-items:center;padding:6px;background:var(--panel);border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:thin}
.vbar>*{flex:none}
#vPgNum{white-space:nowrap}
#vName{flex:1 1 auto;min-width:60px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 4px}
#vPages{display:flex;gap:4px;align-items:center;color:var(--mut);font-size:13px}
.pairbox{display:flex}
.xfbox{display:flex;gap:2px}
.xfbox button{padding:7px 9px}
#vPair{background:var(--pair);border-color:var(--pairb);border-radius:6px 0 0 6px}
#vPair.none{background:var(--btn);border-color:var(--line);color:var(--mut)}
#vPairMenu{border-radius:0 6px 6px 0;border-left:none;padding:7px 8px}
#stageWrap{flex:1;position:relative;min-height:0}
#stage{position:absolute;inset:0;display:grid;gap:3px;background:var(--line)}
#stageMsg{position:absolute;inset:0;display:grid;place-items:center;color:var(--mut);background:var(--cv);text-align:center;padding:20px}
.pane{position:relative;min-width:0;min-height:0;overflow:hidden}
.pane canvas{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none;cursor:crosshair}
.pcap{display:none;position:absolute;left:6px;top:6px;z-index:2;background:rgba(20,22,26,.78);color:#e6e6e6;font-size:12px;padding:3px 4px 3px 8px;border-radius:6px;
  max-width:calc(100% - 12px);gap:6px;align-items:center;pointer-events:none;flex-wrap:wrap}
.pcap .cn{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;max-width:100%}
.pcap .ch{background:rgba(255,255,255,.14);border-radius:4px;padding:0 6px;white-space:nowrap;font-variant-numeric:tabular-nums}
.pcap .ch.dim{background:rgba(78,161,255,.28)}
.pcap .ch.dup{background:#d9822b;color:#fff;cursor:help;pointer-events:auto}
#stage.multi .pcap,#stage.capone .pcap{display:flex}
#stage.multi .pane.active{outline:2px solid var(--acc);outline-offset:-2px;z-index:1}
#stage.multi .pane.active .pcap{background:var(--acc);color:#fff}
.pxf{position:absolute;right:6px;top:6px;z-index:3;display:flex;gap:6px;align-items:center;background:var(--warn);color:#000;font-size:12px;font-weight:600;
  padding:3px 4px 3px 9px;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.35)}
.pxf.orig{background:var(--mut);color:#fff}
.pxf button{padding:2px 8px;font-size:12px;background:rgba(255,255,255,.85);color:#000;border-color:rgba(0,0,0,.25)}
.vinfo{display:flex;gap:16px;align-items:center;padding:4px 10px;font-size:12px;color:var(--mut);background:var(--panel);border-top:1px solid var(--line);flex-wrap:wrap;min-height:28px}
.vinfo .sp{flex:1}
#vWarn{background:none;border:none;color:var(--warn);padding:2px 4px;font-size:12px}

/* всплывающие панели */
.pop{position:fixed;top:50px;right:8px;width:min(460px,calc(100vw - 16px));max-height:76vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:10px;z-index:15;box-shadow:0 8px 30px rgba(0,0,0,.35)}
.pp-h{display:flex;gap:6px;align-items:center;padding:8px 10px;border-bottom:1px solid var(--line)}
.pp-h .sp{flex:1}
.pp-row{display:flex;gap:8px;align-items:center;padding:6px 10px;font-size:13px}
.pp-name{flex:1;cursor:pointer;color:var(--acc);word-break:break-all}
.pp-tag{font-size:11px;color:var(--mut)}
.pp-row button{padding:3px 8px;font-size:12px}
.pp-c{cursor:pointer;color:var(--fg);word-break:break-all;border-top:1px solid var(--line2)}
.pp-c:hover{background:var(--hover)}
.pp-s{padding:10px 10px 6px;color:var(--mut);font-size:12px;border-top:1px solid var(--line);margin-top:4px}
.pp-empty{padding:6px 10px;color:var(--mut);font-size:13px}
.set-row{display:flex;gap:10px;align-items:center;justify-content:space-between;padding:8px 12px}
.set-row select{min-width:170px}
.set-row input[type=color]{width:38px;height:32px;padding:0;border:1px solid var(--line);border-radius:6px;background:none;cursor:pointer}
.set-sec{padding:12px 12px 4px;font-weight:600;border-top:1px solid var(--line);margin-top:6px}
.cap-t{width:calc(100% - 24px);margin:2px 12px 8px;border-collapse:collapse;font-size:13px}
.cap-t td,.cap-t th{padding:4px 6px;text-align:center}
.cap-t td:first-child,.cap-t th:first-child{text-align:left}
.cap-t th{color:var(--mut);font-weight:500;font-size:12px}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:20;display:flex;justify-content:center;padding:4vh 3vw}
.lp{background:var(--panel);border:1px solid var(--line);border-radius:10px;width:min(920px,100%);display:flex;flex-direction:column;min-height:0}
.lph{display:flex;gap:8px;align-items:center;padding:10px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.lph .sp{flex:1}
.lbody{overflow:auto;padding:6px 12px;flex:1;font-size:13px}
.lf{margin:8px 0 12px}
.lf h4{margin:0 0 3px;font-size:13px;color:var(--acc);cursor:pointer;word-break:break-all}
.lf div{padding:1px 0 1px 12px}
.l-info{color:var(--mut)}.l-warn{color:var(--warn)}.l-error{color:var(--err)}
.lpf{padding:8px 12px;border-top:1px solid var(--line);color:var(--mut);font-size:12px}
.h-day{margin:12px 0 4px;font-weight:600;color:var(--mut);font-size:12px;text-transform:uppercase;letter-spacing:.4px}
.h-row{display:flex;gap:10px;align-items:baseline;padding:5px 6px;border-radius:6px;cursor:pointer}
.h-row:hover{background:var(--hover)}
.h-t{color:var(--mut);font-variant-numeric:tabular-nums;flex:none;width:42px}
.h-n{word-break:break-word}
.h-pdf .h-n::after{content:"PDF";margin-left:6px;font-size:10px;font-weight:700;background:#b8483f;color:#fff;border-radius:3px;padding:0 4px;vertical-align:1px}
.h-f{color:var(--mut);font-size:12px;margin-left:auto;text-align:right;word-break:break-word}
.h-off .h-n,.h-off .h-t{opacity:.55}
.hg{display:flex;gap:6px;align-items:baseline;padding:4px 6px;border-radius:6px;cursor:pointer}
.hg:hover{background:var(--hover)}
.hg .cr{width:16px;flex:none;color:var(--mut);font-size:11px;text-align:center}
.hg .hn{word-break:break-word}
.hg.fold .hn{font-weight:600}
.hg.proj{margin-top:6px}
.hg .hm{color:var(--mut);font-size:12px;margin-left:auto;white-space:nowrap;padding-left:10px}
.hg button{visibility:hidden;padding:1px 7px;font-size:11px;flex:none}
.hg:hover button{visibility:visible}
@media (hover:none){.hg button{visibility:visible}}
.pin{display:flex;gap:8px;align-items:center;padding:7px 10px;border-top:1px solid var(--line2);cursor:pointer}
.pin:hover{background:var(--hover)}
.pin .pi{flex:none;width:18px;text-align:center}
.pin .pt{flex:1;min-width:0}
.pin .pl{word-break:break-word}
.pin .pp{color:var(--mut);font-size:11px;word-break:break-word}
.pin button{padding:2px 7px;font-size:12px;visibility:hidden;flex:none}
.pin:hover button{visibility:visible}
@media (hover:none){.pin button{visibility:visible}}
.pin.off{opacity:.55}
.pin-add{display:flex;flex-direction:column;gap:6px;padding:8px 10px}
.pin-add button{text-align:left;white-space:normal}
.h-pin{visibility:hidden;padding:1px 7px;font-size:11px;flex:none}
.h-row:hover .h-pin{visibility:visible}
@media (hover:none){.h-pin{visibility:visible}}
.h-del{visibility:hidden;padding:1px 7px;font-size:11px;flex:none}
.h-row:hover .h-del{visibility:visible}
@media (hover:none){.h-del{visibility:visible}}
@media (max-width:759px){#btnPreview{display:none}#tree{position:fixed;left:0;top:0;bottom:0;width:84vw;z-index:12;box-shadow:0 0 40px rgba(0,0,0,.5)}}
@media (max-width:600px){
  header{gap:5px;padding:6px}
  button{padding:7px 9px}
  input[type=range]{width:80px}
  .hide-m{display:none}
}
</style>
</head>
<body>
<header>
  <div class="brand">DXF <small>+PDF · v3.3</small></div>
  <button id="btnFolder" title="Открыть папку целиком (с подпапками)">Папка</button>
  <button id="btnFiles" title="Выбрать отдельные файлы">Файлы</button>
  <button id="btnPins" title="Ярлыки — закреплённые папки и файлы">★ Ярлыки</button>
  <button id="btnHist" title="История просмотров">История</button>
  <button id="btnTree" hidden title="Дерево папок изделия">Папки ▸</button>
  <input id="filter" type="search" placeholder="Фильтр по имени">
  <select id="typeSel" title="Тип файлов"><option value="">Все</option><option value="dxf">DXF</option><option value="pdf">PDF</option></select>
  <button id="btnLayout" title="Сетка миниатюр или список"></button>
  <button id="btnPreview" title="Окно просмотра справа, как в Проводнике">◫ Просмотр</button>
  <span class="szbox" title="Размер миниатюр (Ctrl + колесо над списком)"><button id="szMinus">−</button><input id="tileSize" type="range" min="80" max="600" value="180"><button id="szPlus">+</button></span>
  <button id="btnLog">Журнал<span id="logBadge" hidden></span></button>
  <button id="btnCmp" hidden title="Сравнить с другой папкой (прошлый заказ, архив)">⇆ Сравнить</button>
  <button id="btnClose" hidden title="Закрыть все файлы">Закрыть</button>
  <button id="btnSet" title="Настройки: тема, фон, подписи">⚙</button>
  <input id="inFolder" type="file" webkitdirectory multiple hidden>
  <input id="inFiles" type="file" multiple hidden accept=".dxf,.pdf,application/pdf,*/*">
</header>
<div id="updBar" hidden>Доступна новая версия<button id="updBtn">Обновить</button></div>
<div id="status"></div>
<div id="cmpBar" hidden><span id="cmpInfo"></span><span class="sp"></span>
  <label>Показать <select id="cmpFilter"><option value="">все</option><option value="diff">≠ отличаются</option><option value="new">новые</option><option value="same">= совпадают</option></select></label>
  <button id="cmpOnlyBtn"></button><button id="cmpEnd" title="Закончить сравнение">✕</button></div>
<div id="selBar" hidden><span id="selInfo"></span><button id="selGo">Сравнить рядом</button><button id="selClear">✕</button></div>
<div id="work">
  <nav id="tree" hidden><div class="tree-h">Папки<span class="sp"></span><button id="treeExpand">развернуть</button><button id="treeFold">свернуть</button><button id="treeHide" title="Скрыть дерево">✕</button></div><div id="treeBody"></div></nav>
  <div id="split2" class="splitter" hidden title="Потяните, чтобы изменить ширину дерева"></div>
  <main id="gridWrap">
    <div id="empty">
      Откройте папку с DXF и PDF кнопкой <b>«Папка»</b> или перетащите папку/файлы в это окно.<br>
      На телефоне — кнопка <b>«Файлы»</b>.<br><br>
      <span class="hide-m">В просмотре: колесо — масштаб, перетаскивание — сдвиг, двойной клик или <b>F</b> — показать всё,<br>
      <b>← →</b> — листать, <b>Tab</b> — по кругу чертёж ⇄ развёртки, <b>R</b> — «Рядом», <b>Q/E</b> — поворот, <b>M</b> — зеркало,<br><b>PgUp/PgDn</b> — страницы PDF, <b>Esc</b> — назад.</span>
    </div>
    <div id="grid"></div>
  </main>
  <div id="split" class="splitter" hidden title="Потяните, чтобы изменить ширину списка"></div>
  <div id="dock" hidden></div>
</div>

<div id="viewer" hidden>
  <div class="vbar">
    <button id="vClose" title="Назад к миниатюрам (Esc)">✕</button>
    <button id="vPrev" title="Предыдущий (←)">‹</button>
    <button id="vNext" title="Следующий (→)">›</button>
    <span id="vName"></span>
    <span id="vPages" hidden><button id="vPgPrev" title="Предыдущая страница (PgUp)">▲</button><span id="vPgNum"></span><button id="vPgNext" title="Следующая страница (PgDn)">▼</button></span>
    <span class="pairbox"><button id="vPair" hidden></button><button id="vPairMenu" title="Связанные файлы, ручной выбор пары">▾</button></span>
    <span id="vXf" class="xfbox"><button id="vRotL" title="Повернуть на 90° против часовой (Q)">⟲</button><button id="vRotR" title="Повернуть на 90° по часовой (E)">⟳</button><button id="vMir" title="Зеркально слева направо (M)">⇋</button></span>
    <button id="vPin" title="Добавить файл в ярлыки">★</button>
    <button id="vSide" title="Чертёж и все его развёртки одновременно (R)">Рядом</button>
    <button id="vLw" class="on hide-m" title="Показывать толщины линий из файла">Толщины</button>
    <button id="vFit" title="Показать всё (F, двойной клик)">Показать всё</button>
    <button id="vSync" hidden title="Синхронный масштаб и сдвиг (L)">🔒 синхронно</button>
    <button id="vMon" hidden title="Пара текущего файла — на втором мониторе">🖵 2-й монитор</button>
    <button id="vFull" hidden title="На весь экран (Enter)">⛶</button>
  </div>
  <div id="stageWrap"><div id="stage"></div><div id="stageMsg" hidden></div></div>
  <div class="vinfo"><span id="vDims"></span><span id="vCoord"></span><span class="sp"></span><button id="vWarn" hidden></button></div>
</div>

<div id="pairPanel" class="pop" hidden>
  <div class="pp-h"><b id="ppTitle"></b><span class="sp"></span><button id="ppReset" hidden title="Убрать ручные связи и вернуть автоподбор">авто</button><button id="ppClose">✕</button></div>
  <div id="ppLinked"></div>
  <div class="pp-s">Выбрать вручную (связь запомнится):</div>
  <div style="padding:0 10px 6px"><input id="ppSearch" type="search" placeholder="Поиск по имени" style="width:100%"></div>
  <div id="ppList"></div>
  <div class="pp-s">Ручные связи действуют:
    <select id="ppMode" style="margin-top:6px;width:100%">
      <option value="folder">только в этой папке (по умолчанию)</option>
      <option value="size">в любой папке, если имя и размер файлов совпадают</option>
    </select>
  </div>
</div>

<div id="pinPanel" class="pop" hidden style="right:auto;left:8px">
  <div class="pp-h"><b>Ярлыки</b><span class="sp"></span><button id="pinClose">✕</button></div>
  <div id="pinAdd"></div>
  <div id="pinList"></div>
  <div class="pp-s" id="pinFoot" style="margin:0"></div>
</div>

<div id="cmpPanel" class="pop" hidden style="right:auto;left:8px">
  <div class="pp-h"><b>Сравнить с папкой</b><span class="sp"></span><button id="cmpClose">✕</button></div>
  <div class="pin-add"><button id="cmpPick">📁 Выбрать папку…</button></div>
  <div id="cmpRecent"></div>
  <div class="pp-s" style="margin:0">Файлы сопоставляются по обозначению (децимальному номеру), сравниваются имя и размер. Содержимое читается только при открытии файлов рядом.</div>
  <input id="inCmp" type="file" webkitdirectory multiple hidden>
</div>
<div id="onlyPanel" class="pop" hidden style="right:auto;left:8px">
  <div class="pp-h"><b id="onlyTitle"></b><span class="sp"></span><button id="onlyClose">✕</button></div>
  <div id="onlyList"></div>
</div>

<div id="setPanel" class="pop" hidden>
  <div class="pp-h"><b>Настройки</b><span class="sp"></span><button id="setClose">✕</button></div>
  <div class="set-row"><span>Тема</span><select id="sTheme"><option value="dark">Тёмная</option><option value="light">Светлая</option><option value="auto">Как в системе</option></select></div>
  <div class="set-sec">Фон</div>
  <div class="set-row"><span>DXF</span><span><select id="sBgDxf"></select> <input type="color" id="cBgDxf" hidden></span></div>
  <div class="set-row"><span>PDF — вокруг листа</span><span><select id="sBgPdf"></select> <input type="color" id="cBgPdf" hidden></span></div>
  <div class="set-row"><span>Линии DXF на экране (W)</span><select id="sLineK"><option value="1">тонкие</option><option value="1.6">средние</option><option value="2.4">жирные</option></select></div>
  <div class="set-row"><span>Надписи в DXF (тексты, выноски)</span><select id="sTexts"><option value="1">показывать</option><option value="0">скрыть</option></select></div>
  <div class="set-row"><span>Тонкие линии PDF</span><select id="sPdfBold"><option value="0">как в файле</option><option value="1">темнее (чётче на большом листе)</option></select></div>
  <div class="set-row"><span>Лист PDF</span><select id="sPdfDark"><option value="0">как в файле (белый)</option><option value="1">тёмный (инверсия цветов)</option></select></div>
  <div class="pp-s" style="margin:0;border:0">На светлом фоне белые линии DXF рисуются чёрными, на тёмном — чёрные белыми, как в CAD. Миниатюры перерисуются.</div>
  <div class="set-sec">Пары чертёж ⇄ DXF</div>
  <div class="set-row"><span>Искать пары</span><select id="sScope"><option value="dir">в выбранной папке дерева</option><option value="all">во всём открытом изделии</option></select></div>
  <div class="pp-s" style="margin:0;border:0">«Во всём изделии» нужно для старых проектов, где PDF и DXF лежат в соседних папках.</div>
  <div class="set-sec">Подпись в окне просмотра</div>
  <div id="capV" style="padding:2px 12px 6px;display:grid;grid-template-columns:1fr 1fr;gap:4px 12px;font-size:13px"></div>
  <div class="set-sec">Подписи под миниатюрами</div>
  <table class="cap-t" id="capT"></table>
  <div class="set-sec">Повёрнутые DXF</div>
  <div class="set-row"><span id="xfCount"></span><button id="xfResetAll">Вернуть все как в файле</button></div>
</div>

<div id="histPanel" class="modal" hidden>
  <div class="lp">
    <div class="lph">
      <b>История</b>
      <select id="hView" title="Вид истории"><option value="list">Подряд</option><option value="group">Группой</option></select>
      <select id="hKind"><option value="file">Файлы</option><option value="folder">Папки</option></select>
      <select id="hPeriod"><option value="1">Сегодня</option><option value="7" selected>7 дней</option><option value="30">30 дней</option><option value="0">Всё время</option></select>
      <input id="hSearch" type="search" placeholder="Поиск">
      <button id="hClear" title="Удалить показанные записи">Очистить…</button>
      <button id="hClose">✕</button>
    </div>
    <div id="hBody" class="lbody"></div>
    <div class="lpf" id="hFoot"></div>
  </div>
</div>

<div id="logPanel" class="modal" hidden>
  <div class="lp">
    <div class="lph">
      <b>Журнал</b>
      <label><input type="checkbox" id="logOnly" checked> только замечания</label>
      <span class="sp"></span>
      <button id="logAll" title="Обработать все файлы, а не только видимые">Проверить все файлы</button>
      <button id="logClear" title="Удалить сохранённые миниатюры и построить заново">Очистить кэш</button>
      <button id="logClose">✕</button>
    </div>
    <div id="logBody" class="lbody"></div>
    <div class="lpf" id="logFoot"></div>
  </div>
</div>

