<!doctype html>
<html lang="ru" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Просмотр DXF</title>
<!--@@PWAHEAD@@-->
<style>
:root{--prevw:480px;--treew:270px;--lthumb:76px;--bg:#1b1d21;--panel:#24272c;--line:#363a41;--line2:#2c2f35;--fg:#e6e6e6;--mut:#9aa0a8;--acc:#4ea1ff;--warn:#e5b54a;--err:#ff6b6b;
  --cv:#0f1012;--btn:#30343a;--btnh:#5a6069;--inp:#16181b;--on:#25425f;--hover:#2c3138;--pair:#3a2b2a;--pairb:#7a4a44;--ph:#5c626b;
  --tile:180px;--listw:380px}
:root[data-theme=light]{--bg:#eef0f3;--panel:#ffffff;--line:#d3d7dd;--line2:#e7e9ed;--fg:#1d2024;--mut:#67707b;--acc:#1f6fd1;--warn:#c98a00;--err:#d93636;
  --cv:#f7f8fa;--btn:#f3f4f6;--btnh:#9aa1ab;--inp:#ffffff;--on:#dbe8fb;--hover:#edf3fb;--pair:#fbece9;--pairb:#d9a59c;--ph:#9aa0a8}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0;height:100%;background:var(--bg);color:var(--fg);font:14px/1.35 system-ui,"Segoe UI",Roboto,sans-serif}
body{display:flex;flex-direction:column;overflow:hidden}
header{display:flex;flex-wrap:wrap;gap:6px 0;align-items:center;padding:8px;background:var(--panel);border-bottom:1px solid var(--line)}
header .grp{display:flex;gap:6px;align-items:center;padding:0 10px;border-left:1px solid var(--line)}
header .brand+.grp{border-left:0;padding-left:8px}
header .grp.grow{flex:1 1 150px}header .grp.grow #filter{flex:1;min-width:80px;width:100px}
header .grp.end{margin-left:auto;padding-right:0}
header .seg{display:inline-flex}header .seg button{border-radius:0}header .seg button:first-child{border-radius:8px 0 0 8px}header .seg button:last-child{border-radius:0 8px 8px 0;border-left:0}
.mwrap{position:relative}
.xfm-t{font-weight:600;padding:2px 4px}.xfm-r{display:flex;align-items:center;gap:4px;flex-wrap:wrap;padding:2px 4px}.xfm-n{font-size:12px;opacity:.75;padding:2px 4px;max-width:300px}#xfTxt{max-width:250px}
.menu{position:absolute;top:calc(100% + 4px);left:0;z-index:20;display:flex;flex-direction:column;gap:4px;padding:6px;background:var(--panel);border:1px solid var(--line);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.35);min-width:170px}
.menu[hidden]{display:none}.menu button{text-align:left}
@media (max-width:1700px){header .lbl.a{display:none}header .szbox input{width:80px}}
/* название программы в шапке видно всегда */
@media (max-width:1480px){header .lbl.b{display:none}header .szbox input{width:60px}header .grp{padding:0 7px}}
@media (max-width:1250px){header .lbl{display:none}}
.brand{font-weight:700;letter-spacing:.5px;margin-right:4px}
.brand small{color:var(--mut);font-weight:400}
button{background:var(--btn);color:var(--fg);border:1px solid var(--line);border-radius:6px;padding:7px 11px;font:inherit;cursor:pointer;white-space:nowrap}
button:hover{border-color:var(--btnh)}
button.on{background:var(--on);border-color:var(--acc)}
input[type=search],select{background:var(--inp);color:var(--fg);border:1px solid var(--line);border-radius:6px;padding:7px 8px;font:inherit}
input[type=search]{flex:1 1 140px;min-width:90px}
input[type=range]{width:110px}
#logBadge{background:var(--warn);color:#000;border-radius:9px;padding:0 6px;font-size:12px;font-weight:700;margin-left:4px}
#status{padding:4px 10px;color:var(--mut);font-size:12px;min-height:22px}
#status.flash{color:var(--warn)}
#cmpBar,#selBar{display:flex;gap:10px;align-items:center;padding:5px 10px;background:var(--on);font-size:13px;flex-wrap:wrap}
#cmpBar .sp{flex:1}
#cmpBar b{font-weight:600}
#selBar{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);z-index:9;border:1px solid var(--acc);border-radius:10px;box-shadow:0 6px 24px rgba(0,0,0,.4)}
.tile.sel{outline:2px dashed var(--warn);outline-offset:-3px}
.cmpb{position:absolute;left:4px;top:4px;border-radius:5px;padding:0 6px;font-size:11px;font-weight:700;cursor:pointer;color:#fff}
.cmpb.same{background:#2e8b57}.cmpb.diff{background:#d9822b}.cmpb.new{background:#3a7bd5}.cmpb.geo{background:#6f9a3a}.cmpb.name{background:#8a6fd1}.cmpb.ren{background:#b0679a}.cmpb.pend{opacity:.55}.cmpb.chk{background:#5a6270}
#ovBar{display:flex;gap:8px;align-items:center;padding:4px 8px;background:var(--panel);border-bottom:1px solid var(--line);font-size:13px;overflow-x:auto;white-space:nowrap}
#ovBar[hidden]{display:none}
#ovBar>*{flex:none}#ovBar .sp{flex:1}
.ovk{display:inline-flex;align-items:center;gap:5px;max-width:260px;overflow:hidden;text-overflow:ellipsis}
.ovk i{display:inline-block;width:14px;height:4px;border-radius:2px}.ovk .ova{background:#ff4d4d}.ovk .ovb{background:#39d353}
#ovRes{font-weight:600}#ovRes.ok{color:#39d353}#ovRes.bad{color:#ff8c4d}
#ovNum{padding:0 6px;color:var(--mut)}
#ovList{top:96px;right:8px;left:auto;padding:4px 0}
.ovl{display:flex;gap:8px;padding:7px 12px;cursor:pointer;font-size:13px;border-top:1px solid var(--line)}.ovl:first-child{border-top:0}
.ovl b{color:#d9a400;min-width:20px}.ovl:hover,.ovl.cur{background:var(--hover,#2b2f36)}.ovh{color:var(--mut);font-size:12px}
body.follower header,body.follower #updBar,body.follower #status,body.follower #work,body.follower #cmpBar{display:none!important}
#updBar{background:var(--on);padding:6px 10px;display:flex;gap:10px;align-items:center}

/* рабочая область: сетка или список + просмотр */
#work{flex:1;display:flex;min-height:0}
#tree{flex:none;width:var(--treew);overflow:auto;border-right:1px solid var(--line);background:var(--panel);padding:4px 0 10px;font-size:13px}
.tr{display:flex;align-items:center;gap:2px;padding:4px 8px 4px 0;cursor:pointer;white-space:nowrap;user-select:none}
.tr:hover{background:var(--hover)}
.tr.sel{background:var(--on);box-shadow:inset 3px 0 0 var(--acc)}
.tr .cr{width:18px;flex:none;text-align:center;color:var(--mut);font-size:11px}
.tr .tn{overflow:hidden;text-overflow:ellipsis;flex:1}
.tr .tc{color:var(--mut);font-size:11px;margin-left:6px;flex:none}
.tr.all{font-weight:600}
#vCtN{padding:0 6px;color:var(--mut);font-size:12px;white-space:nowrap;align-self:center}
#empty .reopen{font-size:15px;padding:8px 16px;border-color:var(--acc)}
body.kbtree .tr.sel{outline:2px solid var(--acc);outline-offset:-2px}
.ftile .fico{font-size:42px;color:var(--mut)}
#grid.list .ftile .fico{font-size:22px}
.ftile.up .fico{font-size:34px}
.ftile .nm{font-weight:600}
.tree-h{display:flex;align-items:center;padding:4px 8px 6px;color:var(--mut);font-size:12px;border-bottom:1px solid var(--line2);margin-bottom:4px}
.tree-h .sp{flex:1}
.tree-h button{padding:2px 7px;font-size:12px}
main#gridWrap{flex:1;overflow:auto;padding:8px;min-height:0;min-width:0}
body.explorer main#gridWrap{flex:none;width:var(--listw);padding:4px}
body.gridprev main#gridWrap{flex:1;width:auto;padding:8px}
body.gridprev #dock{flex:none;width:var(--prevw)}
.splitter{flex:none;width:6px;cursor:col-resize;background:var(--line);touch-action:none}
.splitter:hover,.splitter.drag{background:var(--acc)}
#dock{flex:1;min-width:0;display:flex}
#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(var(--tile),1fr));gap:8px}
#empty{max-width:560px;margin:10vh auto;text-align:center;color:var(--mut);line-height:1.6;border:2px dashed var(--line);border-radius:12px;padding:30px 20px}
body.drag main#gridWrap{outline:2px dashed var(--acc);outline-offset:-6px}
.tile{background:var(--panel);border:1px solid var(--line);border-radius:8px;overflow:hidden;cursor:pointer;user-select:none}
.tile:hover{border-color:var(--btnh)}
.tile.cur{border-color:var(--acc);box-shadow:0 0 0 2px var(--acc)}
body.kbd .tile:hover:not(.cur){border-color:var(--line)}
body.kbd #grid.list .tile:hover:not(.cur){background:transparent;border-color:transparent}
.th{position:relative;aspect-ratio:4/3;background:var(--cv)}
.th img{width:100%;height:100%;object-fit:contain;display:block}
.ph{position:absolute;inset:0;display:grid;place-items:center;color:var(--ph);font-size:12px}
.badge{position:absolute;top:4px;right:4px;background:var(--warn);color:#000;border-radius:10px;padding:0 6px;font-size:11px;font-weight:700}
.badge.err{background:var(--err);color:#fff}
.tag{position:absolute;left:4px;bottom:4px;background:#b8483f;color:#fff;border-radius:4px;padding:0 5px;font-size:10px;font-weight:700}
.tx{padding:5px 7px;min-width:0}
.nm{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.meta{font-size:11px;color:var(--mut);margin-top:2px}
.meta:empty{display:none}
#grid.wrapnm .nm{white-space:normal;word-break:break-word}
#grid.nonm .nm{display:none}
#grid.nocap .tx{display:none}
.xfb{position:absolute;right:4px;bottom:4px;background:var(--acc);color:#fff;border-radius:4px;padding:0 5px;font-size:10px;font-weight:700}
.szbox{display:flex;align-items:center;gap:3px}
.szbox button{padding:5px 9px}
/* режим «Проводник»: строки */
#grid.list{display:flex;flex-direction:column;gap:2px}
#grid.list .tile{display:flex;align-items:center;gap:8px;padding:3px 6px 3px 3px;border-radius:6px;border-color:transparent;background:transparent}
#grid.list .tile:hover{background:var(--hover)}
#grid.list .tile.cur{background:var(--on);border-color:var(--acc);box-shadow:none}
#grid.list .th{width:var(--lthumb);flex:none;border-radius:4px;overflow:hidden}
#grid.list .tag{display:none}
#grid.list .badge{top:2px;right:2px;font-size:10px;padding:0 5px}
#grid.list .tx{flex:1;padding:0}
#grid.list .nm{white-space:normal;word-break:break-word;font-size:13px}

/* окно просмотра */
#viewer{display:flex;flex-direction:column;background:var(--cv);min-width:0}
#dock>#viewer{flex:1}
#viewer.full{position:fixed;inset:0;z-index:10}
.vbar{display:flex;gap:6px;align-items:center;padding:6px;background:var(--panel);border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:thin}
.vbar>*{flex:none}
.vgrp{display:flex;gap:3px;align-items:center;flex:none}.vbar{gap:10px}
#vClose{position:sticky;right:0;margin-left:auto;z-index:2;box-shadow:0 0 0 6px var(--panel),-16px 0 10px var(--panel)}
#vClose:hover{background:#c42b1c;color:#fff;border-color:#c42b1c}
@media (max-width:1250px){.vbar .lbl{display:none}}
#vPgNum{white-space:nowrap}
#vName{flex:1 1 auto;min-width:60px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 4px}
#vPages{display:flex;gap:4px;align-items:center;color:var(--mut);font-size:13px}
.pairbox{display:flex}
.xfbox{display:flex;gap:2px}
.xfbox button{padding:7px 9px}
#vPair{background:var(--pair);border-color:var(--pairb);border-radius:6px 0 0 6px}
#vPair.none{background:var(--btn);border-color:var(--line);color:var(--mut)}
#vPairMenu{border-radius:0 6px 6px 0;border-left:none;padding:7px 8px}
#stageWrap{flex:1;position:relative;min-height:0}
#stage{position:absolute;inset:0;display:grid;gap:3px;background:var(--line)}
#stageMsg{position:absolute;inset:0;display:grid;place-items:center;color:var(--mut);background:var(--cv);text-align:center;padding:20px}
.pane{position:relative;min-width:0;min-height:0;overflow:hidden}
.pane canvas{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none;cursor:crosshair}
.pcap{display:none;position:absolute;left:6px;top:6px;z-index:2;background:rgba(20,22,26,.78);color:#e6e6e6;font-size:12px;padding:3px 4px 3px 8px;border-radius:6px;
  max-width:calc(100% - 12px);gap:6px;align-items:center;pointer-events:none;flex-wrap:wrap}
.pcap .cn{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;max-width:100%}
.pcap .ch{background:rgba(255,255,255,.14);border-radius:4px;padding:0 6px;white-space:nowrap;font-variant-numeric:tabular-nums}
.pcap .ch.dim{background:rgba(78,161,255,.28)}
.pcap .ch.dup{background:#d9822b;color:#fff;cursor:help;pointer-events:auto}
#stage.multi .pcap,#stage.capone .pcap{display:flex}
#stage.multi .pane.active{outline:2px solid var(--acc);outline-offset:-2px;z-index:1}
#stage.multi .pane.active .pcap{background:var(--acc);color:#fff}
.pxf{position:absolute;right:6px;top:6px;z-index:3;display:flex;gap:6px;align-items:center;background:var(--warn);color:#000;font-size:12px;font-weight:600;
  padding:3px 4px 3px 9px;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.35)}
.pxf.orig{background:var(--mut);color:#fff}
.pxf button{padding:2px 8px;font-size:12px;background:rgba(255,255,255,.85);color:#000;border-color:rgba(0,0,0,.25)}
.vinfo{display:flex;gap:16px;align-items:center;padding:4px 10px;font-size:12px;color:var(--mut);background:var(--panel);border-top:1px solid var(--line);flex-wrap:wrap;min-height:28px}
.vinfo .sp{flex:1}
#vWarn{background:none;border:none;color:var(--warn);padding:2px 4px;font-size:12px}

/* всплывающие панели */
.pop{position:fixed;top:50px;right:8px;width:min(460px,calc(100vw - 16px));max-height:76vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:10px;z-index:15;box-shadow:0 8px 30px rgba(0,0,0,.35)}
.pp-h{display:flex;gap:6px;align-items:center;padding:8px 10px;border-bottom:1px solid var(--line)}
.pp-h .sp{flex:1}
.pp-row{display:flex;gap:8px;align-items:center;padding:6px 10px;font-size:13px}
.pp-name{flex:1;cursor:pointer;color:var(--acc);word-break:break-all}
.pp-tag{font-size:11px;color:var(--mut)}
.pp-row button{padding:3px 8px;font-size:12px}
.pp-c{cursor:pointer;color:var(--fg);word-break:break-all;border-top:1px solid var(--line2)}
.pp-c:hover{background:var(--hover)}
.pp-s{padding:10px 10px 6px;color:var(--mut);font-size:12px;border-top:1px solid var(--line);margin-top:4px}
.pin.dis{opacity:.45;cursor:not-allowed}
#mtBar{display:flex;flex-wrap:wrap;gap:5px;align-items:center;padding:4px 8px;border-bottom:1px solid var(--line);font-size:12px}
#mtBar .mt-l{color:var(--mut);margin-right:2px}
#mtBar .mt-c{padding:2px 9px;font-size:12px;border-radius:12px;white-space:pre}
#mtBar .mt-c.on{background:var(--acc);color:#fff;border-color:var(--acc)}
#mtBar .mt-s{margin-left:auto;color:var(--mut);display:flex;gap:5px;align-items:center}
#tblPanel{position:fixed;inset:0;z-index:35;background:rgba(0,0,0,.45);display:flex;padding:20px}
#tblPanel[hidden]{display:none}
#tblBox{background:var(--panel);border:1px solid var(--line);border-radius:12px;flex:1;display:flex;flex-direction:column;overflow:hidden}
#tblBox .pp-h{gap:8px;flex-wrap:wrap}#tblScroll{overflow:auto;flex:1}
.mut{color:var(--mut);font-size:12px}
#loupe{position:fixed;z-index:30;pointer-events:none;border-radius:50%;box-shadow:0 6px 24px rgba(0,0,0,.55)}#loupe[hidden]{display:none}
#pngMenu label{display:flex;gap:6px;align-items:center;padding:3px 4px;white-space:nowrap}
button.warn{border-color:#d9822b;color:#ffb36b}
#rulesBody input[type=number],#rulesBody textarea{background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:6px;padding:4px 6px;font:inherit}
table.tbl{border-collapse:collapse;width:100%;font-size:13px}
table.tbl th{position:sticky;top:0;background:var(--panel);text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);cursor:pointer;white-space:nowrap}
table.tbl td{padding:4px 8px;border-bottom:1px solid var(--line);white-space:nowrap}
table.tbl tr:hover td{background:var(--hover,#2b2f36)}table.tbl .n{text-align:right}
table.tbl td.bad{color:#ff8c4d;font-weight:600}table.tbl td.ok{color:#39d353}
table.tbl.sum{width:auto}table.tbl.sum th{position:static;cursor:default}table.tbl.sum tr.tot td{font-weight:700}
#tblColMenu label{display:flex;gap:6px;align-items:center;padding:3px 6px;white-space:nowrap}
#tblColMenu{right:0;left:auto}
.chkb{position:absolute;left:4px;bottom:4px;border-radius:5px;padding:0 6px;font-size:11px;font-weight:700;cursor:pointer;color:#fff}
.chkb.bad{background:#d9822b}.chkb.ok{background:#2e8b57}
.pk-for{color:var(--mut);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pk{display:grid;grid-template-columns:1fr auto;gap:2px 10px;padding:6px 10px;border-top:1px solid var(--line);cursor:pointer;font-size:13px}
.pk:hover,.pk.cur{background:var(--hover,#2b2f36)}
.pk .pn{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pk .pd{grid-column:1;color:var(--mut);font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pk .ps{grid-row:1/3;grid-column:2;text-align:right;font-size:12px;color:var(--mut);align-self:center}.pk .ps b{color:#39d353}
.pp-empty{padding:6px 10px;color:var(--mut);font-size:13px}
.set-row{display:flex;gap:10px;align-items:center;justify-content:space-between;padding:8px 12px}
.set-row select{min-width:170px}
.set-row input[type=color]{width:38px;height:32px;padding:0;border:1px solid var(--line);border-radius:6px;background:none;cursor:pointer}
.set-sec{padding:12px 12px 4px;font-weight:600;border-top:1px solid var(--line);margin-top:6px}
.cap-t{width:calc(100% - 24px);margin:2px 12px 8px;border-collapse:collapse;font-size:13px}
.cap-t td,.cap-t th{padding:4px 6px;text-align:center}
.cap-t td:first-child,.cap-t th:first-child{text-align:left}
.cap-t th{color:var(--mut);font-weight:500;font-size:12px}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:20;display:flex;justify-content:center;padding:4vh 3vw}
.lp{background:var(--panel);border:1px solid var(--line);border-radius:10px;width:min(920px,100%);display:flex;flex-direction:column;min-height:0}
.lph{display:flex;gap:8px;align-items:center;padding:10px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.lph .sp{flex:1}
.lbody{overflow:auto;padding:6px 12px;flex:1;font-size:13px}
.lf{margin:8px 0 12px}
.lf h4{margin:0 0 3px;font-size:13px;color:var(--acc);cursor:pointer;word-break:break-all}
.lf div{padding:1px 0 1px 12px}
.l-info{color:var(--mut)}.l-warn{color:var(--warn)}.l-error{color:var(--err)}
.lpf{padding:8px 12px;border-top:1px solid var(--line);color:var(--mut);font-size:12px}
.h-day{margin:12px 0 4px;font-weight:600;color:var(--mut);font-size:12px;text-transform:uppercase;letter-spacing:.4px}
.h-row{display:flex;gap:10px;align-items:baseline;padding:5px 6px;border-radius:6px;cursor:pointer}
.h-row:hover{background:var(--hover)}
.h-t{color:var(--mut);font-variant-numeric:tabular-nums;flex:none;width:42px}
.h-n{word-break:break-word}
.h-pdf .h-n::after{content:"PDF";margin-left:6px;font-size:10px;font-weight:700;background:#b8483f;color:#fff;border-radius:3px;padding:0 4px;vertical-align:1px}
.h-f{color:var(--mut);font-size:12px;margin-left:auto;text-align:right;word-break:break-word}
.h-off .h-n,.h-off .h-t{opacity:.55}
.hg{display:flex;gap:6px;align-items:baseline;padding:4px 6px;border-radius:6px;cursor:pointer}
.hg:hover{background:var(--hover)}
.hg .cr{width:16px;flex:none;color:var(--mut);font-size:11px;text-align:center}
.hg .hn{word-break:break-word}
.hg.fold .hn{font-weight:600}
.hg.proj{margin-top:6px}
.hg .hm{color:var(--mut);font-size:12px;margin-left:auto;white-space:nowrap;padding-left:10px}
.hg button{visibility:hidden;padding:1px 7px;font-size:11px;flex:none}
.hg:hover button{visibility:visible}
@media (hover:none){.hg button{visibility:visible}}
.pin{display:flex;gap:8px;align-items:center;padding:7px 10px;border-top:1px solid var(--line2);cursor:pointer}
.pin:hover{background:var(--hover)}
.pin .pi{flex:none;width:18px;text-align:center}
.pin .pt{flex:1;min-width:0}
.pin .pl{word-break:break-word}
.pin .pp{color:var(--mut);font-size:11px;word-break:break-word}
.pin button{padding:2px 7px;font-size:12px;visibility:hidden;flex:none}
.pin:hover button{visibility:visible}
@media (hover:none){.pin button{visibility:visible}}
.pin.off{opacity:.55}
.pin-add{display:flex;flex-direction:column;gap:6px;padding:8px 10px}
.pin-add button{text-align:left;white-space:normal}
.h-pin{visibility:hidden;padding:1px 7px;font-size:11px;flex:none}
.h-row:hover .h-pin{visibility:visible}
@media (hover:none){.h-pin{visibility:visible}}
.h-del{visibility:hidden;padding:1px 7px;font-size:11px;flex:none}
.h-row:hover .h-del{visibility:visible}
@media (hover:none){.h-del{visibility:visible}}
@media (max-width:759px){#btnPreview{display:none}#tree{position:fixed;left:0;top:0;bottom:0;width:84vw;z-index:12;box-shadow:0 0 40px rgba(0,0,0,.5)}}
@media (max-width:600px){
  header{gap:5px;padding:6px}
  button{padding:7px 9px}
  input[type=range]{width:80px}
  .hide-m{display:none}
}
</style>
</head>
<body>
<header>
  <div class="brand">DXF <small>+PDF · v4.1.3</small></div>
  <!-- открыть -->
  <span class="grp">
    <span class="mwrap"><button id="btnOpen" title="Открыть папку или файлы">📂 <span class="lbl a">Открыть</span> ▾</button>
      <div id="openMenu" class="menu" hidden>
        <button id="btnFolder" title="Открыть папку целиком (с подпапками) — заказ, изделие, папка на сервере">📂 Папка…</button>
        <button id="btnFiles" title="Выбрать отдельные DXF и PDF">📄 Файлы…</button>
      </div></span>
    <button id="btnPins" title="Ярлыки — закреплённые папки и файлы">★ <span class="lbl a">Ярлыки</span></button>
    <button id="btnHist" title="История просмотров">🕘 <span class="lbl a">История</span></button>
    <button id="btnClose" hidden title="Закрыть все файлы">✕ <span class="lbl a">Закрыть</span></button>
  </span>
  <!-- найти -->
  <span class="grp grow">
    <input id="filter" type="search" placeholder="Фильтр по имени">
    <select id="typeSel" title="Тип файлов"><option value="">Все</option><option value="dxf">DXF</option><option value="pdf">PDF</option></select>
  </span>
  <!-- вид -->
  <span class="grp">
    <span class="seg"><button id="btnGrid" title="Миниатюры сеткой">▦ <span class="lbl a">Сетка</span></button><button id="btnList" title="Список с датой, размером и папкой">☰ <span class="lbl a">Список</span></button></span>
    <button id="btnTree" hidden title="Дерево папок слева">🌳 <span class="lbl">Дерево</span></button>
    <button id="btnBrowse" hidden title="Как в Проводнике: вложенные папки плитками, файлы только этой папки (Backspace — наверх)">📁 <span class="lbl">По папкам</span></button>
    <button id="btnPreview" title="Окно просмотра справа, как в Проводнике">◫ <span class="lbl">Просмотр</span></button>
    <span class="szbox" title="Размер миниатюр (Ctrl + колесо над списком)"><input id="tileSize" type="range" min="80" max="600" value="180"><button id="szMinus" hidden>−</button><button id="szPlus" hidden>+</button></span>
  </span>
  <!-- действия с выделенным файлом -->
  <span class="grp">
    <button id="btnSideG" title="Открыть выделенный файл: чертёж и все его развёртки рядом (R)">⧉ <span class="lbl b">Рядом</span></button>
    <button id="btnTable" title="Таблица по всем DXF папки: материал, толщина, количество, площадь, масса, рез, врезки, проверка; выгрузка в Excel">▤ <span class="lbl b">Таблица</span></button>
    <button id="btnCmp" hidden title="Сравнить с другой папкой (прошлый заказ, архив)">⇆ <span class="lbl b">Сравнить</span></button>
  </span>
  <!-- служебное -->
  <span class="grp end">
    <button id="btnLog" hidden title="Замечания при чтении файлов, проверка всех файлов, очистка кэша">Журнал<span id="logBadge" hidden></span></button>
    <button id="btnSet" title="Настройки: тема, фон, подписи, журнал">⚙</button>
    <button id="btnHelp" title="Справка по всем функциям (F1)">?</button>
  </span>
  <input id="inFolder" type="file" webkitdirectory multiple hidden>
  <input id="inFiles" type="file" multiple hidden accept=".dxf,.pdf,application/pdf,*/*">
</header>
<div id="updBar" hidden>Доступна новая версия<button id="updBtn">Обновить</button></div>
<div id="status"></div>
<div id="mtBar" hidden></div>
<div id="cmpBar" hidden><span id="cmpInfo"></span><span class="sp"></span>
  <label>Показать <select id="cmpFilter"><option value="">все</option><option value="chg">всё, что менялось</option><option value="diff">≠ отличаются</option><option value="geo">≈ пересохранены, геометрия та же</option><option value="name">имя изменено</option><option value="ren">⇢ переименованы</option><option value="new">нов — нет там</option><option value="same">= одинаковые</option></select></label>
  <button id="cmpOnlyBtn"></button><button id="cmpEnd" title="Закончить сравнение">✕</button></div>
<div id="selBar" hidden><span id="selInfo"></span><button id="selGo">Сравнить рядом</button><button id="selClear">✕</button></div>
<div id="work">
  <nav id="tree" hidden><div class="tree-h">Папки<span class="sp"></span><button id="treeExpand">развернуть</button><button id="treeFold">свернуть</button><button id="treeHide" title="Скрыть дерево">✕</button></div><div id="treeBody"></div></nav>
  <div id="split2" class="splitter" hidden title="Потяните, чтобы изменить ширину дерева"></div>
  <main id="gridWrap">
    <div id="empty">
      Откройте папку с DXF и PDF кнопкой <b>«Папка»</b> или перетащите папку/файлы в это окно.<br>
      На телефоне — кнопка <b>«Файлы»</b>.<br><br>
      <span class="hide-m">В просмотре: колесо — масштаб, перетаскивание — сдвиг, двойной клик или <b>F</b> — показать всё,<br>
      <b>← →</b> — листать, <b>Tab</b> — по кругу чертёж ⇄ развёртки, <b>R</b> — «Рядом», <b>Q/E</b> — поворот, <b>M</b> — зеркало,<br><b>PgUp/PgDn</b> — страницы PDF, <b>Esc</b> — назад.</span>
    </div>
    <div id="grid"></div>
  </main>
  <div id="split" class="splitter" hidden title="Потяните, чтобы изменить ширину списка"></div>
  <div id="dock" hidden></div>
</div>

<div id="viewer" hidden>
  <div class="vbar">
    <button id="vPrev" title="Предыдущий (←)">‹</button><button id="vNext" title="Следующий (→)">›</button>
    <span id="vName"></span>
    <span id="vPages" hidden><button id="vPgPrev" title="Предыдущая страница (PgUp)">▲</button><span id="vPgNum"></span><button id="vPgNext" title="Следующая страница (PgDn)">▼</button></span>
    <span class="vgrp"><span class="pairbox"><button id="vPair" hidden></button><button id="vPairMenu" title="Связанные файлы, ручной выбор пары">▾</button></span><button id="vPin" title="Добавить файл в ярлыки">★</button></span>
    <span class="vgrp"><button id="vFit" title="Показать всё — вписать в окно (F, двойной клик)">⤢</button><button id="vFitW" hidden title="Вписать по ширине окна (Shift+F)">⟷</button><button id="vLoupe" title="Лупа: включите, затем клик — показать лупу (колесо — её увеличение), ещё клик — убрать. Или удерживайте Z">🔍</button><button id="vLw" title="Толщина линий DXF (W — по кругу)">≡<span class="lbl"> Линии</span></button><span id="vCt" class="xfbox" hidden><button id="vCtM" title="Линии PDF светлее ( [ )">−</button><span id="vCtN" title="Насыщенность линий PDF, от −2 до +4 (0 — как в файле)">линии 0</span><button id="vCtP" title="Линии PDF темнее ( ] )">+</button></span><button id="vCont" hidden title="Все страницы подряд / по одной">⇕</button></span>
    <span class="vgrp"><span id="vXf" class="xfbox"><button id="vRotL" title="Повернуть на 90° против часовой (Q)">⟲</button><button id="vRotR" title="Повернуть на 90° по часовой (E)">⟳</button><button id="vMir" title="Зеркально слева направо (M)">⇋</button><button id="vMirV" title="Зеркально сверху вниз (Shift+M)">⇅</button><span class="mwrap"><button id="vXfSave" title="Записать поворот / зеркало в файл DXF; произвольный угол">💾</button>
      <div id="xfMenu" class="menu" hidden style="min-width:290px">
        <div id="xfDesc" class="xfm-t"></div>
        <div class="xfm-r">Повернуть ещё на <input id="xfAng" type="number" step="any" value="15" style="width:64px">° <button id="xfAngL" title="Против часовой">⟲</button><button id="xfAngR" title="По часовой">⟳</button></div>
        <label id="xfTxtRow" class="xfm-r">Тексты при зеркале <select id="xfTxt"><option value="auto">авто: на контуре — отражать, надписи — читаемые</option><option value="read">все читаемые</option><option value="mirror">все отражать</option></select></label>
        <label><input type="checkbox" id="xfBak"> старый файл сохранить рядом как .bak</label>
        <button id="xfGo">💾 Записать в файл</button>
        <div id="xfNote" class="xfm-n"></div>
      </div></span></span><button id="vPdfRot" hidden class="warn">⤾<span class="lbl"> Лист</span></button></span>
    <span class="vgrp"><button id="vMeas" hidden title="Размеры: две точки с привязкой и третий клик — где положить размер (выше/ниже — горизонтальный, левее/правее — вертикальный); клик по линии, дуге, отверстию — L / R / Ø (D)">📏<span class="lbl"> Размеры</span></button><span id="measBox" class="xfbox" hidden><select id="measMode" title="Размер — как в CAD: 2 точки и 3-й клик — где положить (горизонтальный / вертикальный / по прямой). Расстояние — как в AutoCAD: 2 точки, сразу по прямой, по X, по Y и угол"><option value="dim">Размер</option><option value="dist">Расстояние</option><option value="ang">Угол</option><option value="gap">Зазор</option></select><button id="measHoles" title="Подписывать диаметры всех отверстий">Ø</button><select id="measPrec" title="Точность размеров"><option value="0">1</option><option value="1">0,1</option><option value="2">0,01</option><option value="3">0,001</option></select><button id="measUndo" title="Убрать последний размер (Backspace)">↶</button><button id="measClear" title="Убрать все размеры">Очистить</button></span><button id="vChk" hidden title="Проверка перед резкой: незамкнутые контуры, двойные линии, малые отверстия, узкие перемычки… (C)">✓<span class="lbl"> Проверка</span></button></span>
    <span class="vgrp"><button id="vSide" title="Чертёж и все его развёртки одновременно (R)">⧉<span class="lbl"> Рядом</span></button><button id="vWith" hidden title="Сравнить эту деталь с другим DXF — из списка похожих по габариту или файлом с диска (V)">⇆<span class="lbl"> Сравнить</span></button><button id="vOv" hidden title="Наложить две детали друг на друга и показать отличия (N)">Наложение</button><button id="vSync" hidden title="Синхронный масштаб и сдвиг (L)">🔒</button></span>
    <span class="vgrp"><span class="mwrap"><button id="vPng" title="Сохранить вид картинкой (PNG)">🖼</button>
      <div id="pngMenu" class="menu" hidden style="right:0;left:auto;min-width:240px">
        <label><input type="radio" name="pngWhat" value="all" checked> всё, что на экране</label>
        <label><input type="radio" name="pngWhat" id="pngOnlyPdf" value="pdf"> только чертежи PDF</label>
        <label><input type="radio" name="pngWhat" id="pngOnlyDxf" value="dxf"> только развёртки DXF</label>
        <label><input type="checkbox" id="pngClip"> ещё и копировать в буфер обмена</label>
        <button id="pngGo">Сохранить PNG</button>
      </div></span><button id="vMon" hidden title="Пара текущего файла — на втором мониторе">🖵</button><button id="vFull" hidden title="На весь экран (Enter)">⛶</button></span>
    <button id="vClose" title="Закрыть просмотр — назад к миниатюрам (Esc)">✕</button>
  </div>
  <div id="ovBar" hidden>
    <span class="ovk"><i class="ova"></i><span id="ovNa"></span></span>
    <span class="ovk"><i class="ovb"></i><span id="ovNb"></span></span>
    <span id="ovRes"></span>
    <span class="xfbox"><button id="ovPrev" title="Предыдущее отличие ( , )">‹</button><span id="ovNum"></span><button id="ovNext" title="Следующее отличие ( . )">›</button></span>
    <button id="ovListBtn" title="Все отличия словами — клик по строке приближает это место">Список отличий ▾</button>
    <button id="ovMode" title="Две панели рядом или обе детали в одном окне (N)">Наложение</button>
    <span class="sp"></span>
    <span class="ovh" title="Сдвинуть вторую деталь: Shift + перетаскивание мышью">вторая (Shift+мышь):</span><span class="xfbox" title="Положение второй детали: Shift+перетаскивание — сдвиг"><button id="ovRotL" title="Вторую деталь на 90° против часовой">⟲</button><button id="ovRotR" title="Вторую деталь на 90° по часовой">⟳</button><button id="ovMir" title="Отразить вторую деталь">⇋</button><button id="ovAuto" title="Подобрать положение заново">Авто</button></span>
    <label title="Расхождение меньше допуска считается совпадением">допуск <select id="ovTol"><option>0.01</option><option>0.05</option><option>0.1</option><option>0.2</option><option>0.5</option><option>1</option></select> мм</label>
    <button id="ovEnd" title="Показать файлы как есть, без сравнения контуров (Esc)">✕</button>
  </div>
  <div id="ovList" class="pop" hidden></div>
  <div id="stageWrap"><div id="stage"></div><div id="stageMsg" hidden></div></div>
  <div class="vinfo"><span id="vDims"></span><span id="vCoord"></span><span class="sp"></span><button id="vWarn" hidden></button></div>
</div>

<div id="pairPanel" class="pop" hidden>
  <div class="pp-h"><b id="ppTitle"></b><span class="sp"></span><button id="ppReset" hidden title="Убрать ручные связи и вернуть автоподбор">авто</button><button id="ppClose">✕</button></div>
  <div id="ppLinked"></div>
  <div class="pp-s">Выбрать вручную (связь запомнится):</div>
  <div style="padding:0 10px 6px"><input id="ppSearch" type="search" placeholder="Поиск по имени" style="width:100%"></div>
  <div id="ppList"></div>
  <div class="pp-s">Ручные связи действуют:
    <select id="ppMode" style="margin-top:6px;width:100%">
      <option value="folder">только в этой папке (по умолчанию)</option>
      <option value="size">в любой папке, если имя и размер файлов совпадают</option>
    </select>
  </div>
</div>

<div id="pinPanel" class="pop" hidden style="right:auto;left:8px">
  <div class="pp-h"><b>Ярлыки</b><span class="sp"></span><button id="pinClose">✕</button></div>
  <div id="pinAdd"></div>
  <div id="pinList"></div>
  <div class="pp-s" id="pinFoot" style="margin:0"></div>
</div>

<div id="cmpPanel" class="pop" hidden style="right:auto;left:8px">
  <div class="pp-h"><b>Сравнить с папкой</b><span class="sp"></span><button id="cmpClose">✕</button></div>
  <div class="pin-add"><button id="cmpPick">📁 Выбрать папку…</button></div>
  <div id="cmpRecent"></div>
  <div class="pp-s" style="margin:0">Файлы сопоставляются по обозначению (децимальному номеру), проверяется содержимое: = одинаковые, ≈ пересохранён (геометрия DXF та же), ≠ отличается. Если в сетке выделен файл — сразу откроется его сравнение; не нашлась пара по имени — список похожих по габариту.</div>
  <input id="inCmp" type="file" webkitdirectory multiple hidden>
</div>
<canvas id="loupe" hidden></canvas>
<div id="tblPanel" hidden>
 <div id="tblBox">
  <div class="pp-h"><b id="tblTitle">Таблица DXF</b><span id="tblProg" class="mut"></span><span class="sp"></span>
   <span class="mwrap"><button id="tblColBtn" title="Какие колонки показывать">Колонки ▾</button><div id="tblColMenu" class="menu" hidden></div></span>
   <label title="Нормы проверки — для какого станка">Станок <select id="tblMachine"><option value="laser">Лазер</option><option value="plasma">Плазма</option><option value="punch">Координатно-пробивной</option></select></label>
   <button id="tblRules" title="Правила проверки перед резкой и плотность материалов">Правила…</button>
   <button id="tblXlsx" title="Сохранить таблицу и итоги в Excel">⬇ Excel</button>
   <button id="tblClose" title="Закрыть (Esc)">✕</button></div>
  <div id="tblScroll"><table id="tblBody" class="tbl"></table>
   <div class="set-sec" style="margin:14px 10px 4px">Итоги по материалу и толщине (с учётом количества)</div><table id="tblSum" class="tbl sum"></table>
   <p class="mut" style="margin:8px 10px 20px;font-size:12px">Материал, толщина и количество — из имени файла. Площадь — внешний контур минус отверстия. Длина реза — все контуры, врезки — по числу контуров. Клик по строке — открыть деталь, по заголовку — сортировать.</p></div>
 </div>
</div>
<div id="rulesPanel" class="pop" hidden style="z-index:45">
  <div class="pp-h"><b>Правила проверки перед резкой</b><span class="sp"></span><button id="rulesClose">✕</button></div>
  <div id="rulesBody" style="padding:4px 12px 8px"></div>
</div>
<div id="chkList" class="pop" hidden style="top:96px"></div>
<div id="pickPanel" class="pop" hidden>
  <div class="pp-h"><b>Сравнить с…</b><span class="sp"></span><button id="pickFile" title="Любой DXF — с сервера, из архива, с диска">Файл с диска…</button><button id="pickClose">✕</button></div>
  <div class="pp-row"><span id="pickFor" class="pk-for"></span></div>
  <div class="pp-row"><input id="pickQ" type="search" placeholder="Поиск по имени или папке" style="flex:1"></div>
  <div id="pickInfo" class="pp-empty"></div>
  <div id="pickList"></div>
  <input id="pickInput" type="file" accept=".dxf" hidden>
</div>
<div id="onlyPanel" class="pop" hidden style="right:auto;left:8px">
  <div class="pp-h"><b id="onlyTitle"></b><span class="sp"></span><button id="onlyClose">✕</button></div>
  <div id="onlyList"></div>
</div>

<div id="setPanel" class="pop" hidden>
  <div class="pp-h"><b>Настройки</b>&nbsp;<small id="verSet" style="color:var(--mut)"></small><span class="sp"></span><button id="setLog" title="Замечания при чтении файлов, проверить все, очистить кэш миниатюр">Журнал…</button><button id="setClose">✕</button></div>
  <div class="set-row"><span>Тема</span><select id="sTheme"><option value="dark">Тёмная</option><option value="light">Светлая</option><option value="auto">Как в системе</option></select></div>
  <div class="set-sec">Фон</div>
  <div class="set-row"><span>DXF</span><span><select id="sBgDxf"></select> <input type="color" id="cBgDxf" hidden></span></div>
  <div class="set-row"><span>PDF — вокруг листа</span><span><select id="sBgPdf"></select> <input type="color" id="cBgPdf" hidden></span></div>
  <div class="set-row"><span>Линии DXF на экране (W)</span><select id="sLineK"><option value="1">тонкие</option><option value="1.6">средние</option><option value="2.4">жирные</option></select></div>
  <div class="set-row"><span>Надписи в DXF (тексты, выноски)</span><select id="sTexts"><option value="1">показывать</option><option value="0">скрыть</option></select></div>
  <div class="set-row"><span>Линии PDF ( [ и ] )</span><select id="sPdfBold"><option value="-2">−2 — светлее</option><option value="-1">−1 — чуть светлее</option><option value="0">0 — как в файле</option><option value="1">+1 — чуть темнее</option><option value="2">+2 — темнее</option><option value="3">+3 — ещё темнее</option><option value="4">+4 — максимум</option></select></div>
  <div class="set-row"><span>Многостраничный PDF</span><select id="sPdfCont"><option value="1">все страницы подряд (прокрутка)</option><option value="0">по одной странице</option></select></div>
  <div class="set-row"><span>Измерения: держать размеры</span><select id="sMkeep"><option value="mode">пока включён режим «Размеры»</option><option value="view">пока открыт просмотр (выключили режим — скрыты, включили — снова видны)</option><option value="proj">пока открыта папка (проект) — до открытия другой</option></select></div>
  <div class="set-row"><span>Размер лупы</span><select id="sLoupe"><option value="s">маленькая</option><option value="m">средняя</option><option value="l">большая</option></select></div>
  <div class="set-row"><span>Картинка PNG</span><select id="sPngClip"><option value="0">только сохранять файлом</option><option value="1">сохранять и копировать в буфер обмена</option></select></div>
  <div class="set-row"><span>Размеры в DXF</span><select id="sDims"><option value="1">показывать</option><option value="0">скрыть</option></select></div>
  <div class="set-row"><span>Сравнение двух DXF</span><select id="sCmpGeo"><option value="1">сразу сравнивать контуры</option><option value="0">просто рядом</option></select></div>
  <div class="set-row"><span>Мигание в сравнении (пробел)</span><select id="sBlink"><option value="0">выключено</option><option value="1">включено: пробел — по очереди левая, правая, обе</option></select></div>
  <div class="set-row"><span>Открывать файл в сетке и списке</span><select id="sClick"><option value="2">двойным кликом (один клик — выделить)</option><option value="1">одним кликом</option></select></div>
  <div class="set-row"><span>При запуске</span><select id="sReopen"><option value="1">открывать последнюю папку</option><option value="0">пустое окно</option></select></div>
  <div class="set-row"><span>Лист PDF</span><select id="sPdfDark"><option value="0">как в файле (белый)</option><option value="1">тёмный (инверсия цветов)</option></select></div>
  <div class="pp-s" style="margin:0;border:0">На светлом фоне белые линии DXF рисуются чёрными, на тёмном — чёрные белыми, как в CAD. Миниатюры перерисуются.</div>
  <div class="set-sec">Пары чертёж ⇄ DXF</div>
  <div class="set-row"><span>Искать пары</span><select id="sScope"><option value="dir">в выбранной папке дерева</option><option value="all">во всём открытом изделии</option></select></div>
  <div class="pp-s" style="margin:0;border:0">«Во всём изделии» нужно для старых проектов, где PDF и DXF лежат в соседних папках.</div>
  <div class="set-sec">Подпись в окне просмотра</div>
  <div id="capV" style="padding:2px 12px 6px;display:grid;grid-template-columns:1fr 1fr;gap:4px 12px;font-size:13px"></div>
  <div class="set-sec">Подписи под миниатюрами</div>
  <table class="cap-t" id="capT"></table>
  <div class="set-sec">Повёрнутые DXF</div>
  <div class="set-row"><span id="xfCount"></span><button id="xfResetAll">Вернуть все как в файле</button></div>
</div>

<div id="histPanel" class="modal" hidden>
  <div class="lp">
    <div class="lph">
      <b>История</b>
      <select id="hView" title="Вид истории"><option value="list">Подряд</option><option value="group">Группой</option></select>
      <select id="hKind"><option value="file">Файлы</option><option value="folder">Папки</option></select>
      <select id="hPeriod"><option value="1">Сегодня</option><option value="7" selected>7 дней</option><option value="30">30 дней</option><option value="0">Всё время</option></select>
      <input id="hSearch" type="search" placeholder="Поиск">
      <button id="hClear" title="Удалить показанные записи">Очистить…</button>
      <button id="hClose">✕</button>
    </div>
    <div id="hBody" class="lbody"></div>
    <div class="lpf" id="hFoot"></div>
  </div>
</div>

<div id="logPanel" class="modal" hidden>
  <div class="lp">
    <div class="lph">
      <b>Журнал</b>
      <label><input type="checkbox" id="logOnly" checked> только замечания</label>
      <span class="sp"></span>
      <button id="logAll" title="Обработать все файлы, а не только видимые">Проверить все файлы</button>
      <button id="logClear" title="Удалить сохранённые миниатюры и построить заново">Очистить кэш</button>
      <button id="logClose">✕</button>
    </div>
    <div id="logBody" class="lbody"></div>
    <div class="lpf" id="logFoot"></div>
  </div>
</div>

