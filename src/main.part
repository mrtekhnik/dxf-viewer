/* =====================================================================
   ОСНОВНОЙ ПОТОК
   ===================================================================== */
const Core=DXFCORE();
const TAU=Math.PI*2, THUMB_VER=4, TW=400, TH=300, DAY=86400000;
const $=id=>document.getElementById(id);
const LS={get(k,d){try{const v=localStorage.getItem('dxfv.'+k);return v===null?d:JSON.parse(v);}catch(e){return d;}},
          set(k,v){try{localStorage.setItem('dxfv.'+k,JSON.stringify(v));}catch(e){}}};

/* ---------- Настройки, тема, фон ---------- */
const SET=Object.assign({theme:'dark',bgDxf:'auto',bgPdf:'auto',pdfDark:false,pdfBold:false,pdfLv:0,pdfCont:true,reopen:true,browse:'all',texts:true,lineK:1,hView:'list',sync:true,capV:{name:1,dims:1,spec:1,dir:0,date:0,size:0,single:1},pairScope:'dir',monMain:'pdf',layout:'grid',preview:false,listW:380,prevW:480,treeW:270,side:false,lw:true,tree:true,
  capGrid:{name:1,wrap:0,type:0,size:0,date:0,dir:0},capList:{name:1,type:1,size:1,date:1,dir:1}},LS.get('set',{}));
if(SET.bg){const o={dark:'#0f1012',gray:'#3a3d42',light:'#ffffff'}[SET.bg];if(o){if(SET.bgDxf==='auto')SET.bgDxf=o;if(SET.bgPdf==='auto')SET.bgPdf=o;}delete SET.bg;}
if(SET.layout==='explorer'){SET.layout='list';SET.preview=true;}
if(!SET.capVv){SET.capV.single=1;SET.capVv=1;}   // подпись и при одном файле — по умолчанию
const saveSet=()=>LS.set('set',SET);
const mqLight=matchMedia('(prefers-color-scheme: light)');
const effTheme=()=>SET.theme==='auto'?(mqLight.matches?'light':'dark'):SET.theme;
const lum=h=>{const n=parseInt(h.slice(1),16);return 0.299*(n>>16&255)+0.587*(n>>8&255)+0.114*(n&255);};
const dxfBg=()=>SET.bgDxf==='auto'?(effTheme()==='light'?'#ffffff':'#0f1012'):SET.bgDxf;
const pdfBg=()=>SET.bgPdf==='auto'?(effTheme()==='light'?'#dfe2e6':'#0f1012'):SET.bgPdf;
const bgKey=()=>dxfBg()+'|'+pdfBg()+'|'+(SET.pdfDark?1:0);
const PDF_INV='invert(1) hue-rotate(180deg)';
/* «тонкие линии темнее»: полутона сглаживания дотягиваются до чёрного (на белом листе), цвета почти не меняются */
/* контраст PDF: ступени 0…4, по умолчанию 2 (= прежнее «темнее») */
/* насыщенность линий PDF: ступени −2…+3, по умолчанию 0.
   Не contrast() — он светло-серые края тонких линий выбеливал, и линии пропадали.
   Гамма-коррекция: белое остаётся белым, чёрное — чёрным, всё серое (тонкие линии, мелкий текст) только темнеет. */
const PDF_LV={'-2':0.6,'-1':0.8,'0':1,'1':1.35,'2':1.8,'3':2.6,'4':3.8};
const PDF_LVN={'-2':'светлее','-1':'чуть светлее','0':'как в файле','1':'чуть темнее','2':'темнее','3':'ещё темнее','4':'максимум'};
const LV_MIN=-2,LV_MAX=4;
if(!(SET.pdfLv>=LV_MIN&&SET.pdfLv<=LV_MAX))SET.pdfLv=0;
(()=>{const ns='http://www.w3.org/2000/svg',svg=document.createElementNS(ns,'svg');svg.setAttribute('width','0');svg.setAttribute('height','0');svg.style.position='absolute';
  let x='';for(const k in PDF_LV){if(PDF_LV[k]===1)continue;const e=PDF_LV[k];
    x+='<filter id="pdflv'+k+'" color-interpolation-filters="sRGB"><feComponentTransfer>'+['R','G','B'].map(c=>'<feFunc'+c+' type="gamma" amplitude="1" exponent="'+e+'" offset="0"/>').join('')+'</feComponentTransfer></filter>';}
  svg.innerHTML=x;(document.body||document.documentElement).appendChild(svg);})();
const pdfFilter=()=>[PDF_LV[SET.pdfLv]!==1?'url(#pdflv'+SET.pdfLv+')':'',SET.pdfDark?PDF_INV:''].filter(Boolean).join(' ');
const lvTxt=v=>(v>0?'+':v<0?'−':'')+Math.abs(v);
/* Цвета линий DXF под фон, как в CAD: на светлом белые → чёрные, очень светлые (жёлтый, голубой) темнее;
   на тёмном чёрные → белые, очень тёмные светлее */
const colCache=new Map();
function mapCol(c){
  const bg=dxfBg(),k=bg+c;let r=colCache.get(k);if(r)return r;
  const n=parseInt(c.slice(1),16),R=n>>16&255,G=n>>8&255,B=n&255,l=0.299*R+0.587*G+0.114*B,grey=R===G&&G===B;
  const hx=f=>'#'+[R,G,B].map(v=>Math.round(f(v)).toString(16).padStart(2,'0')).join('');
  if(lum(bg)>150)r=grey&&l>200?'#000000':l>150?hx(v=>v*0.55):c;
  else r=grey&&l<60?'#ffffff':l<45?hx(v=>v+(255-v)*0.5):c;
  colCache.set(k,r);return r;
}
function applyTheme(){document.documentElement.dataset.theme=effTheme();}
applyTheme();
document.documentElement.style.setProperty('--listw',SET.listW+'px');
document.documentElement.style.setProperty('--treew',SET.treeW+'px');
document.documentElement.style.setProperty('--prevw',SET.prevW+'px');

/* ---------- Пул фоновых потоков для разбора ---------- */
const Pool=(()=>{
  const workers=[],queue=[];let fallback=false,seq=0;
  const mainParse=(buf,name)=>{try{return Core.parseDXF(buf,name);}catch(e){return {name,groups:[],bbox:null,size:null,origin:[0,0],log:[['error','Сбой разбора: '+e.message]],stats:{n:0}};}};
  try{
    const src='"use strict";const Core=('+DXFCORE.toString()+')();onmessage=e=>{const d=e.data;let doc;try{doc=Core.parseDXF(d.buf,d.name);}catch(err){doc={name:d.name,groups:[],bbox:null,size:null,origin:[0,0],log:[["error","Сбой разбора: "+err.message]],stats:{n:0}};}postMessage({id:d.id,doc});};';
    const url=URL.createObjectURL(new Blob([src],{type:'text/javascript'}));
    const n=Math.max(1,Math.min(3,(navigator.hardwareConcurrency||2)-1));
    for(let i=0;i<n;i++){
      const w=new Worker(url);w.job=null;
      w.onmessage=e=>{const j=w.job;w.job=null;if(j)j.res(e.data.doc);pump();};
      w.onerror=ev=>{ev.preventDefault&&ev.preventDefault();const j=w.job;w.job=null;fallback=true;if(j)j.res(mainParse(j.buf,j.name));while(queue.length){const q=queue.shift();q.res(mainParse(q.buf,q.name));}};
      workers.push(w);
    }
  }catch(e){fallback=true;}
  function pump(){for(const w of workers){if(!w.job&&queue.length){const j=queue.shift();w.job=j;w.postMessage({id:j.id,buf:j.buf,name:j.name});}}}
  return {parse(buf,name){return new Promise(res=>{
    if(fallback||!workers.length){setTimeout(()=>res(mainParse(buf,name)),0);return;}
    queue.push({id:++seq,buf,name,res});pump();});}};
})();

/* ---------- IndexedDB: миниатюры, доступ к папкам, история ---------- */
const IDB=(()=>{
  let p=null;
  const db=()=>p||(p=new Promise(res=>{try{const r=indexedDB.open('dxf-viewer',2);
    r.onupgradeneeded=()=>{const d=r.result;for(const s of ['thumbs','roots','hist'])if(!d.objectStoreNames.contains(s))d.createObjectStore(s);};
    r.onsuccess=()=>res(r.result);r.onerror=r.onblocked=()=>res(null);}catch(e){res(null);}}));
  async function op(st,mode,fn){const d=await db();if(!d)return undefined;return new Promise(res=>{try{const tx=d.transaction(st,mode);const rq=fn(tx.objectStore(st));
    tx.oncomplete=()=>res(rq&&rq.result);tx.onerror=tx.onabort=()=>res(undefined);}catch(e){res(undefined);}});}
  return {get:(k,st='thumbs')=>op(st,'readonly',s=>s.get(k)),put:(k,v,st='thumbs')=>op(st,'readwrite',s=>s.put(v,k)),
          del:(k,st='thumbs')=>op(st,'readwrite',s=>s.delete(k)),all:st=>op(st,'readonly',s=>s.getAll()),clear:(st='thumbs')=>op(st,'readwrite',s=>s.clear())};
})();
if(LS.get('thumbVer',0)!==THUMB_VER){IDB.clear('thumbs');LS.set('thumbVer',THUMB_VER);}

/* ---------- Отрисовка документа ----------
   opt: {s,cx,cy,W,H,dpr, xf:{tx,ty,rot,mirror}, hidden:Set слоёв, lw:bool, px:толщина по умолчанию, color:перекрасить всё}
   xf — независимая трансформация файла (основа для будущего сравнения). */
function xfMat(xf){const r=(xf.rot||0)*Math.PI/180,c=Math.cos(r),s=Math.sin(r),m=xf.mirror?-1:1;return [c*m,s*m,-s,c,xf.tx||0,xf.ty||0];}
const isId=xf=>!xf||(!xf.rot&&!xf.mirror&&!xf.tx&&!xf.ty);
const mApply=(m,x,y)=>[m[0]*x+m[2]*y+m[4],m[1]*x+m[3]*y+m[5]];
function mInv(m){const d=m[0]*m[3]-m[1]*m[2];return [m[3]/d,-m[1]/d,-m[2]/d,m[0]/d,(m[2]*m[5]-m[3]*m[4])/d,(m[1]*m[4]-m[0]*m[5])/d];}
/* Поворот/зеркало DXF запоминаются для файла (имя + размер) */
const XFS=new Map(Object.entries(LS.get('xf',{})));
const xfKey=it=>it.name.toLowerCase()+'|'+it.file.size;
function saveXf(it,xf){const k=xfKey(it);if(isId(xf))XFS.delete(k);else XFS.set(k,{rot:xf.rot,mirror:xf.mirror});
  while(XFS.size>1000)XFS.delete(XFS.keys().next().value);LS.set('xf',Object.fromEntries(XFS));updXfBadges(k);}
const angTxt=a=>String(+(+a).toFixed(2)).replace('.',',');
const rotText=r=>!r?'':r===90?'повёрнут на 90° против часовой':r===270?'повёрнут на 90° по часовой':r===180?'повёрнут на 180°':r<180?'повёрнут на '+angTxt(r)+'° против часовой':'повёрнут на '+angTxt(360-r)+'° по часовой';
const xfDesc=x=>!x||isId(x)?'':x.mirror&&x.rot===180?'зеркально сверху вниз':x.mirror&&!x.rot?'зеркально слева направо':[rotText(x.rot),x.mirror?'зеркально':''].filter(Boolean).join(', ');
const xfShort=x=>[!x.rot?'':x.rot===180?'180°':x.rot<180?'⟲'+angTxt(x.rot)+'°':'⟳'+angTxt(360-x.rot)+'°',x.mirror?'⇋':''].filter(Boolean).join(' ');
function updXfBadges(k){for(const it of items){if(it.type!=='dxf'||(k&&xfKey(it)!==k))continue;
  const x=XFS.get(xfKey(it));it.xfb.hidden=!x;if(x){it.xfb.textContent=xfShort(x);it.xfb.title='При просмотре: '+xfDesc(x)+' (файл не изменён)';}}}
function lwPx(lw){if(!(lw>=0))return 1;const mm=lw/100;return mm<=0.25?1:Math.min(8,mm*3.5);}
function tracePrims(ctx,prims){
  for(const p of prims){
    switch(p[0]){
      case 'L':ctx.moveTo(p[1],p[2]);ctx.lineTo(p[3],p[4]);break;
      case 'C':ctx.moveTo(p[1]+p[3],p[2]);ctx.arc(p[1],p[2],p[3],0,TAU);break;
      case 'A':ctx.moveTo(p[1]+p[3]*Math.cos(p[4]),p[2]+p[3]*Math.sin(p[4]));ctx.arc(p[1],p[2],p[3],p[4],p[5],false);break;
      case 'P':{const a=p[2],n=a.length/3,segs=p[1]?n:n-1;ctx.moveTo(a[0],a[1]);
        for(let i=0;i<segs;i++){const j=(i+1)%n,b=a[i*3+2],x2=a[j*3],y2=a[j*3+1];
          const A=b?Core.bulgeArc(a[i*3],a[i*3+1],x2,y2,b):null;
          if(A)ctx.arc(A.cx,A.cy,A.r,A.a0,A.a1,!A.ccw);else ctx.lineTo(x2,y2);}
        if(p[1])ctx.closePath();break;}
    }
  }
}
function renderDoc(ctx,doc,o){
  if(!doc||!doc.groups)return;
  const d=o.dpr||1;
  ctx.save();
  ctx.setTransform(o.s*d,0,0,-o.s*d,(o.W/2-o.cx*o.s)*d,(o.H/2+o.cy*o.s)*d);
  if(!isId(o.xf)){const m=xfMat(o.xf);ctx.transform(m[0],m[1],m[2],m[3],m[4],m[5]);}
  ctx.lineCap='round';ctx.lineJoin='round';
  for(const G of doc.groups){
    if(G.off||(o.hidden&&o.hidden.has(G.layer))||(G.dim&&SET.dims===false))continue;
    const px=(o.lw?lwPx(G.lw):(o.px||1))*(o.k||1);
    ctx.lineWidth=Math.max(px/o.s,G.w||0);
    ctx.strokeStyle=o.color||mapCol(G.color);
    ctx.beginPath();tracePrims(ctx,G.prims);ctx.stroke();
  }
  ctx.restore();
  if(o.texts!==false)renderTexts(ctx,doc,o);
}
/* надписи рисуются в экранных координатах: всегда читаемо, мелкие (< 3 px) пропускаются */
function renderTexts(ctx,doc,o){
  const d=o.dpr||1,V=[o.s*d,(o.W/2-o.cx*o.s)*d,-o.s*d,(o.H/2+o.cy*o.s)*d],X=isId(o.xf)?null:xfMat(o.xf);
  ctx.save();
  for(const G of doc.groups){
    if(!G.texts||G.off||(o.hidden&&o.hidden.has(G.layer)))continue;
    ctx.fillStyle=o.color||mapCol(G.color);
    for(const T of G.texts){
      const hp=T.h*o.s*d;if(hp<3)continue;
      let px=T.x,py=T.y,ux=Math.cos(T.r),uy=Math.sin(T.r),vx=-uy,vy=ux,ha=T.ha,va=T.va;
      if(T.bk){ux=-ux;uy=-uy;}if(T.ud){vx=-vx;vy=-vy;}
      if(X){[px,py]=mApply(X,px,py);[ux,uy]=[X[0]*ux+X[2]*uy,X[1]*ux+X[3]*uy];[vx,vy]=[X[0]*vx+X[2]*vy,X[1]*vx+X[3]*vy];
        // как при записи в файл: надпись на контуре поворачивается/отражается вместе с деталью, пояснения остаются читаемыми
        if(!T.c){const sg=X[0]*X[3]-X[1]*X[2]<0,C=sg?[[-1,1],[1,-1]]:[[1,1],[-1,-1]];
          let [al,be]=C[0];for(const q of C){const x=q[0]*ux,y=q[0]*uy;if(x>1e-9||(Math.abs(x)<=1e-9&&y>0)){[al,be]=q;break;}}
          if(al<0){ux=-ux;uy=-uy;ha=ha==='left'?'right':ha==='right'?'left':ha;}
          if(be<0){vx=-vx;vy=-vy;va=va==='top'?'alphabetic':va==='middle'?'middle':'top';}}}
      ctx.setTransform(ux,-uy,-vx,vy,V[0]*px+V[1],V[2]*py+V[3]);
      ctx.font=(hp*1.4)+'px Arial,"Segoe UI",sans-serif';ctx.textAlign=ha;ctx.textBaseline=va;
      const n=T.l.length,lh=hp*1.6;
      for(let i=0;i<n;i++)ctx.fillText(T.l[i],0,T.va==='top'?i*lh:T.va==='middle'?(i-(n-1)/2)*lh:-(n-1-i)*lh);
    }
  }
  ctx.restore();
}
function fitView(doc,xf,W,H,pad=0.05){
  if(!doc||!doc.bbox)return {s:1,cx:0,cy:0};
  let b=doc.bbox;
  if(!isId(xf)){const m=xfMat(xf),B=[Infinity,Infinity,-Infinity,-Infinity];
    for(const [x,y] of [[b[0],b[1]],[b[2],b[1]],[b[0],b[3]],[b[2],b[3]]]){const X=m[0]*x+m[2]*y+m[4],Y=m[1]*x+m[3]*y+m[5];
      B[0]=Math.min(B[0],X);B[1]=Math.min(B[1],Y);B[2]=Math.max(B[2],X);B[3]=Math.max(B[3],Y);}b=B;}
  const w=Math.max(b[2]-b[0],1e-9),h=Math.max(b[3]-b[1],1e-9);
  let s=Math.min(W*(1-2*pad)/w,H*(1-2*pad)/h);if(!isFinite(s)||s<=0)s=1;
  return {s,cx:(b[0]+b[2])/2,cy:(b[1]+b[3])/2};
}
const sizeText=sz=>{const a=Math.max(sz[0],sz[1]),b=Math.min(sz[0],sz[1]);return fmt(a)+' × '+fmt(b);};
/* материал · толщина · количество из имени DXF: <обозначение>-<материал>-<толщина>-k<кол>[-form] */
function specOf(it){
  const b=it.name.replace(/\.dxf$/i,'').replace(/[-_ ](form|flat|развертка|развёртка|розгортка)$/i,'');
  const m=/-([^-]+)-(\d+(?:[.,]\d+)?)-[kKкК](\d+)$/.exec(b);return m?`${m[1]} · s${m[2]} · ${m[3]} шт`:'';
}
const fmt=v=>{const a=Math.abs(v);return (a>=1000?v.toFixed(1):a>=1?v.toFixed(2):v.toFixed(3)).replace(/\.?0+$/,'')||'0';};
const fmtSize=b=>b<1024?b+' Б':b<1048576?(b/1024).toFixed(b<10240?1:0)+' КБ':(b/1048576).toFixed(1)+' МБ';
const fmtDate=t=>new Date(t).toLocaleString('ru',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});

/* ---------- Документы ---------- */
let items=[],view=[],gen=0;
const docCache=new Map(),inflight=new Map(),DOC_MAX=24,PDF_MAX=8;
function cachePut(key,doc){
  docCache.set(key,doc);
  const over=()=>{let n=0;for(const d of docCache.values())if(d.kind==='pdf')n++;return docCache.size>DOC_MAX||n>PDF_MAX;};
  for(const [k,d] of [...docCache.entries()]){
    if(!over())break;
    if(k===key||panes.some(p=>p.doc===d))continue;
    if(docCache.size<=DOC_MAX&&d.kind!=='pdf')continue;
    docCache.delete(k);if(d.pdf)try{d.pdf.destroy();}catch(e){}
  }
}
/* PDF: библиотека pdf.js — встроена в файл или лежит рядом (PWA), грузится при первом PDF */
let pdfjsP=null,pdfWorker=null;
function loadPdfJs(){
  if(pdfjsP)return pdfjsP;
  pdfjsP=new Promise((res,rej)=>{
    const sc=document.createElement('script'),lib=$('pdfjsSrc').textContent,inline=lib.length>1000;
    sc.src=inline?URL.createObjectURL(new Blob([lib],{type:'text/javascript'})):'lib/pdf.min.js';
    sc.onload=()=>{const L=window.pdfjsLib||window['pdfjs-dist/build/pdf'];if(!L)return rej(new Error('модуль PDF не загрузился'));
      L.GlobalWorkerOptions.workerSrc=inline?URL.createObjectURL(new Blob([$('pdfWorkerSrc').textContent],{type:'text/javascript'})):new URL('lib/pdf.worker.min.js',location.href).href;res(L);};
    sc.onerror=()=>rej(new Error('модуль PDF не загрузился'));
    document.head.appendChild(sc);
  });
  return pdfjsP;
}
const SHEETS=[['A0',841,1189],['A1',594,841],['A2',420,594],['A3',297,420],['A4',210,297],['A5',148,210]];
function sheetName(w,h){const a=Math.min(w,h),b=Math.max(w,h);for(const [n,x,y] of SHEETS)if(Math.abs(a-x)<3&&Math.abs(b-y)<3)return n;
  for(const [n,x,y] of SHEETS.slice(2))for(let k=3;k<=9;k++)if(Math.abs(a-y)<3&&Math.abs(b-x*k)<3)return n+'×'+k;return '';}
function sheetText(pw,ph){const w=pw*25.4/72,h=ph*25.4/72,s=sheetName(w,h);return `Лист ${Math.round(w)} × ${Math.round(h)} мм${s?' · '+s:''}`;}
async function loadPdf(it){
  const doc={kind:'pdf',name:it.name,pdf:null,pages:0,groups:null,bbox:null,size:null,origin:[0,0],log:[],stats:{n:0}};
  try{
    const L=await loadPdfJs();const buf=await it.file.arrayBuffer();
    if(!pdfWorker)pdfWorker=new L.PDFWorker();
    doc.pdf=await L.getDocument({data:new Uint8Array(buf),isEvalSupported:false,worker:pdfWorker}).promise;
    doc.pages=doc.pdf.numPages;
    const vp=(await doc.pdf.getPage(1)).getViewport({scale:1});
    doc.size=[vp.width*25.4/72,vp.height*25.4/72];doc.bbox=[0,0,vp.width,vp.height];
    doc.log.push(['info',`PDF · страниц: ${doc.pages} · ${sheetText(vp.width,vp.height).toLowerCase()}`]);
  }catch(e){
    doc.pdf=null;doc.bbox=null;
    doc.log.push(['error',e&&e.name==='PasswordException'?'PDF защищён паролем — не открыт':'PDF не открылся: '+(e&&e.message||e)]);
  }
  return doc;
}
function getDoc(it){
  if(docCache.has(it.key)){const d=docCache.get(it.key);docCache.delete(it.key);docCache.set(it.key,d);return Promise.resolve(d);}
  if(inflight.has(it.key))return inflight.get(it.key);
  const g=gen;
  const pr=(async()=>{
    let doc;
    if(it.type==='pdf')doc=await loadPdf(it);
    else{
      try{const buf=await it.file.arrayBuffer();doc=await Pool.parse(buf,it.name);}
      catch(e){doc={name:it.name,groups:[],bbox:null,size:null,origin:[0,0],log:[['error','Файл не читается: '+e.message]],stats:{n:0}};}
      doc.kind='dxf';
    }
    inflight.delete(it.key);
    if(g===gen)cachePut(it.key,doc);
    setLog(it,doc.log);return doc;
  })();
  inflight.set(it.key,pr);return pr;
}
function setLog(it,log){it.log=log;it.issues=log.filter(l=>l[0]!=='info').length;it.err=log.some(l=>l[0]==='error');
  it.badge.hidden=!it.issues;it.badge.textContent=it.err?'!':it.issues;it.badge.className='badge'+(it.err?' err':'');
  it.tile.title=it.path+(it.issues?'\n'+log.filter(l=>l[0]!=='info').map(l=>l[1]).join('\n'):'');
  scheduleStatus();}

/* ---------- Список файлов ---------- */
function setFiles(arr,src={}){
  if(typeof MEAS!=='undefined'&&MEAS.store)MEAS.store.clear();   // другая папка — размеры прежней не нужны
  gen++;pairMap=null;
  layoutClear();
  for(const it of items)if(it.url)URL.revokeObjectURL(it.url);
  for(const d of docCache.values())if(d.pdf)try{d.pdf.destroy();}catch(e){}
  docCache.clear();inflight.clear();tq.length=0;io.disconnect();baseCache.clear();
  items=arr.filter(x=>/\.(dxf|pdf)$/i.test(x.file.name))
    .sort((a,b)=>a.path.localeCompare(b.path,'ru',{numeric:true,sensitivity:'base'}))
    .map(x=>{const it=makeItem(x.file,x.path,x.rid||src.rid||null,src.rootName!=null?src.rootName:(x.path.includes('/')?x.path.split('/')[0]:''));it.h=x.h||null;it.dh=x.dh||null;return it;});
  $('empty').hidden=items.length>0;$('btnClose').hidden=!items.length;$('btnCmp').hidden=!items.length||FOLLOW;
  if(CMP&&!src.keepCmp){CMP=null;}MTF="";if(typeof SEL!=='undefined')SEL.clear();$('selBar').hidden=true;
  if(!arr.length)$('empty').innerHTML=EMPTY_HTML;
  if(!items.length&&arr.length)$('empty').innerHTML='DXF и PDF не найдены среди выбранных ('+arr.length+' файл.).<br>Выберите другую папку.';
  if(src.folder)histAddFolder(src.rid||null,src.rootName||'',items.length);
  curDir='';treeOpen.clear();treeInit=true;
  const rs=src.rid&&RST[src.rid];   // папка открывалась раньше — вернуть раскрытые узлы, выбранную папку и фильтр типа
  if(rs){for(const p of rs.open||[])treeOpen.add(p);treeInit=!treeOpen.size;
    if(rs.dir&&items.some(x=>x.path.startsWith(rs.dir+'/')))curDir=rs.dir;$('typeSel').value=rs.type||'';}
  applyCaps();updXfBadges();updCmp();renderTree();applyFilter();placeViewer();
}
function makeItem(file,path,rid,rootName){
  const it={file,path,name:file.name,type:/\.pdf$/i.test(file.name)?'pdf':'dxf',key:path+'|'+file.size+'|'+file.lastModified,
    rid,rootName,state:0,visible:false,force:false,log:null,issues:0,err:false,gen};
  const t=document.createElement('div');t.className='tile';t.title=path;
  t.innerHTML='<div class="th"><img alt="" hidden><div class="ph">…</div><span class="badge" hidden></span>'+(it.type==='pdf'?'<span class="tag">PDF</span>':'')+
    '<span class="xfb" hidden></span><span class="cmpb" hidden></span></div><div class="tx"><div class="nm"></div><div class="meta"></div></div>';
  t.querySelector('.nm').textContent=file.name;
  it.meta=t.querySelector('.meta');it.xfb=t.querySelector('.xfb');it.cmpb=t.querySelector('.cmpb');
  it.cmpb.addEventListener('click',e=>{e.stopPropagation();cmpOpenFor(it);});
  it.tile=t;it.tag=t.querySelector('.tag');it.img=t.querySelector('img');it.ph=t.querySelector('.ph');it.badge=t.querySelector('.badge');t._it=it;
  t.addEventListener('click',e=>{if(e.ctrlKey||e.metaKey){toggleSel(it);return;}const i=view.indexOf(it);if(i<0)return;
    if(docked()||oneClick()){showItem(i);if(!docked())setFull(true);}else kbMark(t);});   // как в Проводнике: клик — выделить, двойной — открыть
  t.addEventListener('dblclick',e=>{if(e.ctrlKey||e.metaKey)return;const i=view.indexOf(it);if(i<0)return;if(VW.idx!==i||!viewerShown())showItem(i);setFull(true);});
  return it;
}
/* ---------- просмотр «по папкам», как в Проводнике: плитки вложенных папок + файлы только этой папки ---------- */
let HASSUB=false;
const oneClick=()=>MOB||SET.click==='1';
const selTile=()=>{const t=$('grid').querySelector('.tile.cur');return t&&t._it?t._it:null;};
function openSel(how,d){ // открыть выделенный файл: обычно, «Рядом» или сразу его пару (Tab)
  const it=selTile()||(VW.idx>=0?view[VW.idx]:null);if(!it){flash('Сначала выделите файл');return;}
  const i=view.indexOf(it);if(i<0)return;
  if(how==='side'){SET.side=true;saveSet();}
  showItem(i);if(!docked())setFull(true);
  if(how==='pair')setTimeout(()=>cyclePair(d||1),0);
}
$('btnSideG').onclick=()=>openSel('side');
const dirPath=p=>p.includes('/')?p.slice(0,p.lastIndexOf('/')):'';
const folderMode=()=>SET.browse==='folders'&&HASSUB&&!!TREE_ROOT;
const effDir=()=>curDir||(TREE_ROOT?TREE_ROOT.path:'');
function parentDir(d){if(!TREE_ROOT||!d||d===TREE_ROOT.path)return null;const p=dirPath(d);return p===TREE_ROOT.path?'':p;}
function folderTiles(){
  const out=[],eff=effDir(),node=NODES.get(eff);if(!node)return out;
  const mk=(name,path,n,up)=>{const t=document.createElement('div');t.className='tile ftile'+(up?' up':'');t.title=up?'На уровень выше (Backspace)':path;t._dir=path;
    t.innerHTML='<div class="th"><div class="ph fico"></div></div><div class="tx"><div class="nm"></div><div class="meta"></div></div>';
    t.querySelector('.fico').textContent=up?'⤴':'📁';t.querySelector('.nm').textContent=name;t.querySelector('.meta').textContent=up?'':'файлов: '+n;
    t.onclick=()=>{if(oneClick())goDir(path,up?eff:null);else kbMark(t);};t.ondblclick=()=>goDir(path,up?eff:null);return t;};
  const pd=parentDir(curDir);if(pd!==null)out.push(mk('.. наверх',pd,0,true));
  for(const k of [...node.kids.values()].sort(byName))out.push(mk(k.name,k.path,k.n,false));
  return out;
}
const gridTiles=()=>[...$('grid').children];
function goDir(d,from){ // перейти в папку; from — откуда пришли (подсветить её плитку)
  VW.idx=-1;setDir(d);
  const ts=gridTiles();let t=from!=null&&ts.find(x=>x._dir===from);
  if(!t&&ts.length)t=ts[0];kbMark(t||null);
}
function kbMark(t){ // курсор клавиатуры на плитке (папка или файл)
  for(const x of $('grid').querySelectorAll('.tile.cur'))x.classList.remove('cur');
  if(!t)return;t.classList.add('cur');t.scrollIntoView({block:'nearest'});
  if(t._it){const i=view.indexOf(t._it);if(docked()&&!VW.full){showItem(i);t.classList.add('cur');}else{VW.idx=i;monSync();}}else VW.idx=-1;
}
function goUp(){const pd=parentDir(curDir);if(pd===null)return false;goDir(pd,curDir);return true;}
$('btnBrowse').onclick=()=>{SET.browse=SET.browse==='folders'?'all':'folders';saveSet();$('btnBrowse').classList.toggle('on',SET.browse==='folders');applyFilter();
  flash(SET.browse==='folders'?'Показ по папкам: вложенные папки плитками, файлы — только этой папки (Backspace — наверх)':'Показ всех файлов выбранной папки со вложенными');};
$('btnBrowse').classList.toggle('on',SET.browse==='folders');
/* ---------- материал и толщина (из имени DXF): фильтр-строка над сеткой и сортировка ---------- */
let MTF='';   // выбранная группа «материал|толщина» ('' — все)
function mtInfo(it){if(it.type!=='dxf')return null;if(it._mt!==undefined)return it._mt;const p=nameParts(it);
  return it._mt=(p.mat||p.thk)?{mat:p.mat||'?',thk:p.thk||'',qty:+p.qty||0}:null;}
const mtKey=it=>{const m=mtInfo(it);return m?(m.mat.toLowerCase()+'|'+m.thk):'';};
const mtNum=v=>{const n=parseFloat(String(v).replace(',','.'));return isNaN(n)?1e9:n;};
function mtCmp(a,b){const x=mtInfo(a),y=mtInfo(b);
  if(!x||!y)return (x?0:1)-(y?0:1)||a.name.localeCompare(b.name,'ru',{numeric:true});
  return x.mat.localeCompare(y.mat,'ru')||mtNum(x.thk)-mtNum(y.thk)||a.name.localeCompare(b.name,'ru',{numeric:true});}
const mtLabel=m=>m.mat+(m.thk?' · '+String(m.thk).replace('.',',')+' мм':'');
function mtBar(list){
  const G=new Map();for(const it of list){const m=mtInfo(it);if(!m)continue;const k=mtKey(it);const g=G.get(k)||{m,n:0,q:0};g.n++;g.q+=m.qty||0;G.set(k,g);}
  const B=$('mtBar');B.textContent='';
  if(G.size<1){B.hidden=true;if(MTF){MTF='';}return;}
  B.hidden=false;if(MTF&&!G.has(MTF))MTF='';
  const lab=document.createElement('span');lab.className='mt-l';lab.textContent='Материал · толщина:';B.appendChild(lab);
  const chip=(k,t,tip)=>{const c=document.createElement('button');c.className='mt-c'+(MTF===k?' on':'');c.textContent=t;c.title=tip;c.onclick=()=>{MTF=MTF===k&&k?'':k;VW.idx=-1;applyFilter();};B.appendChild(c);};
  chip('','все','Показать все файлы');
  for(const [k,g] of [...G].sort((a,b)=>a[1].m.mat.localeCompare(b[1].m.mat,'ru')||mtNum(a[1].m.thk)-mtNum(b[1].m.thk)))
    chip(k,mtLabel(g.m)+'  ('+g.n+')',g.n+' DXF'+(g.q?', деталей по количеству в имени: '+g.q:'')+' — клик: показать только их (PDF скрываются)');
  const so=document.createElement('label');so.className='mt-s';so.innerHTML='<input type="checkbox"> сортировать по материалу и толщине';
  so.querySelector('input').checked=!!SET.sortMt;so.querySelector('input').onchange=e=>{SET.sortMt=e.target.checked;saveSet();applyFilter();};B.appendChild(so);
}
function applyFilter(){
  const cur=view[VW.idx];
  const q=$('filter').value.trim().toLowerCase(),ty=$('typeSel').value;
  const cf=CMP&&CMP.filter;
  const fm=folderMode()&&!q,eff=effDir();
  const inDir=it=>fm?dirPath(it.path)===eff:(!curDir||it.path.startsWith(curDir+'/'));
  view=items.filter(it=>(!cf||cmpMatch(it,cf))&&inDir(it)&&(!q||it.path.toLowerCase().includes(q))&&(!ty||it.type===ty));
  mtBar(view);                                       // строка «материал · толщина» — по файлам, видимым до этого фильтра
  if(MTF)view=view.filter(it=>mtKey(it)===MTF);
  if(SET.sortMt)view=view.slice().sort((a,b)=>mtCmp(a,b));
  VW.idx=cur?view.indexOf(cur):-1;
  const g=$('grid');io.disconnect();g.textContent='';
  const fr=document.createDocumentFragment();
  if(fm)for(const t of folderTiles())fr.appendChild(t);
  for(const it of view){it.visible=false;it.tile.classList.toggle('cur',it===cur&&VW.idx>=0);fr.appendChild(it.tile);}g.appendChild(fr);
  for(const it of view)io.observe(it.tile);
  scheduleStatus();updateBar();
}
const EMPTY_HTML=$('empty').innerHTML;
function closeAll(){LS.set('lastRoot',null);if(VW.full)setFull(false);closePairPanel();$('filter').value='';$('typeSel').value='';clearTimeout(histT);setFiles([],{});}
$('btnClose').onclick=closeAll;
/* ---------- Запись поворота / зеркала в файл DXF ---------- */
function xfMenuFill(){
  const p=panes[VW.active];if(!p||!p.doc||p.isPdf)return;
  const x=p.orig?p.keepXf:p.xf,id=isId(x);
  $('xfDesc').textContent=id?'Положение как в файле — поверните или отразите кнопками ⟲ ⟳ ⇋ ⇅':'В файл: '+xfDesc(x);
  $('xfGo').disabled=id;$('xfTxtRow').hidden=!(x&&x.mirror);$('xfTxt').value=SET.xfText||'auto';$('xfBak').checked=SET.xfBak!==false;
  const it=p.it;$('xfNote').textContent=!it?'':!it.h?'Файл открыт без доступа к записи — будет предложено сохранить как новый файл.':
    !it.dh?'Файл открыт отдельно (не папкой): .bak рядом сделать нельзя.':'Положение детали: левый нижний угол остаётся на месте.';
}
/* меню кнопок панели просмотра: панель прокручивается и обрезает выпадающее — ставим меню поверх, под кнопкой */
function menuFix(M,btn){const r=btn.getBoundingClientRect();M.style.position='fixed';M.style.top=(r.bottom+4)+'px';M.style.right='auto';
  const w=M.offsetWidth||290;M.style.left=Math.max(4,Math.min(r.left,innerWidth-w-8))+'px';}
$('vXfSave').onclick=e=>{e.stopPropagation();const M=$('xfMenu');M.hidden=!M.hidden;if(!M.hidden){xfMenuFill();menuFix(M,$('vXfSave'));}};
document.addEventListener('click',e=>{if(!e.target.closest('#xfMenu')&&e.target.id!=='vXfSave')$('xfMenu').hidden=true;});
$('xfTxt').onchange=e=>{SET.xfText=e.target.value;saveSet();};
$('xfBak').onchange=e=>{SET.xfBak=e.target.checked;saveSet();};
const xfAngGo=sg=>apDo(p=>{const a=parseFloat(String($('xfAng').value).replace(',','.'));if(!(Math.abs(a)>0))return;
  p.setXf({rot:((p.xf.rot+sg*a)%360+360)%360,mirror:p.xf.mirror});xfMenuFill();});
$('xfAngL').onclick=()=>xfAngGo(1);$('xfAngR').onclick=()=>xfAngGo(-1);
async function xfWrite(){
  const p=panes[VW.active];if(!p||!p.it||p.isPdf||!p.doc||!p.doc.bbox)return;
  const it=p.it,x=p.orig?p.keepXf:p.xf;if(isId(x))return;
  $('xfMenu').hidden=true;
  // разрешение на запись — сразу, пока действует нажатие кнопки
  let canW=false;
  if(it.h&&it.h.createWritable){const tgt=(it.rid&&ROOTH.get(it.rid))||it.dh||it.h;
    try{let q=await tgt.queryPermission({mode:'readwrite'});if(q!=='granted')q=await tgt.requestPermission({mode:'readwrite'});canW=q==='granted';}catch(e){canW=false;}
    if(!canW&&!confirm('Нет разрешения на запись в папку. Сохранить как новый файл?'))return;}
  const bak=SET.xfBak!==false;
  if(canW&&bak&&!it.dh&&!confirm('Копию .bak сделать нельзя: файл открыт отдельно, без папки.\nПерезаписать файл без копии?'))return;
  $('status').textContent='Запись «'+it.name+'»…';
  try{
    const buf=new Uint8Array(await it.file.arrayBuffer());
    const L=xfMat({rot:x.rot,mirror:x.mirror,tx:0,ty:0});
    for(let i=0;i<4;i++){if(Math.abs(L[i])<1e-12)L[i]=0;else if(Math.abs(Math.abs(L[i])-1)<1e-12)L[i]=Math.sign(L[i]);}
    const r1=DXFXF.run(buf,L,{text:SET.xfText||'auto'});
    if(r1.err){flash(r1.err);return;}
    const sk=Object.entries(r1.skipped);
    if(sk.length&&!confirm('Эти объекты программа поворачивать не умеет, они останутся на старом месте:\n'+sk.map(([t,n])=>t+' — '+n).join('\n')+'\n\nВсё равно записать?'))return;
    const d1=Core.parseDXF(r1.bytes.buffer.slice(0),it.name),d0=p.doc;
    if(!d1.bbox){flash('После поворота файл не читается — запись отменена');return;}
    const ox=d0.bbox[0]+d0.origin[0],oy=d0.bbox[1]+d0.origin[1],nx=d1.bbox[0]+d1.origin[0],ny=d1.bbox[1]+d1.origin[1];
    const r2=DXFXF.run(r1.bytes,[1,0,0,1,ox-nx,oy-ny],{text:'auto',ext:[ox,oy,ox+d1.bbox[2]-d1.bbox[0],oy+d1.bbox[3]-d1.bbox[1]]});
    if(r2.err){flash(r2.err);return;}
    const out=r2.bytes,txt=r1.txtMir||r1.txtRead?` Тексты: отражено ${r1.txtMir}, читаемых ${r1.txtRead}.`:'';
    if(canW){
      let bk='';
      if(bak&&it.dh){const bn=it.name.replace(/\.[^.]*$/,'')+'.bak';const bh=await it.dh.getFileHandle(bn,{create:true});const w=await bh.createWritable();await w.write(buf);await w.close();bk=' Старый — «'+bn+'».';}
      const w=await it.h.createWritable();await w.write(out);await w.close();
      await xfReload(it,await it.h.getFile());
      flash('Записано в «'+it.name+'»: '+xfDesc(x)+'.'+bk+txt,6000);
    }else{
      const blob=new Blob([out],{type:'application/dxf'});
      if('showSaveFilePicker' in window){
        let h;try{h=await showSaveFilePicker({suggestedName:it.name,types:[{description:'DXF',accept:{'application/dxf':['.dxf']}}]});}catch(e){if(e&&e.name==='AbortError')return;throw e;}
        const w=await h.createWritable();await w.write(blob);await w.close();
      }else{const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=it.name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),5000);}
      flash('Сохранено новым файлом: '+xfDesc(x)+'.'+txt,6000);
    }
  }catch(e){flash('Не удалось записать: '+(e&&e.message||e),6000);}
  finally{if($('status').textContent.startsWith('Запись «'))updateStatus();}
}
async function xfReload(it,nf){   // файл перезаписан: перечитать, обновить миниатюру, положение — «как в файле»
  const ok=it.key;saveXf(it,{rot:0,mirror:false});
  docCache.delete(ok);if(MEAS.store)MEAS.store.delete(ok);SAVED.delete(ok);
  it.file=nf;it.key=it.path+'|'+nf.size+'|'+nf.lastModified;
  it.state=0;it.err=false;applyCaps();makeThumb(it).catch(()=>{});
  for(const p of panes)if(p.it===it){p.it=null;p.doc=null;await p.show(it);}
  updateBar();
}
$('xfGo').onclick=xfWrite;

/* подписи под миниатюрами: свои настройки для сетки и для списка */
function capText(it,c){const p=[];if(c.type)p.push(it.type.toUpperCase());if(c.size)p.push(fmtSize(it.file.size));if(c.date)p.push(fmtDate(it.file.lastModified));
  if(c.dir){const d=it.path.split('/').slice(1,-1).join(' / ');if(d)p.push(d);}return p.join(' · ');}
function applyCaps(){
  const list=SET.layout==='list',c=list?SET.capList:SET.capGrid,g=$('grid');
  g.classList.toggle('nonm',!c.name);g.classList.toggle('wrapnm',!list&&!!c.wrap);
  g.classList.toggle('nocap',!c.name&&!c.type&&!c.size&&!c.date&&!c.dir);
  for(const it of items)it.meta.textContent=capText(it,c);
}
function markCurrent(it){
  for(const t of $('grid').querySelectorAll('.tile.cur'))t.classList.remove('cur');
  if(it&&it.tile){it.tile.classList.add('cur');it.tile.scrollIntoView({block:'nearest'});}
}

/* ---------- Ленивые миниатюры ---------- */
/* телефон/планшет: меньше параллельной работы, чтобы открытый файл не ждал миниатюр */
const MOB=matchMedia('(pointer:coarse)').matches&&Math.min(screen.width,screen.height)<900;
const tq=[];let running=0;const MAXRUN=MOB?2:4,BGRUN=MOB?0:2;
const thumbKey=it=>it.key+'|t'+THUMB_VER+'|'+(it.type==='pdf'?pdfBg()+(SET.pdfDark?'i':''):dxfBg()+(SET.texts?'':'|nt'));
const io=new IntersectionObserver(es=>{for(const e of es){const it=e.target._it;it.visible=e.isIntersecting;if(it.visible&&it.state===0)enqueue(it);}pumpThumbs();},{root:$('gridWrap'),rootMargin:'1200px'});
function enqueue(it){if(it.state)return;it.state=1;tq.push(it);}
function pumpThumbs(){
  if(VW.full||panes.some(p=>p.loading&&p.el.isConnected))return; // пока грузится просмотр — всё для него
  while(running<MAXRUN){
    let i=tq.findIndex(x=>x.visible);if(i<0)i=tq.findIndex(x=>x.force);
    let it;
    if(i>=0)it=tq.splice(i,1)[0];
    else{ // видимые готовы — заранее готовим остальные по порядку, чтобы при прокрутке они уже были
      for(const x of tq)x.state=0;tq.length=0;
      if(running>=BGRUN)break;it=view.find(x=>x.state===0);if(!it)break;it.state=1;
    }
    running++;
    makeThumb(it).catch(e=>{it.ph.textContent='ошибка';}).finally(()=>{running--;pumpThumbs();scheduleStatus();});
  }
}
async function makeThumb(it){
  const k=thumbKey(it),c=await IDB.get(k);
  if(it.gen!==gen)return;
  if(c){applyThumb(it,c);return;}
  const doc=await getDoc(it);
  if(it.gen!==gen)return;
  const blob=doc.kind==='pdf'?await pdfThumb(doc):await thumbBlob(doc);
  const rec={blob,log:doc.log,size:doc.size,pages:doc.pages||0};
  applyThumb(it,rec);IDB.put(k,rec);
}
function thumbBlob(doc){
  if(!doc.bbox)return Promise.resolve(null);
  const cv=document.createElement('canvas');cv.width=TW;cv.height=TH;const ctx=cv.getContext('2d');
  ctx.fillStyle=dxfBg();ctx.fillRect(0,0,TW,TH);
  renderDoc(ctx,doc,Object.assign({W:TW,H:TH,dpr:1,lw:false,px:1.1,texts:SET.texts},fitView(doc,null,TW,TH,0.06)));
  return new Promise(res=>cv.toBlob(b=>res(b),'image/png'));
}
async function pdfThumb(doc){
  if(!doc.pdf)return null;
  const page=await doc.pdf.getPage(1),v1=page.getViewport({scale:1});
  const sc=Math.min(TW/v1.width,TH/v1.height)*0.94,ox=(TW-v1.width*sc)/2,oy=(TH-v1.height*sc)/2;
  const cv=document.createElement('canvas');cv.width=TW;cv.height=TH;const ctx=cv.getContext('2d');
  ctx.fillStyle=pdfBg();ctx.fillRect(0,0,TW,TH);
  // страница рисуется в отдельный холст: pdf.js заливает белым весь холст, а не только лист
  const pc=document.createElement('canvas');pc.width=Math.max(1,Math.round(v1.width*sc));pc.height=Math.max(1,Math.round(v1.height*sc));
  await page.render({canvasContext:pc.getContext('2d'),viewport:page.getViewport({scale:sc})}).promise;
  if(SET.pdfDark)ctx.filter=PDF_INV;ctx.drawImage(pc,ox,oy);ctx.filter='none';
  if(lum(pdfBg())>150){ctx.strokeStyle='#c3c8cf';ctx.strokeRect(ox-0.5,oy-0.5,pc.width+1,pc.height+1);}
  return new Promise(res=>cv.toBlob(b=>res(b),'image/png'));
}
function applyThumb(it,rec){
  it.state=2;it.size=rec.size;setLog(it,rec.log||[]);
  if(it.tag)it.tag.textContent=rec.pages>1?'PDF · '+rec.pages+' стр.':'PDF';
  if(rec.blob){if(it.url)URL.revokeObjectURL(it.url);it.url=URL.createObjectURL(rec.blob);it.img.src=it.url;it.img.hidden=false;it.ph.hidden=true;}
  else{it.img.hidden=true;it.ph.hidden=false;it.ph.textContent=it.err?'ошибка':'нет геометрии';}
}
function resetThumbs(keepLog=true){
  for(const it of items){if(it.url){URL.revokeObjectURL(it.url);it.url=null;}it.state=0;it.img.hidden=true;it.ph.hidden=false;it.ph.textContent='…';
    if(!keepLog){it.log=null;it.issues=0;it.badge.hidden=true;}}
  tq.length=0;for(const it of view)if(it.visible)enqueue(it);pumpThumbs();updateStatus();
}

/* ---------- Статус и журнал ---------- */
let stTimer=0,flashT=0;
function scheduleStatus(){if(!stTimer)stTimer=setTimeout(updateStatus,120);}
function updateStatus(){
  stTimer=0;
  const done=items.filter(i=>i.log).length,bad=items.filter(i=>i.issues).length;
  if(!flashT)$('status').textContent=items.length?`${curDir?'Папка: '+curDir.split('/').join(' / ')+' · ':''}Файлов: ${items.length}${view.length!==items.length?' (показано '+view.length+')':''} · проверено: ${done} · с замечаниями: ${bad}`:'';
  $('logBadge').hidden=!bad;$('logBadge').textContent=bad;$('btnLog').hidden=!bad;
  if(!$('logPanel').hidden)renderLog();
}
function flash(msg){const s=$('status');s.textContent=msg;s.classList.add('flash');clearTimeout(flashT);
  flashT=setTimeout(()=>{flashT=0;s.classList.remove('flash');updateStatus();},6000);}
let logOnlyPath=null;
function openLog(path){logOnlyPath=path||null;$('logPanel').hidden=false;renderLog();}
function renderLog(){
  const only=$('logOnly').checked,body=$('logBody');body.textContent='';
  let shown=0;
  for(const it of items){
    if(!it.log||(logOnlyPath&&it.path!==logOnlyPath))continue;
    const lines=only&&!logOnlyPath?it.log.filter(l=>l[0]!=='info'):it.log;
    if(!lines.length)continue;shown++;
    const box=document.createElement('div');box.className='lf';
    const h=document.createElement('h4');h.textContent=it.path;h.onclick=()=>{$('logPanel').hidden=true;jumpTo(it);if(!docked())setFull(true);};
    box.appendChild(h);
    for(const [l,m] of lines){const d=document.createElement('div');d.className='l-'+l;d.textContent=m;box.appendChild(d);}
    body.appendChild(box);
  }
  if(!shown)body.innerHTML='<p style="color:var(--mut)">'+(items.length?'Замечаний нет.':'Файлы не открыты.')+'</p>';
  const done=items.filter(i=>i.log).length;
  $('logFoot').textContent=logOnlyPath?'Показан один файл. Закройте и откройте журнал заново, чтобы увидеть все.':
    `Проверено ${done} из ${items.length}. Файлы проверяются, когда их миниатюры появляются на экране, или кнопкой «Проверить все файлы».`;
}
$('btnLog').onclick=()=>openLog();
$('verSet').textContent=(document.querySelector('.brand small')||{}).textContent||'';
$('setLog').onclick=()=>{$('setPanel').hidden=true;openLog();};
/* меню «Открыть» */
$('btnOpen').onclick=e=>{e.stopPropagation();$('openMenu').hidden=!$('openMenu').hidden;};
document.addEventListener('click',e=>{if(!e.target.closest('.mwrap'))$('openMenu').hidden=true;});
for(const id of ['btnFolder','btnFiles'])$(id).addEventListener('click',()=>{$('openMenu').hidden=true;});
$('logClose').onclick=()=>{$('logPanel').hidden=true;};
$('logPanel').addEventListener('click',e=>{if(e.target.id==='logPanel')$('logPanel').hidden=true;});
$('logOnly').onchange=renderLog;
$('logAll').onclick=()=>{for(const it of items)if(it.state===0){it.force=true;enqueue(it);}pumpThumbs();};
$('logClear').onclick=async()=>{await IDB.clear('thumbs');resetThumbs(false);};

/* ---------- Открытие файлов и папок ---------- */
const FSA='showDirectoryPicker' in window;
const ROOTH=new Map();   // открытые папки (id → дескриптор): разрешение на запись спрашиваем у папки целиком           // ПК Chrome: доступ к папке можно запомнить для истории
/* обход папки: файлы и подпапки читаются параллельно — по сети это в разы быстрее, чем по одному */
async function pmap(arr,n,fn){let i=0;const run=async()=>{while(i<arr.length){const k=i++;await fn(arr[k]);}};await Promise.all(Array.from({length:Math.min(n,arr.length)},run));}
let walkShown=0;
async function walkDir(dir,prefix,out){
  const files=[],dirs=[];
  for await(const [name,e] of dir.entries()){
    if(e.kind==='file'){if(/\.(dxf|pdf)$/i.test(name))files.push([name,e]);}
    else if(e.kind==='directory')dirs.push([name,e]);
  }
  await pmap(files,12,async([name,e])=>{try{out.push({file:await e.getFile(),path:prefix+'/'+name,h:e,dh:dir});}catch(err){}});
  if(out.length-walkShown>=40){walkShown=out.length;$('status').textContent='Чтение папки… найдено файлов: '+out.length;}
  await pmap(dirs,6,([name,e])=>walkDir(e,prefix+'/'+name,out));
}
async function rememberRoot(h){
  try{
    const rs=(await IDB.all('roots'))||[];
    for(const r of rs){if(r.kind===h.kind&&r.name===h.name){try{if(await r.h.isSameEntry(h)){r.t=Date.now();IDB.put(r.id,r,'roots');return r.id;}}catch(e){}}}
    const id='r'+Date.now().toString(36)+Math.random().toString(36).slice(2,7);
    await IDB.put(id,{id,h,kind:h.kind,name:h.name,t:Date.now()},'roots');return id;
  }catch(e){return null;}
}
async function openDirHandle(h){
  $('status').textContent='Чтение папки «'+h.name+'»…';
  const out=[];walkShown=0;try{await walkDir(h,h.name,out);}catch(e){flash('Папка не читается: '+e.message);return;}
  const rid=await rememberRoot(h);if(rid)ROOTH.set(rid,h);
  setFiles(out,{rid,rootName:h.name,folder:true});
  if(rid&&!FOLLOW)LS.set('lastRoot',{rid,name:h.name});
}
async function openFileHandles(hs){
  const out=[];for(const h of hs){try{const f=await h.getFile();const rid=await rememberRoot(h);out.push({file:f,path:f.name,rid,h});}catch(e){}}
  setFiles(out,{rootName:''});
  if(items.length===1){showItem(0);if(!docked())setFull(true);}
}
$('btnFolder').onclick=async()=>{
  if(FSA){try{await openDirHandle(await showDirectoryPicker({id:'dxfv-folder',mode:'read'}));}catch(e){if(e&&e.name==='AbortError')return;$('inFolder').click();}}
  else $('inFolder').click();
};
$('btnFiles').onclick=async()=>{
  if('showOpenFilePicker' in window){
    try{await openFileHandles(await showOpenFilePicker({id:'dxfv-files',multiple:true,types:[{description:'DXF и PDF',accept:{'image/vnd.dxf':['.dxf'],'application/pdf':['.pdf']}}]}));}
    catch(e){if(e&&e.name==='AbortError')return;$('inFiles').click();}
  }else $('inFiles').click();
};
$('inFolder').onchange=e=>{const fs=[...e.target.files];const root=fs.length&&fs[0].webkitRelativePath?fs[0].webkitRelativePath.split('/')[0]:'';
  setFiles(fs.map(f=>({file:f,path:f.webkitRelativePath||f.name})),{rootName:root,folder:true});e.target.value='';};
$('inFiles').onchange=e=>{setFiles([...e.target.files].map(f=>({file:f,path:f.name})),{rootName:''});e.target.value='';
  if(items.length===1){showItem(0);if(!docked())setFull(true);}};
$('filter').addEventListener('input',applyFilter);
$('typeSel').addEventListener('change',()=>{applyFilter();saveRootState();});
const ts=$('tileSize');
try{const v=localStorage.getItem('dxfv.tile');if(v)ts.value=v;else if(innerWidth<600)ts.value=140;}catch(e){if(innerWidth<600)ts.value=140;}
const setTile=()=>{const v=+ts.value,st=document.documentElement.style;st.setProperty('--tile',v+'px');
  st.setProperty('--lthumb',Math.round(Math.min(260,Math.max(40,v*0.42)))+'px');try{localStorage.setItem('dxfv.tile',v);}catch(e){}};
const bumpTile=f=>{ts.value=Math.round(Math.min(600,Math.max(80,+ts.value*f)));setTile();};
ts.oninput=setTile;setTile();
$('szMinus').onclick=()=>bumpTile(1/1.15);$('szPlus').onclick=()=>bumpTile(1.15);
$('gridWrap').addEventListener('wheel',e=>{if(!e.ctrlKey)return;e.preventDefault();bumpTile(e.deltaY<0?1.1:1/1.1);},{passive:false});

document.addEventListener('dragover',e=>{e.preventDefault();document.body.classList.add('drag');});
document.addEventListener('dragleave',e=>{if(!e.relatedTarget)document.body.classList.remove('drag');});
document.addEventListener('drop',async e=>{
  e.preventDefault();document.body.classList.remove('drag');
  const dt=[...e.dataTransfer.items].filter(i=>i.kind==='file');
  if(dt.length&&dt[0].getAsFileSystemHandle){
    const hs=(await Promise.all(dt.map(i=>i.getAsFileSystemHandle()))).filter(Boolean);
    if(hs.length===1&&hs[0].kind==='directory'){await openDirHandle(hs[0]);return;}
    const out=[];
    for(const h of hs){
      if(h.kind==='directory'){try{await walkDir(h,h.name,out);}catch(err){}}
      else if(/\.(dxf|pdf)$/i.test(h.name)){try{out.push({file:await h.getFile(),path:h.name,rid:await rememberRoot(h)});}catch(err){}}
    }
    setFiles(out,{});if(items.length===1){showItem(0);if(!docked())setFull(true);}
    return;
  }
  const ents=dt.map(i=>i.webkitGetAsEntry&&i.webkitGetAsEntry()).filter(Boolean),out=[];
  async function walk(en){
    if(en.isFile){if(/\.(dxf|pdf)$/i.test(en.name)){try{const f=await new Promise((r,j)=>en.file(r,j));out.push({file:f,path:en.fullPath.replace(/^\//,'')});}catch(err){}}}
    else if(en.isDirectory){const rd=en.createReader();let b;do{b=await new Promise((r,j)=>rd.readEntries(r,j)).catch(()=>[]);for(const x of b)await walk(x);}while(b.length);}
  }
  if(ents.length){$('status').textContent='Чтение папки…';for(const en of ents)await walk(en);}
  else for(const f of e.dataTransfer.files)out.push({file:f,path:f.name});
  setFiles(out,ents.length===1&&ents[0].isDirectory?{rootName:ents[0].name,folder:true}:{});
});

/* =====================================================================
   ОКНО ПРОСМОТРА: одна или несколько панелей (Pane).
   Каждая панель — свой файл, свой масштаб/сдвиг/лист PDF и своя трансформация xf
   (основа для будущего сравнения версий).
   ===================================================================== */
const VW={idx:-1,full:false,active:0,set:[]};
const SAVED=new Map(),panes=[];
const docked=()=>SET.preview&&innerWidth>=760;
const viewerShown=()=>VW.full||docked();

/* растр листа PDF «во весь экран» + небольшой кэш отрисованных листов */
const baseCache=new Map();
/* масштаб растра = ровно «показать всё» в этом окне × плотность пикселей: в исходном виде лист пиксель в пиксель, без размытия */
function baseScale(vp,pane){
  const W=pane&&pane.W||innerWidth,H=pane&&pane.H||innerHeight,d=devicePixelRatio||1;
  return Math.min(6,Math.max(0.2,Math.min(W*0.96/vp.width,H*0.96/vp.height)*d));
}
async function renderBase(page,key,pane){return renderBaseAt(page,key,baseScale(page.getViewport({scale:1}),pane));}
async function renderBaseAt(page,key,sc,rot){
  rot=rot||0;key+='|r'+rot;const vp=page.getViewport({scale:1,rotation:rot});
  const hit=baseCache.get(key);if(hit&&Math.abs(hit.sc/sc-1)<0.02){baseCache.delete(key);baseCache.set(key,hit);return hit;}
  const c=document.createElement('canvas');c.width=Math.ceil(vp.width*sc);c.height=Math.ceil(vp.height*sc);
  await page.render({canvasContext:c.getContext('2d'),viewport:page.getViewport({scale:sc,rotation:rot})}).promise;
  const r={c,sc};baseCache.set(key,r);while(baseCache.size>8)baseCache.delete(baseCache.keys().next().value);
  return r;
}

class Pane{
  constructor(){
    const el=document.createElement('div');el.className='pane';
    el.innerHTML='<div class="pcap"></div><canvas></canvas>';
    this.el=el;this.cap=el.querySelector('.pcap');this.cv=el.querySelector('canvas');this.ctx=this.cv.getContext('2d');
    this.it=null;this.doc=null;this.loading=false;this.tok=0;
    this.s=1;this.cx=0;this.cy=0;this.fitS=1;this.W=0;this.H=0;this.dpr=1;this.pending=null;
    this.xf={tx:0,ty:0,rot:0,mirror:false};this.hidden=new Set();
    this.pageNo=1;this.page=null;this.pw=0;this.ph=0;
    this.P={timer:0,t2:0,midTimer:0,rbTimer:0};this.pg=[];this.cont=false;this.raf=0;this.orig=false;this.keepXf=null;
    const ch=document.createElement('div');ch.className='pxf';ch.hidden=true;
    ch.innerHTML='<span></span><button data-a="o" title="Показать как в файле, не сбрасывая поворот (O)"></button><button data-a="r" title="Сбросить поворот для этого файла (0)">сбросить</button>';
    el.appendChild(ch);this.chip=ch;
    ch.addEventListener('pointerdown',e=>e.stopPropagation());
    ch.children[1].onclick=()=>{setActive(this);this.toggleOrig();};
    ch.children[2].onclick=()=>{setActive(this);this.setXf({rot:0,mirror:false});};
    new ResizeObserver(()=>this.resize()).observe(this.cv);
    this.bindPointer();
  }
  get isPdf(){return !!(this.doc&&this.doc.kind==='pdf');}
  resize(){
    const r=this.cv.getBoundingClientRect();if(!r.width||!r.height)return;
    this.dpr=devicePixelRatio||1;this.W=r.width;this.H=r.height;
    this.cv.width=Math.round(this.W*this.dpr);this.cv.height=Math.round(this.H*this.dpr);
    if(this.pending&&this.doc)this.applyView(this.pending);
    else if(this.doc&&this.doc.bbox){ // окно поменяло размер: вписанный чертёж — вписать заново, приближенный — сохранить относительный масштаб
      if(this.isPdf&&this.pg.length)this.rebase();
      if(this.fitted){this.fit();return;}
      const of=this.fitS;this.fitS=this.fitView().s;if(of&&this.fitS)this.s*=this.fitS/of;}
    this.draw();
  }
  fitView(){
    if(this.ov&&this.ov.bb)return fitView({bbox:this.ov.bb},null,this.W,this.H,0.05);
    if(this.isPdf&&this.cont&&this.pg.length){ // непрерывный режим: текущая страница целиком в окне, соседние — выше и ниже
      const e=this.curPage()||this.pg[0],s=Math.min(this.W*0.96/this.pw,this.H*0.96/e.h);return {s,cx:this.pw/2,cy:this.ph-(e.oy+e.h/2)};}
    return fitView(this.doc,this.xf,this.W,this.H,this.isPdf?0.02:0.05);
  }
  fit(){if(!this.doc||!this.doc.bbox)return;if(!this.W){this.pending='fit';return;}Object.assign(this,this.fitView());this.fitS=this.s;this.fitted=true;this.draw();}
  applyView(sv){ // 'fit' или {z,cx,cy} — z = масштаб относительно «показать всё»
    if(!this.W){this.pending=sv;return;}
    this.pending=null;if(!this.doc||!this.doc.bbox){this.draw();return;}
    const f=this.fitView();this.fitS=f.s;
    if(sv&&sv!=='fit'&&Math.abs(sv.z-1)>0.02){this.s=f.s*sv.z;this.cx=sv.cx;this.cy=sv.cy;this.fitted=false;}else{Object.assign(this,f);this.fitted=true;}
    this.draw();
  }
  save(){if(this.it&&this.doc&&!this.loading&&this.W&&this.fitS&&!this.pending)SAVED.set(this.it.key,{z:this.s/this.fitS,cx:this.cx,cy:this.cy,page:this.pageNo,cont:!!this.cont});}
  s2w(x,y){return [this.cx+(x-this.W/2)/this.s,this.cy-(y-this.H/2)/this.s];}
  clampS(s){return Math.min(Math.max(s,this.fitS/2000),this.fitS*(this.isPdf?200:1e6));}
  zoomAt(x,y,f){this.fitted=false;if(this.isPdf)this.cancelHi();const ns=this.clampS(this.s*f),[wx,wy]=this.s2w(x,y);this.s=ns;this.cx=wx-(x-this.W/2)/ns;this.cy=wy+(y-this.H/2)/ns;this.draw();this.changed();}
  changed(){ // при сравнении второе окно повторяет масштаб и сдвиг (в мм — для одинаковых деталей совпадают)
    if(this.ov&&this.ov.res){for(const o of panes)if(o!==this&&o.ov&&o.ov.res){o.fitted=this.fitted;o.s=this.s;o.cx=this.cx;o.cy=this.cy;o.draw();}return;}  // сравнение контуров: один вид на обе панели
    if(!VW.cmp||!SET.sync||VW.set.length!==2)return;const o=panes[1-panes.indexOf(this)];
    if(!o||!o.doc||!this.doc||o.isPdf!==this.isPdf)return;o.fitted=this.fitted;o.s=this.s;o.cx=this.cx;o.cy=this.cy;o.draw();
  }
  draw(){if(!this.raf)this.raf=requestAnimationFrame(()=>{this.raf=0;this.paint();});}
  paint(){
    const c=this.ctx,d=this.dpr;
    const bg=this.it&&this.it.type==='pdf'?pdfBg():dxfBg();
    c.setTransform(1,0,0,1,0,0);c.fillStyle=bg;c.fillRect(0,0,this.cv.width,this.cv.height);
    if(this.isPdf&&this.pg.length&&!this.loading){this.paintPdf();return;}
    if(this.ov&&this.ov.res&&!this.loading){ovPaint(this,c,d);return;}
    if(this.doc&&!this.isPdf&&this.doc.bbox&&!this.loading){renderDoc(c,this.doc,{s:this.s,cx:this.cx,cy:this.cy,W:this.W,H:this.H,dpr:d,xf:this.xf,hidden:this.hidden,lw:SET.lw,texts:SET.texts,k:SET.lineK});if(this.chk)chkPaint(this,c,d);if(MEAS.on&&this.it)measPaint(this,c,d);return;}
    c.setTransform(d,0,0,d,0,0);c.fillStyle='#7b818a';c.font='14px system-ui,sans-serif';c.textAlign='center';
    const t=this.loading?'Загрузка…':this.doc?(this.doc.log.some(l=>l[0]==='error')?'Файл не открылся — см. журнал':'Нет отрисовываемой геометрии — см. журнал'):'';
    c.fillText(t,this.W/2,this.H/2);
  }
  /* PDF. Страницы — массив this.pg: в обычном режиме одна текущая, в непрерывном — все подряд сверху вниз.
     Каждая страница рисуется из слоёв:
       base — вся страница ровно в масштабе «показать всё» (в непрерывном — «по ширине»): чёткая в исходном виде;
       mid  — вся страница крупнее (до 4096 px), только в обычном режиме, готовится в фоне — быстрое приближение;
       hi   — видимая часть ровно в текущем масштабе: сначала только видимое, через ~0,35 с — с запасом вокруг.
     Старый hi другого масштаба поверх точного base не кладётся (из-за этого после «вписать» было мыльно).
     При смене масштаба незаконченная отрисовка прерывается. */
  baseScFor(e){const d=this.dpr||devicePixelRatio||1;
    return this.cont?Math.min(6,Math.max(0.2,Math.min((this.W||innerWidth)*0.96/this.pw,(this.H||innerHeight)*0.96/e.h)*d)):baseScale({width:e.w,height:e.h},this);}
  ensureBase(e){
    if(e.base||e.bp)return e.bp;const tok=this.tok;
    e.bp=renderBaseAt(e.page,this.it.key+'|'+e.n+(this.cont?'|c':''),this.baseScFor(e),e.rot).then(b=>{e.bp=null;if(tok!==this.tok)return;e.base=b.c;e.baseSc=b.sc;this.draw();},()=>{e.bp=null;});
    return e.bp;
  }
  viewRectAll(){const s=this.s;return {x0:this.cx-this.W/2/s,x1:this.cx+this.W/2/s,y0:this.ph-(this.cy+this.H/2/s),y1:this.ph-(this.cy-this.H/2/s)};}
  pageView(e,v){return {x0:Math.max(0,v.x0-e.ox),x1:Math.min(e.w,v.x1-e.ox),y0:Math.max(0,v.y0-e.oy),y1:Math.min(e.h,v.y1-e.oy)};}
  curPage(){return this.pg.find(e=>e.n===this.pageNo)||this.pg[0]||null;}
  paintPdf(){
    const c=this.ctx,d=this.dpr,s=this.s,t=s*d,flt=pdfFilter(),v=this.viewRectAll(),vh=v.y1-v.y0;let need=false;
    const brd=lum(pdfBg())>150?'#a9aeb6':'#3a3f47';
    for(const e of this.pg){
      const vis=!(e.oy+e.h<v.y0||e.oy>v.y1);
      if(!vis){if(this.cont&&(e.oy+e.h<v.y0-4*vh||e.oy>v.y1+4*vh)){e.base=null;e.hi=null;e.hv=null;}continue;} // далёкие страницы — освободить память
      const L=this.W/2+(e.ox-this.cx)*s,T=this.H/2-((this.ph-e.oy)-this.cy)*s;
      if(!e.base){c.fillStyle='#fff';c.fillRect(L*d,T*d,e.w*s*d,e.h*s*d);this.ensureBase(e);need=true;}
      else{
        if(flt)c.filter=flt;
        const lv=[[e.base,e.baseSc]];if(e.mid)lv.push([e.mid,e.midSc]);
        let src=lv[lv.length-1];for(const x of lv)if(x[1]>=t*0.98){src=x;break;}
        const exact=Math.abs(src[1]/t-1)<0.01;
        c.imageSmoothingEnabled=!exact;c.imageSmoothingQuality='high';
        if(exact)c.drawImage(src[0],Math.round(L*d),Math.round(T*d));else c.drawImage(src[0],L*d,T*d,e.w*s*d,e.h*s*d);
        let ok=exact;const h=e.hv;
        if(!exact&&e.hi&&h){
          const same=Math.abs(h.s/s-1)<1e-9;
          if(same||h.s*d>src[1]*1.05){const X=(L+h.x0*s)*d,Y=(T+h.y0*s)*d;c.imageSmoothingEnabled=!same;
            if(same)c.drawImage(e.hi,Math.round(X),Math.round(Y));else c.drawImage(e.hi,X,Y,(h.x1-h.x0)*s*d,(h.y1-h.y0)*s*d);}
          if(same){const pv=this.pageView(e,v);ok=pv.x0>=h.x0-1e-6&&pv.x1<=h.x1+1e-6&&pv.y0>=h.y0-1e-6&&pv.y1<=h.y1+1e-6;}
        }
        c.filter='none';if(!ok)need=true;
      }
      c.strokeStyle=brd;c.lineWidth=1;c.strokeRect(Math.round(L*d)-0.5,Math.round(T*d)-0.5,Math.round(e.w*s*d)+1,Math.round(e.h*s*d)+1);
    }
    clearTimeout(this.P.timer);if(need)this.P.timer=setTimeout(()=>this.renderHi(0),120);
    if(this.cont&&!this.pending&&this.fitS)this.trackPage(v);
  }
  clampCont(){ // непрерывный PDF: не уезжать за первую и последнюю страницу
    const hv=this.H/2/this.s,m=40/this.s,lo=hv-m,hi=this.ph-hv+m;
    this.cy=lo>hi?this.ph/2:Math.min(hi,Math.max(lo,this.cy));
  }
  reloadPdf(){if(!this.isPdf||!this.doc||!this.doc.pdf)return;this.save();this.pdfShow(this.pageNo,SAVED.get(this.it.key));}
  trackPage(v){ // текущая страница в непрерывном режиме — та, что в середине окна
    const yc=(v.y0+v.y1)/2;let n=this.pageNo;
    for(const e of this.pg)if(yc>=e.oy-7&&yc<=e.oy+e.h+7){n=e.n;break;}
    if(n!==this.pageNo){this.pageNo=n;this.renderCap();if(panes[VW.active]===this)updateBar();}
  }
  cancelHi(){clearTimeout(this.P.timer);clearTimeout(this.P.t2);for(const e of this.pg)if(e.task){try{e.task.cancel();}catch(x){}e.task=null;}}
  async renderHi(phase){
    if(!this.el.isConnected||!this.W||!this.pg.length)return;
    const tok=this.tok,s=this.s,S=s*this.dpr,v=this.viewRectAll(),vw=this.W/s,vh=this.H/s;
    for(const e of this.pg){
      if(tok!==this.tok||s!==this.s)return;
      if(!e.page||e.oy+e.h<v.y0||e.oy>v.y1)continue;
      if(e.base&&Math.abs(e.baseSc/S-1)<0.01)continue;          // base и так точный
      if(e.mid&&Math.abs(e.midSc/S-1)<0.01)continue;
      const pv=this.pageView(e,v);if(pv.x1<=pv.x0||pv.y1<=pv.y0)continue;
      let m=phase?0.5:0;
      while(m>0&&((Math.min(e.w,pv.x1+vw*m)-Math.max(0,pv.x0-vw*m))*(Math.min(e.h,pv.y1+vh*m)-Math.max(0,pv.y0-vh*m))*S*S>(MOB?8e6:24e6)))m-=0.1;
      m=Math.max(0,m);
      const r={x0:Math.max(0,pv.x0-vw*m),x1:Math.min(e.w,pv.x1+vw*m),y0:Math.max(0,pv.y0-vh*m),y1:Math.min(e.h,pv.y1+vh*m)};
      const h=e.hv;if(h&&h.s===s&&r.x0>=h.x0-1e-6&&r.x1<=h.x1+1e-6&&r.y0>=h.y0-1e-6&&r.y1<=h.y1+1e-6)continue;
      if(e.task){try{e.task.cancel();}catch(x){}}
      const c=document.createElement('canvas');c.width=Math.max(1,Math.round((r.x1-r.x0)*S));c.height=Math.max(1,Math.round((r.y1-r.y0)*S));
      const task=e.page.render({canvasContext:c.getContext('2d'),viewport:e.page.getViewport({scale:S,rotation:e.rot,offsetX:-r.x0*S,offsetY:-r.y0*S})});
      e.task=task;
      try{await task.promise;}catch(x){return;}
      if(e.task!==task)return;e.task=null;
      if(tok!==this.tok||s!==this.s)return;
      e.hi=c;e.hv=Object.assign({s},r);this.draw();
    }
    if(!phase){clearTimeout(this.P.t2);this.P.t2=setTimeout(()=>{if(tok===this.tok&&s===this.s)this.renderHi(1);},350);}
  }
  scheduleMid(){ // крупный растр всей страницы — в фоне (только обычный режим)
    const P=this.P;clearTimeout(P.midTimer);if(this.cont||this.pg.length!==1||MOB)return;
    P.midTimer=setTimeout(async()=>{
      const e=this.pg[0],tok=this.tok;if(!e||!e.base||!this.el.isConnected)return;
      const sc=Math.min(e.baseSc*3,4096/Math.max(e.w,e.h));if(!(sc>e.baseSc*1.3))return;
      const c=document.createElement('canvas');c.width=Math.ceil(e.w*sc);c.height=Math.ceil(e.h*sc);
      const task=e.page.render({canvasContext:c.getContext('2d'),viewport:e.page.getViewport({scale:sc,rotation:e.rot})});e.mtask=task;
      try{await task.promise;}catch(x){return;}
      if(tok!==this.tok||this.pg[0]!==e)return;e.mid=c;e.midSc=sc;e.mtask=null;this.draw();
    },350);
  }
  async rebase(){ // окно поменяло размер — растры «показать всё» под новый размер (старые видны до готовности)
    clearTimeout(this.P.rbTimer);const tok=this.tok;
    this.P.rbTimer=setTimeout(()=>{if(tok!==this.tok)return;
      for(const e of this.pg){if(!e.base||Math.abs(this.baseScFor(e)/e.baseSc-1)<=0.02)continue;
        const old=e.base;e.base=null;e.mid=null;this.ensureBase(e);if(!this.cont&&e.bp)e.base=old;}  // в обычном режиме старый виден до готовности
      if(!this.cont)this.scheduleMid();this.draw();},200);
  }
  pdfReset(){const P=this.P;for(const e of this.pg||[]){for(const k of ['task','mtask'])if(e[k]){try{e[k].cancel();}catch(x){}}}
    for(const k of ['timer','t2','midTimer','rbTimer'])clearTimeout(P[k]);this.pg=[];this.page=null;this.cont=false;}
  async pdfShow(n,sv){
    const doc=this.doc,tok=++this.tok;this.pdfReset();this.loading=true;this.sugRot=null;this.draw();
    const cont=!!SET.pdfCont&&doc.pages>1,nums=cont?Array.from({length:Math.min(doc.pages,300)},(_,i)=>i+1):[n];
    let pages;try{pages=await Promise.all(nums.map(k=>doc.pdf.getPage(k)));}catch(e){if(tok===this.tok){this.loading=false;this.draw();this.onUpdate();}return;}
    if(tok!==this.tok)return;
    const G=cont?14:0;let y=0,maxW=0;
    const extra=PROT.get(this.it.key)||0;this.prot=extra;
    const pg=pages.map((page,i)=>{const rot=((page.rotate||0)+extra)%360,vp=page.getViewport({scale:1,rotation:rot});maxW=Math.max(maxW,vp.width);const e={n:nums[i],page,rot,w:vp.width,h:vp.height,oy:y,ox:0};y+=vp.height+G;return e;});
    for(const e of pg)e.ox=(maxW-e.w)/2;
    this.cont=cont;this.pg=pg;this.pw=maxW;this.ph=Math.max(1,y-G);this.pageNo=n;this.page=(pg.find(e=>e.n===n)||pg[0]).page;
    doc.bbox=[0,0,this.pw,this.ph];
    const first=pg.find(e=>e.n===n)||pg[0];
    if(this.W)await this.ensureBase(first);
    if(tok!==this.tok)return;
    this.loading=false;
    this.applyView(sv&&sv.page===n&&!!sv.cont===cont?sv:'fit');
    this.scheduleMid();this.rebase(); // если размер окна успел поменяться, пока готовился растр
    this.onUpdate();
    pdfSuggestRot(this,first);
  }
  pdfRotate(d){ // повернуть лист PDF на d градусов по часовой (запоминается для файла)
    if(!this.isPdf||!this.doc||!this.doc.pdf)return;const v=(((this.prot||0)+d)%360+360)%360;
    if(v)PROT.set(this.it.key,v);else PROT.delete(this.it.key);savePROT();this.save();this.pdfShow(this.pageNo,null);
  }
  async show(it){
    if(this.it===it&&this.doc){this.onUpdate();return;}
    this.save();
    const tok=++this.tok;this.it=it;this.doc=null;this.ms=null;this.chk=null;this.loading=true;this.pdfReset();this.pending=null;this.pageNo=1;
    this.orig=false;this.keepXf=null;
    const sx=it.type==='dxf'&&XFS.get(xfKey(it));this.xf={tx:0,ty:0,rot:sx?sx.rot:0,mirror:sx?!!sx.mirror:false};
    this.renderCap();this.draw();
    const doc=await getDoc(it);
    if(tok!==this.tok)return;
    this.doc=doc;const sv=SAVED.get(it.key);
    if(doc.kind==='pdf'&&doc.pdf)await this.pdfShow(sv?Math.min(sv.page||1,doc.pages):1,sv);
    else{this.loading=false;this.applyView(sv||'fit');this.onUpdate();if(it.type==='dxf'&&$('vChk').classList.contains('on'))chkRun(this);}
    if(it.state<2&&it.gen===gen){const k=tq.indexOf(it);if(k>=0)tq.splice(k,1);it.state=1;makeThumb(it).catch(()=>{});}
  }
  applyXf(nx){ // сменить положение, сохранив место, на которое смотрим
    const [mx,my]=mApply(mInv(xfMat(this.xf)),this.cx,this.cy);
    this.xf=Object.assign({tx:0,ty:0},nx);[this.cx,this.cy]=mApply(xfMat(this.xf),mx,my);
    if(this.fitted){Object.assign(this,this.fitView());this.fitS=this.s;}
    else{const ofit=this.fitS;this.fitS=this.fitView().s;if(ofit&&this.fitS)this.s*=this.fitS/ofit;}
    this.draw();
  }
  setXf(nx){
    if(this.isPdf||!this.doc||!this.doc.bbox)return;
    this.orig=false;this.keepXf=null;this.applyXf(nx);saveXf(this.it,this.xf);this.onUpdate();
  }
  toggleOrig(){ // посмотреть «как в файле» и вернуться к своему положению
    if(this.isPdf||!this.doc||!this.doc.bbox)return;
    if(this.orig){this.orig=false;this.applyXf(this.keepXf);this.keepXf=null;}
    else{if(isId(this.xf))return;this.keepXf={rot:this.xf.rot,mirror:this.xf.mirror};this.orig=true;this.applyXf({rot:0,mirror:false});}
    this.onUpdate();
  }
  updChip(){
    const x=this.orig?this.keepXf:this.xf,show=!!(this.doc&&!this.isPdf&&this.doc.bbox&&x&&!isId(x));
    this.chip.hidden=!show;if(!show)return;
    this.chip.classList.toggle('orig',this.orig);
    this.chip.children[0].textContent=this.orig?'Показано как в файле':'⟳ '+xfDesc(x);
    this.chip.children[1].textContent=this.orig?'вернуть':'исходное';
  }
  rotate(d){if(this.isPdf){this.pdfRotate(-d);return;}this.setXf({rot:((this.xf.rot+d)%360+360)%360,mirror:this.xf.mirror});}
  mirror(){this.setXf({rot:(360-this.xf.rot)%360,mirror:!this.xf.mirror});}   // зеркало по горизонтали экрана
  mirrorV(){this.setXf({rot:(540-this.xf.rot)%360,mirror:!this.xf.mirror});}  // по вертикали = по горизонтали + 180°
  xfText(){if(this.isPdf)return '';return this.orig?'показано как в файле':xfDesc(this.xf);}
  clear(){this.save();this.tok++;this.it=null;this.doc=null;this.loading=false;this.pdfReset();this.pending=null;this.draw();}
  pageGo(d){
    if(!this.isPdf||!this.doc.pdf)return false;
    const n=Math.min(Math.max(this.pageNo+d,1),this.doc.pages);
    if(this.cont){const e=this.pg.find(x=>x.n===n);if(e){this.pageNo=n;if(e.h*this.s<=this.H*1.001){this.cy=this.ph-(e.oy+e.h/2);this.fitted=Math.abs(this.s/this.fitView().s-1)<1e-6;}else{this.fitted=false;this.cy=this.ph-e.oy-this.H/2/this.s+12/this.s;}this.clampCont();this.draw();this.onUpdate();}return true;}
    if(n!==this.pageNo){this.save();this.pdfShow(n,SAVED.get(this.it.key));}
    return true;
  }
  dims(){const d=this.doc;if(!d)return '';if(d.kind==='pdf'){const e=this.curPage();return e?sheetText(e.w,e.h):'';}
    if(!d.size)return '';const t=this.xfText();
    return `Габарит: ${sizeText(d.size)}`+(t?'  ·  '+t:'');}
  renderCap(){ // имя файла и отдельные плашки: габарит, материал/толщина/кол-во, подпапка, дата, размер
    const c=SET.capV,it=this.it,C=this.cap;C.textContent='';if(!it)return;
    const add=(t,cls,title)=>{const e=document.createElement('span');e.className=cls;e.textContent=t;if(title)e.title=title;C.appendChild(e);return e;};
    if(it.cmpB)add('⇆ «'+it.rootName+'»','ch');
    if(c.name||!(c.dims||c.spec||c.dir||c.date||c.size))add(it.name,'cn',it.path);
    const d=this.doc;
    if(c.dims&&d){if(d.kind==='pdf'){const e=this.curPage();if(e)add(sheetText(e.w,e.h).replace('Лист ',''),'ch dim');}else if(d.size)add(sizeText(d.size),'ch dim','Габарит, мм (длинная сторона первой)');}
    if(c.spec&&it.type==='dxf'){const sp=specOf(it);if(sp)add(sp,'ch','Из имени файла: материал · толщина · количество');}
    if(d&&d.kind==='pdf'&&d.pages>1)add('стр. '+this.pageNo+'/'+d.pages,'ch');
    if(c.dir){const dr=it.path.split('/').slice(1,-1).join(' / ');if(dr)add(dr,'ch');}
    if(c.date)add(fmtDate(it.file.lastModified),'ch');
    if(c.size)add(fmtSize(it.file.size),'ch');
    const dups=it.dups;if(dups&&dups.length>1)add('×'+dups.length+' копии','ch dup','Одинаковые файлы (имя и размер) в разных папках:\n'+dups.map(x=>x.path).join('\n'));
    const x=this.xfText();if(x)add(x,'ch');
  }
  onUpdate(){
    this.updChip();
    const dm=this.dims();
    this.renderCap();
    if(panes[VW.active]===this)updateBar();
    pumpThumbs();
    if(this===panes[0]&&VW.set.length===1&&this.isPdf)prepareNext();
  }
  bindPointer(){
    const cv=this.cv,ptrs=new Map();let tapT=0,tapX=0,tapY=0,downT=0,downX=0,downY=0,moved=false,multi=false,fitDown=false,sv0=null;
    const pos=e=>{const r=cv.getBoundingClientRect();return [e.clientX-r.left,e.clientY-r.top];};
    cv.addEventListener('pointerdown',e=>{
      setActive(this);try{cv.setPointerCapture(e.pointerId);}catch(x){}const [x,y]=pos(e);ptrs.set(e.pointerId,{x,y});
      if(ptrs.size===1){downT=performance.now();downX=x;downY=y;moved=false;multi=false;fitDown=this.fitted;sv0={s:this.s,cx:this.cx,cy:this.cy};}else{moved=true;multi=true;}
    });
    cv.addEventListener('pointermove',e=>{
      const [x,y]=pos(e);
      if(this.doc&&!this.isPdf&&this.doc.bbox&&e.pointerType==='mouse'){const [wx,wy]=mApply(mInv(xfMat(this.xf)),...this.s2w(x,y));$('vCoord').textContent=`X ${fmt(wx+this.doc.origin[0])}   Y ${fmt(wy+this.doc.origin[1])}`;}
      if(e.pointerType==='mouse')loupeMove(this,x,y);
      if(MEAS.on&&!ptrs.size&&e.pointerType==='mouse'&&!loupeOn())measHover(this,x,y);
      const p=ptrs.get(e.pointerId);if(!p)return;
      if(Math.hypot(x-downX,y-downY)>6)moved=true;
      if(ptrs.size===1&&this.ov&&this.ov.res&&e.shiftKey){ovNudge(this,(x-p.x)/this.s,-(y-p.y)/this.s);p.x=x;p.y=y;}  // наложение: Shift — двигать вторую деталь
      else if(ptrs.size===1){this.fitted=false;this.cx-=(x-p.x)/this.s;this.cy+=(y-p.y)/this.s;p.x=x;p.y=y;this.draw();this.changed();}
      else if(ptrs.size===2){
        const [a,b]=[...ptrs.values()];
        const m0=[(a.x+b.x)/2,(a.y+b.y)/2],d0=Math.hypot(a.x-b.x,a.y-b.y);
        p.x=x;p.y=y;
        const m1=[(a.x+b.x)/2,(a.y+b.y)/2],d1=Math.hypot(a.x-b.x,a.y-b.y);
        if(d0>0){this.fitted=false;if(this.isPdf)this.cancelHi();const [wx,wy]=this.s2w(m0[0],m0[1]);this.s=this.clampS(this.s*d1/d0);
          this.cx=wx-(m1[0]-this.W/2)/this.s;this.cy=wy+(m1[1]-this.H/2)/this.s;this.draw();this.changed();}
      }
    });
    const end=e=>{
      if(!ptrs.has(e.pointerId))return;ptrs.delete(e.pointerId);
      if(e.type==='pointerup'&&e.pointerType!=='mouse'&&ptrs.size===0&&!multi&&fitDown&&VW.set.length===1&&performance.now()-downT<500){ // свайп по листу — соседний файл
        const [x,y]=pos(e),dx=x-downX,dy=y-downY;
        if(Math.abs(dx)>70&&Math.abs(dy)<60){Object.assign(this,sv0);this.fitted=true;this.draw();step(dx<0?1:-1);return;}
      }
      if(LOUPE.on&&ptrs.size===0&&!moved&&!multi&&e.type==='pointerup'&&e.pointerType==='mouse'&&e.button===0){const [x,y]=pos(e);LOUPE.p=this;LOUPE.x=x;LOUPE.y=y;LOUPE.down=!LOUPE.down;loupeSet();return;}   // лупа с кнопки: клик — показать, ещё клик — убрать
      if(MEAS.on&&ptrs.size===0&&!moved&&!multi&&e.type==='pointerup'&&!(e.pointerType==='mouse'&&e.button!==0)&&this.doc&&!this.isPdf&&!this.ov){const [x,y]=pos(e);measClick(this,x,y);return;}
      if(ptrs.size===0&&!moved&&performance.now()-downT<300){
        const t=performance.now();
        if(t-tapT<350&&Math.hypot(downX-tapX,downY-tapY)<30){this.fit();tapT=0;}else{tapT=t;tapX=downX;tapY=downY;}
      }
    };
    cv.addEventListener('pointerup',end);cv.addEventListener('pointercancel',end);
    cv.addEventListener('pointerleave',()=>{if(LOUPE.p===this)$('loupe').hidden=true;});
    cv.addEventListener('wheel',e=>{e.preventDefault();
      if(loupeOn()){loupeK(e.deltaY<0?1.25:0.8);return;}   // лупа на экране: колесо меняет её увеличение; нет лупы — обычный масштаб
      const [x,y]=pos(e);const k=e.deltaMode===1?33:e.deltaMode===2?400:1,dy=e.deltaY*k;
      if(this.isPdf&&this.cont&&!e.ctrlKey&&!e.shiftKey&&!e.altKey){ // непрерывный PDF: колесо — прокрутка, Ctrl/Shift+колесо — масштаб
        this.fitted=false;this.cy-=dy/this.s;this.cx+=e.deltaX*k/this.s;this.clampCont();this.draw();this.changed();return;}
      this.zoomAt(x,y,Math.exp(-dy*0.0015));},{passive:false});
    cv.addEventListener('mouseleave',()=>{$('vCoord').textContent='';});
  }
}

let prepTimer=0;
function prepareNext(){ // заранее открыть и отрисовать соседние PDF
  clearTimeout(prepTimer);
  prepTimer=setTimeout(async()=>{
    if(VW.set.length!==1)return;const p0=panes[0];
    for(const d of [1,-1]){
      if(!viewerShown()||p0.pg.some(e=>e.task))return;
      const it=view[(VW.idx+d+view.length)%view.length];if(!it||it.type!=='pdf'||it===p0.it)continue;
      try{const doc=await getDoc(it);if(!doc.pdf)continue;const pg=await doc.pdf.getPage(1);await renderBase(pg,it.key+'|1',p0);}catch(e){}
    }
  },400);
}

/* ---------- Комплект: чертёж + его развёртки ---------- */
function setFor(it){
  if(!it)return [];
  if(it.type==='pdf')return dedupe([it,...targets(it)],it);
  const p=targets(it)[0];return p?dedupe([p,...targets(p)],it):[it];
}
function layoutClear(){VW.idx=-1;VW.set=[];VW.active=0;layoutStage();updateBar();}
function layoutStage(){
  const st=$('stage'),n=VW.set.length;
  while(panes.length<n)panes.push(new Pane());
  panes.forEach((p,k)=>{if(k>=n&&p.el.parentNode){p.clear();p.el.remove();}});
  for(let k=0;k<n;k++){const el=panes[k].el;if(st.children[k]!==el)st.insertBefore(el,st.children[k]||null);}
  st.classList.toggle('multi',n>1);st.classList.toggle('capone',n===1&&(FOLLOW||!!SET.capV.single));
  gridStage();
  $('stageMsg').hidden=n>0;
  $('stageMsg').textContent=items.length?'Выберите файл в списке':'Откройте папку кнопкой «Папка» или перетащите её сюда';
}
function gridStage(){
  const st=$('stage'),S=st.style,set=VW.set,n=set.length;
  panes.forEach(p=>p.el.style.gridArea='');
  if(n<=1){S.gridTemplateColumns='1fr';S.gridTemplateRows='1fr';return;}
  const portrait=st.clientWidth<st.clientHeight*0.95;
  if(!(set[0].type==='pdf'&&set.slice(1).every(x=>x.type!=='pdf'))){ // окна одинаковые: сравнение, несколько DXF на втором мониторе
    const cols=portrait?Math.min(n,2):Math.ceil(Math.sqrt(n*1.5)),rows=Math.ceil(n/cols);
    S.gridTemplateColumns=`repeat(${cols},1fr)`;S.gridTemplateRows=`repeat(${rows},1fr)`;return;}
  const m=n-1;
  if(!portrait){
    const cols=m<=3?1:m<=6?2:3,rows=Math.ceil(m/cols);
    S.gridTemplateColumns=`${cols===1?'1fr':'1.25fr'} repeat(${cols},1fr)`;S.gridTemplateRows=`repeat(${rows},1fr)`;
    panes[0].el.style.gridArea=`1 / 1 / ${rows+1} / 2`;
    for(let k=0;k<m;k++)panes[k+1].el.style.gridArea=`${Math.floor(k/cols)+1} / ${k%cols+2}`;
  }else{
    const cols=Math.min(m,2),rows=Math.ceil(m/cols);
    S.gridTemplateColumns=`repeat(${cols},1fr)`;S.gridTemplateRows=`1.3fr repeat(${rows},1fr)`;
    panes[0].el.style.gridArea=`1 / 1 / 2 / ${cols+1}`;
    for(let k=0;k<m;k++)panes[k+1].el.style.gridArea=`${Math.floor(k/cols)+2} / ${k%cols+1}`;
  }
}
new ResizeObserver(()=>{if(VW.set.length>1)gridStage();}).observe($('stage'));

function showSet(set,act=0){
  if(OV&&!OV.keep)ovClear();
  VW.set=set;layoutStage();VW.active=Math.max(0,Math.min(act,set.length-1));
  set.forEach((x,k)=>panes[k].show(x));
  panes.forEach((p,k)=>p.el.classList.toggle('active',set.length>1&&k===VW.active));
  updateBar();
}
/* одинаковые файлы (имя + размер) в разных подпапках — показывать один раз, с пометкой «×N копии» */
function dedupe(set,keep){
  const g=new Map();for(const x of set){const k=x.type+'|'+fname(x.path)+'|'+x.file.size;if(!g.has(k))g.set(k,[]);g.get(k).push(x);}
  const out=[];for(const x of set){const arr=g.get(x.type+'|'+fname(x.path)+'|'+x.file.size);const rep=arr.includes(keep)?keep:arr[0];
    if(!out.includes(rep)){rep.dups=arr.length>1?arr:null;out.push(rep);}}
  return out;
}
function showItem(i){
  if(!view.length)return;VW.cmp=null;
  i=((i%view.length)+view.length)%view.length;VW.idx=i;
  const it=view[i];
  markCurrent(it);closePairPanel();
  let set;VW.kit=null;VW.monList=null;
  if(monOn()){ // два монитора: основной — всегда один тип (PDF или DXF), второй — другой; шаг — по комплектам
    const kit=setFor(it),mt=SET.monMain,mine=kit.filter(x=>x.type===mt);
    set=mine.length?[mine.includes(it)?it:mine[0]]:[it];
    VW.kit=kit;VW.monList=kit.filter(x=>x.type!==set[0].type);
  }else{set=SET.side?setFor(it):[it];   // setFor уже убирает копии
    if(set.length===1){const c=items.filter(x=>x.type===it.type&&x.file.size===it.file.size&&fname(x.path)===fname(it.path)&&inScope(x));it.dups=c.length>1?c:null;}}
  if(set.length>10){set=set.slice(0,10);if(!set.includes(it))set[9]=it;}
  VW.set=set;layoutStage();
  VW.active=Math.max(0,set.indexOf(it));
  set.forEach((x,k)=>panes[k].show(x));
  panes.forEach((p,k)=>p.el.classList.toggle('active',set.length>1&&k===VW.active));
  updateBar();scheduleHist(it);monSync();
  if(set.length===1)for(const d of [1,-1]){const n=view[(i+d+view.length)%view.length];if(n&&n!==it&&n.type==='dxf')getDoc(n);}
  for(const x of targets(it).slice(0,2))if(x.type==='dxf')getDoc(x);
}
function setActive(p){
  const k=panes.indexOf(p);if(k<0||k>=VW.set.length||k===VW.active)return;
  VW.active=k;panes.forEach((q,i)=>q.el.classList.toggle('active',VW.set.length>1&&i===k));updateBar();
}
const curItem=()=>{const ap=panes[VW.active],v=view[VW.idx];return ap&&ap.it&&VW.set.length&&(VW.set.length>1||!VW.set.includes(v))?ap.it:v;};
function step(d){
  if(!view.length)return;
  if(VW.cmp&&!VW.cmp.manual&&CMP){ // сравнение папок: к следующему файлу, у которого есть версия
    let i=VW.idx;for(let k=0;k<view.length;k++){i=(i+d+view.length)%view.length;const c=CMP.map.get(view[i]);if(c&&c.b){cmpOpen(view[i],c.b);return;}}return;}
  if(VW.idx<0){showItem(d>0?0:view.length-1);return;}
  if(VW.set.length<2&&!(VW.kit&&VW.kit.length>1)){showItem(VW.idx+d);return;}
  const cur=new Set(VW.kit||VW.set);let i=VW.idx;
  for(let k=0;k<view.length;k++){i=(i+d+view.length)%view.length;if(!cur.has(view[i]))break;}
  showItem(i);
}
function cyclePair(d){ // Tab: чертёж → исполнение 1 → исполнение 2 → … → чертёж
  const it=view[VW.idx];if(!it)return;
  const set=setFor(it);if(set.length<2){openPairPanel();return;}
  const k=set.indexOf(it);jumpTo(set[(k+d+set.length)%set.length]);
}
function jumpTo(t){
  if(VW.set.length>1&&VW.set.includes(t)){setActive(panes[VW.set.indexOf(t)]);closePairPanel();return;}
  let i=view.indexOf(t);
  if(i<0){$('filter').value='';$('typeSel').value='';curDir='';renderTree();applyFilter();i=view.indexOf(t);}
  closePairPanel();showItem(i);
}
function updateBar(){
  const cur=curItem(),ap=panes[VW.active],has=!!cur&&VW.set.length>0;
  const cmp=!!VW.cmp&&VW.set.length===2;
  $('vSync').hidden=!(cmp&&VW.set[0].type===VW.set[1].type);$('vSync').classList.toggle('on',SET.sync);
  $('vOv').hidden=!!OV||!(cmp&&VW.set[0].type==='dxf'&&VW.set[1].type==='dxf');$('vOv').classList.toggle('on',!!OV);$('vOv').textContent=OV?(OV.mode==='over'?'Две панели':'Наложение'):'Сравнить контуры';
  $('vWith').hidden=FOLLOW||!(has&&cur&&cur.type==='dxf');
  $('vMon').hidden=FOLLOW||!(MON.win||screen.isExtended);$('vMon').classList.toggle('on',!!MON.win);
  $('vName').textContent=has?(VW.idx>=0?`${VW.idx+1} / ${view.length} · `:'')+cur.path:'';$('vName').title=has?cur.path:'';
  $('vPrev').hidden=$('vNext').hidden=!view.length;
  const anyDxf=VW.set.some((x,k)=>x.type==='dxf'&&panes[k]&&panes[k].doc&&!panes[k].isPdf);
  $('vLw').hidden=!anyDxf;$('vChk').hidden=!anyDxf||!!OV;$('vMeas').hidden=!anyDxf||!!OV;$('measBox').hidden=!MEAS.on||$('vMeas').hidden;$('vLw').title='Толщина линий: '+lineMode()[0]+' (W — по кругу)';$('vLw').classList.toggle('on',SET.lw);
  const anyPdf=VW.set.some((x,k)=>panes[k]&&panes[k].isPdf);$('vCt').hidden=!anyPdf;$('vCtN').textContent='линии '+lvTxt(SET.pdfLv);
  $('vCont').hidden=!(has&&ap&&ap.isPdf&&ap.doc.pdf&&ap.doc.pages>1);$('vCont').classList.toggle('on',!!SET.pdfCont);
  const pg=has&&ap&&ap.isPdf&&ap.doc.pdf&&ap.doc.pages>1;
  $('vPages').hidden=!pg;if(pg)$('vPgNum').textContent=` ${ap.pageNo} / ${ap.doc.pages} `;
  if(!has||VW.set.length>1)$('vPair').hidden=true;else updatePairBtn(cur);
  if(cmp)$('vName').textContent='Сравнение: '+VW.set[0].name+'  ⇆  '+(VW.set[1].cmpB?'«'+VW.set[1].rootName+'» ':'')+VW.set[1].name;
  $('vPairMenu').hidden=!has;
  $('vPin').hidden=!(has&&cur.rid);
  $('vSide').classList.toggle('on',SET.side);
  const dx=has&&ap&&ap.doc&&!ap.isPdf&&ap.doc.bbox;$('vXf').hidden=!(dx||(has&&ap&&ap.isPdf&&ap.doc&&ap.doc.pdf));$('vMir').hidden=$('vMirV').hidden=!dx;$('vXfSave').parentNode.hidden=!dx;if(!dx)$('xfMenu').hidden=true;else if(!$('xfMenu').hidden)xfMenuFill();
  const sug=has&&ap&&ap.isPdf&&ap.sugRot!=null&&ap.sugRot!==(ap.prot||0);$('vPdfRot').hidden=!sug;
  if(sug)$('vPdfRot').title='Текст на листе лежит боком — повернуть лист на '+(((ap.sugRot-(ap.prot||0))%360+360)%360)+'° по часовой (запомнится для этого файла)';
  $('vFitW').hidden=!has;
  for(const g of document.querySelectorAll('.vbar .vgrp'))g.hidden=[...g.children].every(c=>c.hidden);   // пустые группы не занимают места
  $('vDims').textContent=has&&ap?ap.dims():'';
  $('vWarn').hidden=!(has&&cur.issues);if(has)$('vWarn').textContent=`⚠ замечаний: ${cur.issues}`;
  if(FOLLOW)followerBar();
  else if(monOn()&&has){const b=$('vPair');b.hidden=false;b.classList.remove('none');b.textContent='⇄ поменять';
    b.title='Основной: '+(SET.monMain==='pdf'?'PDF':'DXF')+', второй: '+(SET.monMain==='pdf'?'DXF':'PDF')+' — поменять местами';}
}

/* ---------- Сетка / Проводник / весь экран ---------- */
let ignorePop=false;
function placeViewer(){
  const d=!FOLLOW&&docked(),v=$('viewer');
  document.body.classList.toggle('explorer',d);document.body.classList.toggle('gridprev',d&&SET.layout!=='list');
  $('grid').classList.toggle('list',SET.layout==='list');
  $('dock').hidden=!d;$('split').hidden=!d;applyCaps();
  if(d){if(v.parentNode!==$('dock'))$('dock').appendChild(v);v.hidden=false;}
  else{if(v.parentNode!==document.body)document.body.insertBefore(v,$('pairPanel'));v.hidden=!VW.full&&!FOLLOW;}
  v.classList.toggle('full',VW.full||!d);
  $('vClose').hidden=d;
  $('vFull').hidden=!d;$('vFull').textContent=VW.full?'🗗':'⛶';$('vFull').title=VW.full?'Вернуть в окно (Esc)':'На весь экран (Enter, двойной клик по файлу)';
  $('btnGrid').classList.toggle('on',SET.layout!=='list');$('btnList').classList.toggle('on',SET.layout==='list');$('btnPreview').classList.toggle('on',SET.preview);
  layoutStage();
}
function setFull(on,fromPop){
  if(FOLLOW||on===VW.full)return;
  if(!on&&!docked())loupeOff();
  if(!on&&!docked()&&SET.mkeep!=='proj'){MEAS.store.clear();for(const p of panes)p.ms=null;}   // вышли из просмотра — размеры забываются (кроме «пока открыт проект»)
  VW.full=on;
  if(on){try{history.pushState({dxfv:1},'');}catch(e){}}
  else if(!fromPop&&history.state&&history.state.dxfv){ignorePop=true;history.back();}
  if(!on&&!docked()){closePairPanel();for(const p of panes)p.clear();VW.set=[];}
  placeViewer();
  if(!on){markCurrent(view[VW.idx]);setTimeout(pumpThumbs,0);}
}
window.addEventListener('popstate',()=>{if(ignorePop){ignorePop=false;return;}if(VW.full)setFull(false,true);});
window.addEventListener('resize',()=>{if(document.body.classList.contains('explorer')!==docked()){placeViewer();if(docked()&&VW.idx>=0&&!VW.set.length)showItem(VW.idx);}});
const setLayout=l=>{if(SET.layout===l)return;SET.layout=l;saveSet();placeViewer();markCurrent(view[VW.idx]);};
$('btnGrid').onclick=()=>setLayout('grid');$('btnList').onclick=()=>setLayout('list');
$('btnPreview').onclick=()=>{
  if(VW.full)setFull(false);
  SET.preview=!SET.preview;saveSet();
  if(!docked()){for(const p of panes)p.clear();VW.set=[];}
  placeViewer();
  if(docked()&&VW.idx>=0)showItem(VW.idx);
};
(()=>{const sp=$('split');let x0=0,w0=0;
  const gp=()=>document.body.classList.contains('gridprev');
  sp.addEventListener('pointerdown',e=>{sp.setPointerCapture(e.pointerId);x0=e.clientX;w0=(gp()?$('dock'):$('gridWrap')).getBoundingClientRect().width;sp.classList.add('drag');});
  sp.addEventListener('pointermove',e=>{if(!sp.hasPointerCapture(e.pointerId))return;
    if(gp()){SET.prevW=Math.round(Math.min(Math.max(w0-(e.clientX-x0),260),innerWidth-320));document.documentElement.style.setProperty('--prevw',SET.prevW+'px');}
    else{SET.listW=Math.round(Math.min(Math.max(w0+e.clientX-x0,220),innerWidth-320));document.documentElement.style.setProperty('--listw',SET.listW+'px');}});
  sp.addEventListener('pointerup',()=>{sp.classList.remove('drag');saveSet();});
})();

$('vClose').onclick=()=>setFull(false);
$('vFull').onclick=()=>setFull(!VW.full);
$('vPrev').onclick=()=>step(-1);
$('vNext').onclick=()=>step(1);
$('vFit').onclick=()=>{for(let k=0;k<VW.set.length;k++)panes[k].fit();};
$('vSide').onclick=()=>{if(FOLLOW)return;SET.side=!SET.side;saveSet();if(VW.idx>=0)showItem(VW.idx);else updateBar();};
$('vPair').onclick=()=>{if(FOLLOW)followerSend({t:'swap'});else if(monOn())monSwap();else cyclePair(1);};
$('vSync').onclick=()=>{SET.sync=!SET.sync;saveSet();updateBar();if(SET.sync){const p=panes[VW.active];p&&p.changed();}};
$('vMon').onclick=()=>openSecond();
$('vPgPrev').onclick=()=>{const p=panes[VW.active];p&&p.pageGo(-1);};
$('vPgNext').onclick=()=>{const p=panes[VW.active];p&&p.pageGo(1);};
const apDo=f=>{const p=panes[VW.active];if(p&&VW.set.length)f(p);};
$('vRotL').onclick=()=>apDo(p=>p.rotate(90));
$('vRotR').onclick=()=>apDo(p=>p.rotate(-90));
$('vMir').onclick=()=>apDo(p=>p.mirror());$('vMirV').onclick=()=>apDo(p=>p.mirrorV());
$('vLw').onclick=()=>cycleLineK();
$('vCtM').onclick=()=>setContrast(SET.pdfLv-1);$('vCtP').onclick=()=>setContrast(SET.pdfLv+1);
$('vCont').onclick=()=>{$('sPdfCont').value=SET.pdfCont?'0':'1';$('sPdfCont').onchange({target:$('sPdfCont')});updateBar();flash(SET.pdfCont?'PDF: все страницы подряд':'PDF: по одной странице');};
$('vWarn').onclick=()=>{const it=curItem();if(it)openLog(it.path);};

/* =====================================================================
   ПАРЫ чертёж PDF ⇄ развёртки DXF
   1) Децимальный номер (АБВГ.123456.001, исполнение -01): один чертёж — все его исполнения.
   2) Иначе — по началу имени (обозначение с цифрами до пробела / до хвоста -материал-толщина-kN).
   3) Ручные связи — важнее автоподбора.
   ===================================================================== */
const baseName=p=>p.replace(/\.(dxf|pdf)$/i,'').toLowerCase();
/* Латинские буквы-двойники → кириллица, все виды тире → «-», ё → е, і/ї/є → и/и/е (для сравнения имён) */
const HOMO={a:'а',b:'в',c:'с',e:'е',h:'н',k:'к',m:'м',o:'о',p:'р',t:'т',x:'х',y:'у',i:'и',ё:'е',і:'и',ї:'и',є:'е',ґ:'г',й:'и'};
const nrmChars=s=>s.toLowerCase().replace(/[‐-―−­]/g,'-').replace(/[abcehkmoptxyiёіїєґй]/g,ch=>HOMO[ch]);
const nrm=p=>nrmChars(baseName(p.split(/[\\/]/).pop())).replace(/_/g,' ').replace(/\s+/g,' ').trim();
const dirOf=p=>p.toLowerCase().split(/[\\/]/).slice(0,-1).join('/');
const fname=p=>p.split(/[\\/]/).pop().toLowerCase();
const DEC=/(?:([a-zа-яёіїєґ]{2,6}\d?)\.)?(?<!\d)(\d{6})\.(\d{3})(?!\d)(?:-(\d{2,3})(?=$|[\s.,_-]))?/i;
/* Ручная связь: {dxf,pdf — имена; dd,pd — папки; ds,ps — размеры}.
   'folder' (по умолчанию): действует только в той же папке; 'size': в любой папке при совпадении имени и размера. */
let LINKS=[],LINK_MODE='folder';
try{const v=JSON.parse(localStorage.getItem('dxfv.links2')||'[]');if(Array.isArray(v))LINKS=v;LINK_MODE=localStorage.getItem('dxfv.linkMode')||'folder';}catch(e){}
function saveLinks(){try{localStorage.setItem('dxfv.links2',JSON.stringify(LINKS));localStorage.setItem('dxfv.linkMode',LINK_MODE);}catch(e){}pairMap=null;}
const sameDir=(a,b)=>a===b||(!!a&&!!b&&(a.endsWith('/'+b)||b.endsWith('/'+a)));
function linkApplies(l,d){if(l.dxf!==fname(d.path))return false;return LINK_MODE==='size'?l.ds===d.file.size:sameDir(l.dd,dirOf(d.path));}
function linkFor(d){let hit=null;for(const l of LINKS)if(linkApplies(l,d))hit=l;return hit;}
function linkPdfOk(l,p){return fname(p.path)===l.pdf&&(LINK_MODE==='size'?p.file.size===l.ps:sameDir(l.pd,dirOf(p.path)));}
function setLink(d,p){
  LINKS=LINKS.filter(l=>!linkApplies(l,d));
  LINKS.push({dxf:fname(d.path),pdf:p?fname(p.path):'',dd:dirOf(d.path),pd:p?dirOf(p.path):'',ds:d.file.size,ps:p?p.file.size:0});
  saveLinks();
}
function clearLink(d){LINKS=LINKS.filter(l=>!linkApplies(l,d));saveLinks();}
function tri(s){s=s.replace(/\s/g,'');const t=new Set();for(let i=0;i<s.length-2;i++)t.add(s.substr(i,3));return t;}
function pkeys(it){
  if(it.pk)return it.pk;
  const b=nrm(it.path),bs=it.type==='dxf'?b.replace(/[-_ ](form|flat|развертка|розгортка)$/,''):b;let desig=bs;  // Inventor добавляет «-form»
  if(it.type==='dxf'){const m=/^(.*)-([^-]+)-(\d+(?:[.,]\d+)?)-[kк]\d+$/.exec(bs);if(m)desig=m[1];}
  const d=DEC.exec(desig);
  return it.pk={b,bs,desig,dec:d?d[2]+'.'+d[3]:null,exec:d&&d[4]?d[4]:'',tri:tri(b)};
}
function pairScore(pdf,dxf){
  const P=pkeys(pdf),D=pkeys(dxf);let sc=0;
  if(P.dec&&D.dec){if(P.dec!==D.dec)return 0;sc=900+(P.exec===D.exec?50:!P.exec?30:0);}
  else if(P.b===D.b)sc=1000;
  else{
    const pk=P.b.split(' ')[0],db=D.bs;
    if(pk.length>=3&&/\d/.test(pk)){
      if(db===pk)sc=900;
      else if(db.startsWith(pk+'-')){const rem=db.slice(pk.length+1);
        sc=(/^[^-]+-\d+(?:[.,]\d+)?-[kк]\d+$/.test(rem)?800:/-[kк]\d+$/.test(rem)?600:300)+pk.length;}
      else if(db.startsWith(pk+' '))sc=300+pk.length;
    }
  }
  if(sc&&dirOf(pdf.path)===dirOf(dxf.path))sc+=20;
  return sc;
}
function similarity(a,b){const A=pkeys(a).tri,B=pkeys(b).tri;let n=0;for(const t of A)if(B.has(t))n++;return n/(A.size+B.size-n||1);}
let pairMap=null;
function buildPairs(){
  const pdfs=items.filter(x=>x.type==='pdf'),dxfs=items.filter(x=>x.type==='dxf');
  const toPdf=new Map(),toDxf=new Map(pdfs.map(p=>[p,[]]));
  for(const d of dxfs){
    const l=linkFor(d);let best=null,man=false;
    if(l&&l.pdf==='')man=true;
    else if(l){const dd=dirOf(d.path);let bp=null,bc=-1;
      for(const x of pdfs){if(!linkPdfOk(l,x))continue;const pd=dirOf(x.path);let c=0;while(c<pd.length&&c<dd.length&&pd[c]===dd[c])c++;if(c>bc){bc=c;bp=x;}}
      if(bp){best=bp;man=true;}}
    if(!man){let bs=0;for(const p of pdfs){const sc=pairScore(p,d);if(sc>bs){bs=sc;best=p;}}}
    if(best){toPdf.set(d,{pdf:best,man});toDxf.get(best).push(d);}
  }
  const nat=(a,b)=>pkeys(a).desig.localeCompare(pkeys(b).desig,'ru',{numeric:true})||a.path.localeCompare(b.path,'ru',{numeric:true});
  for(const arr of toDxf.values())arr.sort(nat);   // сначала основная деталь, потом -01, -02 …
  pairMap={toPdf,toDxf};
}
const inScope=x=>SET.pairScope==='all'||!curDir||x.path.startsWith(curDir+'/');
function targets(it){
  if(!it)return [];if(!pairMap)buildPairs();
  if(it.type==='dxf'){const r=pairMap.toPdf.get(it);return r&&inScope(r.pdf)?[r.pdf]:[];}
  return (pairMap.toDxf.get(it)||[]).filter(inScope);
}
const isManual=dxf=>{if(!pairMap)buildPairs();const r=pairMap.toPdf.get(dxf);return !!(r&&r.man);};
function updatePairBtn(it){
  const set=setFor(it),b=$('vPair');b.hidden=false;
  if(set.length<2){b.textContent='⇄ связать';b.title='Пара не найдена — выбрать вручную';b.classList.add('none');return;}
  const k=set.indexOf(it),nx=set[(k+1)%set.length];
  b.classList.remove('none');
  b.textContent='⇄ '+nx.type.toUpperCase()+(set.length>2?`  ${k+1}/${set.length}`:'');
  b.title='Далее: '+nx.name+' (Tab; назад — Shift+Tab)';
}
function openPairPanel(){$('setPanel').hidden=true;$('pairPanel').hidden=false;$('ppSearch').value='';renderPairPanel();}
function closePairPanel(){$('pairPanel').hidden=true;}
function afterLinkChange(){const keep=!$('pairPanel').hidden;if(VW.idx>=0)showItem(VW.idx);if(keep)openPairPanel();}
function renderPairPanel(){
  const it=curItem();if(!it){closePairPanel();return;}
  const t=targets(it),isPdf=it.type==='pdf';
  $('ppTitle').textContent=isPdf?'Развёртки DXF по чертежу':'Чертёж PDF для развёртки';
  const L=$('ppLinked');L.textContent='';
  for(const x of t){const dxf=isPdf?x:it;
    const r=document.createElement('div');r.className='pp-row';
    const a=document.createElement('span');a.className='pp-name';a.textContent=x.name;a.title=x.path;a.onclick=()=>jumpTo(x);
    const tg=document.createElement('span');tg.className='pp-tag';tg.textContent=isManual(dxf)?'вручную':'авто';
    const u=document.createElement('button');u.textContent='отвязать';u.title='Убрать эту связь';u.onclick=()=>{setLink(dxf,null);afterLinkChange();};
    r.append(a,tg,u);L.appendChild(r);}
  if(!t.length){const d=document.createElement('div');d.className='pp-empty';d.textContent='Пара не найдена — выберите вручную ниже.';L.appendChild(d);}
  const rs=$('ppReset');rs.hidden=!(isPdf?t.some(x=>linkFor(x)):linkFor(it));
  rs.onclick=()=>{if(isPdf){for(const x of t)if(linkFor(x))clearLink(x);}else clearLink(it);afterLinkChange();};
  $('ppMode').value=LINK_MODE;
  const q=$('ppSearch').value.trim().toLowerCase();
  const cand=items.filter(x=>x.type!==it.type&&!t.includes(x)&&(!q||x.path.toLowerCase().includes(q)))
    .map(x=>[x,similarity(it,x)]).sort((a,b)=>b[1]-a[1]).slice(0,40);
  const C=$('ppList');C.textContent='';
  for(const [x] of cand){
    const r=document.createElement('div');r.className='pp-row pp-c';r.title=x.path;
    r.textContent=x.name+(dirOf(x.path)!==dirOf(it.path)?'  ·  '+dirOf(x.path):'');
    r.onclick=()=>{if(isPdf)setLink(x,it);else setLink(it,x);jumpTo(x);};
    C.appendChild(r);
  }
  if(!cand.length)C.innerHTML='<div class="pp-empty">Нет файлов '+(isPdf?'DXF':'PDF')+(q?' по запросу':'')+'</div>';
}
$('ppSearch').addEventListener('input',renderPairPanel);
$('ppMode').addEventListener('change',e=>{LINK_MODE=e.target.value;saveLinks();afterLinkChange();});
$('ppClose').onclick=closePairPanel;
$('vPairMenu').onclick=()=>{$('pairPanel').hidden?openPairPanel():closePairPanel();};

/* =====================================================================
   ДЕРЕВО ПАПОК изделия: выбор узла показывает его файлы вместе с вложенными папками
   ===================================================================== */
let curDir='',treeInit=true,TREE_ROOT=null,NODES=new Map();const treeOpen=new Set();
const RST=LS.get('rootState',{});let rstT=0;
function saveRootState(){
  const rid=items.length&&items[0].rid;if(!rid)return;clearTimeout(rstT);
  rstT=setTimeout(()=>{RST[rid]={open:[...treeOpen],dir:curDir,type:$('typeSel').value,t:Date.now()};
    const ks=Object.keys(RST);if(ks.length>150)ks.sort((a,b)=>RST[a].t-RST[b].t).slice(0,ks.length-150).forEach(k=>delete RST[k]);
    LS.set('rootState',RST);},300);
}
const descend=(n,out=[])=>{for(const k of n.kids.values()){out.push(k.path);descend(k,out);}return out;};
function buildTree(){
  const root={name:'',path:'',kids:new Map(),n:0};
  for(const it of items){
    const parts=it.path.split('/');parts.pop();let node=root,p='';root.n++;
    for(const part of parts){p=p?p+'/'+part:part;let k=node.kids.get(part);if(!k){k={name:part,path:p,kids:new Map(),n:0};node.kids.set(part,k);}k.n++;node=k;}
  }
  return root;
}
const has0=(n,isAll)=>n.kids.size>0&&!isAll;
const byName=(a,b)=>a.name.localeCompare(b.name,'ru',{numeric:true,sensitivity:'base'});
function renderTree(){
  const hasSub=items.some(it=>it.path.split('/').length>2);
  $('btnTree').hidden=!hasSub;$('btnTree').classList.toggle('on',hasSub&&SET.tree);
  const show=hasSub&&SET.tree&&(innerWidth>=760||treeMobile);
  $('tree').hidden=!show;$('split2').hidden=!(show&&innerWidth>=760);
  HASSUB=hasSub;$('btnBrowse').hidden=!hasSub;
  if(!hasSub){TREE_ROOT=null;NODES=new Map();return;}
  let root=buildTree();
  if(root.kids.size===1)root=[...root.kids.values()][0];          // одна папка изделия — она и есть корень
  TREE_ROOT=root;NODES=new Map();(function idx(n){NODES.set(n.path,n);for(const k of n.kids.values())idx(k);})(root);
  const selNode=curDir&&curDir!==root.path&&NODES.get(curDir);
  $('treeExpand').title=selNode?'Развернуть все вложенные папки «'+selNode.name+'»':'Развернуть все папки';
  $('treeFold').title=selNode?'Свернуть «'+selNode.name+'» со всеми вложенными':'Свернуть все папки';
  if(treeInit){treeInit=false;treeOpen.add(root.path);for(const k of root.kids.values())treeOpen.add(k.path);}
  const T=$('treeBody');T.textContent='';
  const row=(node,depth,isAll)=>{
    const r=document.createElement('div');r.className='tr'+(isAll?' all':'')+((isAll?curDir===''||curDir===root.path:curDir===node.path)?' sel':'');
    r.style.paddingLeft=(4+depth*14)+'px';r.title=node.path||'Все файлы';r._dir=isAll?'':node.path;r._has=has0(node,isAll);r._open=treeOpen.has(node.path);
    const has=node.kids.size>0&&!isAll,open=treeOpen.has(node.path);
    r.innerHTML='<span class="cr"></span><span class="tn"></span><span class="tc"></span>';
    r.children[0].textContent=has?(open?'▾':'▸'):'';
    r.children[1].textContent=isAll?(root.name||'Все файлы'):node.name;
    r.children[2].textContent=node.n;
    r.children[0].onclick=e=>{if(!has)return;e.stopPropagation();open?treeOpen.delete(node.path):treeOpen.add(node.path);renderTree();};
    r.onclick=()=>{KB.zone='tree';setDir(isAll?'':node.path);if(innerWidth<760){treeMobile=false;renderTree();}};
    r.ondblclick=()=>{if(has){open?treeOpen.delete(node.path):treeOpen.add(node.path);renderTree();}};
    T.appendChild(r);
    if(has&&open)for(const k of [...node.kids.values()].sort(byName))row(k,depth+1,false);
  };
  row(root,0,true);
  for(const k of [...root.kids.values()].sort(byName))row(k,1,false);
  saveRootState();
}
function setDir(d){
  curDir=d;for(let p=d;p;p=p.includes('/')?p.slice(0,p.lastIndexOf('/')):'')treeOpen.add(p);
  renderTree();applyFilter();$('gridWrap').scrollTop=0;
  if(docked()&&view.length&&VW.idx<0)showItem(0);
  const sel=$('treeBody').querySelector('.tr.sel');if(sel)sel.scrollIntoView({block:'nearest'});
  kbZone();
}
/* клавиатура: зона «дерево» или «файлы» */
const KB={zone:'files'};
function kbZone(z){if(z)KB.zone=z;if(KB.zone==='tree'&&$('tree').hidden)KB.zone='files';document.body.classList.toggle('kbtree',KB.zone==='tree');}
function treeRows(){return [...$('treeBody').querySelectorAll('.tr')];}
function treeKey(k){
  const rows=treeRows();if(!rows.length){kbZone('files');return false;}
  let i=rows.findIndex(r=>r.classList.contains('sel'));if(i<0)i=0;const r=rows[i];
  const go=j=>{j=Math.max(0,Math.min(rows.length-1,j));if(j!==i||!r.classList.contains('sel'))setDir(rows[j]._dir);};
  if(k==='ArrowDown')go(i+1);else if(k==='ArrowUp')go(i-1);
  else if(k==='Home')go(0);else if(k==='End')go(rows.length-1);
  else if(k==='PageDown')go(i+10);else if(k==='PageUp')go(i-10);
  else if(k==='ArrowLeft'){if(r._has&&r._open){treeOpen.delete(r._dir);renderTree();}else{const pd=parentDir(curDir);if(pd!==null)setDir(pd);}}
  else if(k==='Backspace'){const pd=parentDir(curDir);if(pd!==null)setDir(pd);}
  else if(k==='ArrowRight'){if(r._has&&!r._open){treeOpen.add(r._dir);renderTree();}else toFiles();}
  else if(k==='Enter'||k==='Escape'||k==='Tab')toFiles();
  else return false;
  return true;
}
function toFiles(){kbZone('files');const ts=gridTiles();
  if(viewerShown()){if(view.length&&VW.idx<0)showItem(0);return;}
  const c=$('grid').querySelector('.tile.cur')||ts.find(t=>t._it)||ts[0];kbMark(c||null);}
function toTree(){if($('tree').hidden)return false;kbZone('tree');const s=$('treeBody').querySelector('.tr.sel');if(s)s.scrollIntoView({block:'nearest'});return true;}
$('grid').addEventListener('pointerdown',()=>kbZone('files'));
let treeMobile=false;
$('btnTree').onclick=()=>{if(innerWidth<760){treeMobile=!treeMobile;SET.tree=true;}else SET.tree=!SET.tree;saveSet();renderTree();};
$('treeHide').onclick=()=>{if(innerWidth<760)treeMobile=false;else{SET.tree=false;saveSet();}renderTree();};
$('treeExpand').onclick=()=>{if(!TREE_ROOT)return;const n=(curDir&&NODES.get(curDir))||TREE_ROOT;treeOpen.add(n.path);for(const p of descend(n))treeOpen.add(p);renderTree();};
$('treeFold').onclick=()=>{if(!TREE_ROOT)return;const n=curDir&&curDir!==TREE_ROOT.path&&NODES.get(curDir);
  if(n){treeOpen.delete(n.path);for(const p of descend(n))treeOpen.delete(p);}else treeOpen.clear();renderTree();};
(()=>{const sp=$('split2');let x0=0,w0=0;
  sp.addEventListener('pointerdown',e=>{sp.setPointerCapture(e.pointerId);x0=e.clientX;w0=$('tree').getBoundingClientRect().width;sp.classList.add('drag');});
  sp.addEventListener('pointermove',e=>{if(!sp.hasPointerCapture(e.pointerId))return;
    SET.treeW=Math.round(Math.min(Math.max(w0+e.clientX-x0,150),Math.min(700,innerWidth-300)));document.documentElement.style.setProperty('--treew',SET.treeW+'px');});
  sp.addEventListener('pointerup',()=>{sp.classList.remove('drag');saveSet();});
})();
window.addEventListener('resize',()=>renderTree());

/* =====================================================================
   ИСТОРИЯ просмотров
   Запись: {t, kind:'file'|'folder', name, path, type, root (id сохранённого доступа), rootName}.
   Повторное открытие — через сохранённый доступ к папке/файлу (ПК Chrome).
   ===================================================================== */
let HIST=[],HLIST=[],histSaveT=0,histT=0;
function histDel(arr){const del=new Set(arr);HIST=HIST.filter(x=>!del.has(x));IDB.put('all',HIST,'hist');renderHist();}
const dayStart=t=>{const d=new Date(t);d.setHours(0,0,0,0);return d.getTime();};
async function histLoad(){
  const v=await IDB.get('all','hist');if(Array.isArray(v))HIST=v;
  try{const used=new Set([...HIST.map(e=>e.root),...PINS.map(p=>p.root)].filter(Boolean));
    for(const r of (await IDB.all('roots'))||[])if(!used.has(r.id)&&Date.now()-r.t>DAY)IDB.del(r.id,'roots');}catch(e){}
}
function histSave(){clearTimeout(histSaveT);histSaveT=setTimeout(()=>IDB.put('all',HIST,'hist'),500);}
function histPush(e){
  const ds=dayStart(e.t);
  HIST=HIST.filter(x=>!(x.kind===e.kind&&x.path===e.path&&x.rootName===e.rootName&&(x.root||null)===(e.root||null)&&dayStart(x.t)===ds));
  HIST.unshift(e);if(HIST.length>3000)HIST.length=3000;histSave();
  if(!$('histPanel').hidden)renderHist();
}
function scheduleHist(it){if(FOLLOW)return;clearTimeout(histT);histT=setTimeout(()=>{if(VW.set.includes(it)&&viewerShown())
  histPush({t:Date.now(),kind:'file',name:it.name,path:it.path,type:it.type,root:it.rid||null,rootName:it.rootName||''});},1500);}
function histAddFolder(rid,name,count){if(name)histPush({t:Date.now(),kind:'folder',name,path:'',type:'',root:rid,rootName:name,count});}
const dayLabel=ds=>{const t=dayStart(Date.now());if(ds===t)return 'Сегодня';if(ds===t-DAY)return 'Вчера';
  return new Date(ds).toLocaleDateString('ru',{weekday:'short',day:'numeric',month:'long'});};
/* «Группой»: проект (открытая папка) → вложенные папки → просмотренные файлы */
const hOpen=new Set();let hOpenAuto=true;
const hTime=t=>dayStart(t)===dayStart(Date.now())?new Date(t).toLocaleTimeString('ru',{hour:'2-digit',minute:'2-digit'})
  :new Date(t).toLocaleString('ru',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
function renderHistGroup(from,q){
  const ents=HIST.filter(e=>e.t>=from&&(!q||(e.name+' '+e.path+' '+e.rootName).toLowerCase().includes(q)));
  HLIST=ents;
  const projs=new Map();
  const node=(name,path,e)=>({name,path,root:e.root,rootName:e.rootName,kids:new Map(),files:[],t:0,src:[]});
  for(const e of ents){
    const pk=(e.root||'')+'|'+(e.rootName||'');
    let P=projs.get(pk);if(!P){P=node(e.rootName||'Отдельные файлы',e.rootName||'',e);P.key=pk;P.count=0;projs.set(pk,P);}
    P.src.push(e);if(e.t>P.t)P.t=e.t;if(e.kind==='folder')P.count=Math.max(P.count,e.count||0);
    if(e.kind!=='file')continue;
    const parts=e.path.split('/');parts.pop();let n=P,p=parts[0]||'';
    for(const seg of (e.rootName?parts.slice(1):parts)){p=p?p+'/'+seg:seg;let k=n.kids.get(seg);if(!k){k=node(seg,p,e);n.kids.set(seg,k);}n=k;n.src.push(e);if(e.t>n.t)n.t=e.t;}
    let f=n.files.find(x=>x.path===e.path);if(!f){f=Object.assign({},e,{src:[]});n.files.push(f);}f.src.push(e);if(e.t>f.t)f.t=e.t;
  }
  const cnt=n=>n.files.length+[...n.kids.values()].reduce((a,k)=>a+cnt(k),0);
  const list=[...projs.values()].sort((a,b)=>b.t-a.t);
  if(hOpenAuto&&list.length){hOpenAuto=false;let n=list[0],k='P'+n.key;hOpen.add(k); // свежий проект раскрыт до последнего файла
    for(;;){const kids=[...n.kids.values()];if(!kids.length)break;n=kids.sort((a,b)=>b.t-a.t)[0];k+='/'+n.name;hOpen.add(k);}}
  const B=$('hBody');B.textContent='';
  const btn=(t,title,fn)=>{const b=document.createElement('button');b.textContent=t;b.title=title;b.onclick=ev=>{ev.stopPropagation();fn();};return b;};
  const row=(depth,cls,caret,name,meta,onclick)=>{const r=document.createElement('div');r.className='hg '+cls;r.style.paddingLeft=(6+depth*18)+'px';
    r.innerHTML='<span class="cr"></span><span class="hn"></span><span class="hm"></span>';r.children[0].textContent=caret;r.children[1].textContent=name;r.children[2].textContent=meta;
    r.onclick=onclick;B.appendChild(r);return r;};
  const draw=(n,depth,key,isProj)=>{
    const open=!!q||hOpen.has(key),has=n.kids.size||n.files.length,c=cnt(n);
    const r=row(depth,'fold'+(isProj?' proj':'')+(n.root&&FSA?'':' h-off'),has?(open?'▾':'▸'):'',n.name,
      (isProj&&n.count?n.count+' в папке · ':'')+(c?'смотрели '+c+' · ':'')+hTime(n.t),()=>{open?hOpen.delete(key):hOpen.add(key);renderHist();});
    if(n.root&&FSA){r.appendChild(btn('открыть','Открыть эту папку',()=>histOpen({kind:'folder',dir:n.path,root:n.root,rootName:n.rootName,name:n.name})));
      r.appendChild(btn('★','Добавить в ярлыки',()=>pinAdd({kind:'folder',root:n.root,rootName:n.rootName,dir:n.path,label:n.name})));}
    r.appendChild(btn('✕','Удалить из истории всё, что внутри',()=>histDel(n.src)));
    if(!open)return;
    for(const k of [...n.kids.values()].sort(byName))draw(k,depth+1,key+'/'+k.name,false);
    for(const f of n.files.sort((a,b)=>b.t-a.t)){
      const fr=row(depth+1,'file'+(f.type==='pdf'?' h-pdf':'')+(f.root&&FSA?'':' h-off'),'',f.name,hTime(f.t),()=>histOpen(f));
      fr.children[1].classList.add('h-n');
      if(f.root&&FSA)fr.appendChild(btn('★','Добавить в ярлыки',()=>pinAdd({kind:'file',root:f.root,rootName:f.rootName,path:f.path,label:f.name})));
      fr.appendChild(btn('✕','Удалить из истории',()=>histDel(f.src)));
    }
  };
  for(const P of list)draw(P,0,'P'+P.key,true);
  if(!list.length)B.innerHTML='<p class="pp-empty">За выбранный период ничего нет.</p>';
}
function renderHist(){
  const per=+$('hPeriod').value,kind=$('hKind').value,q=$('hSearch').value.trim().toLowerCase();
  const from=per?dayStart(Date.now())-(per-1)*DAY:0;
  const grp=$('hView').value==='group';$('hKind').hidden=grp;
  if(grp){renderHistGroup(from,q);histFoot();return;}
  let list;
  if(kind==='folder'){
    /* папки: открытые целиком + вложенные папки, в которых смотрели файлы (по одной строке на папку за день) */
    const m=new Map();
    for(const e of HIST){if(e.t<from)continue;
      const dir=e.kind==='file'?e.path.split('/').slice(0,-1).join('/'):e.rootName;if(!dir)continue;
      const k=dayStart(e.t)+'|'+(e.root||'')+'|'+dir;let f=m.get(k);
      if(!f){f={t:e.t,kind:'folder',dir,root:e.root,rootName:e.rootName,name:dir.split('/').pop(),path:dir,seen:0,count:0,isRoot:false,src:[]};m.set(k,f);}
      f.src.push(e);
      if(e.kind==='file'){f.seen++;}else{f.isRoot=true;f.count=e.count||0;}
      if(e.t>f.t)f.t=e.t;}
    list=[...m.values()].sort((a,b)=>b.t-a.t);
  }else list=HIST.filter(e=>e.kind==='file'&&e.t>=from);
  if(q)list=list.filter(e=>(e.name+' '+e.path+' '+e.rootName).toLowerCase().includes(q));
  HLIST=list;
  const B=$('hBody');B.textContent='';let last=null;
  for(const e of list.slice(0,800)){
    const ds=dayStart(e.t);
    if(ds!==last){last=ds;const h=document.createElement('div');h.className='h-day';h.textContent=dayLabel(ds);B.appendChild(h);}
    const r=document.createElement('div');r.className='h-row'+(e.root&&FSA?'':' h-off')+(e.type==='pdf'?' h-pdf':'');
    r.innerHTML='<span class="h-t"></span><span class="h-n"></span><span class="h-f"></span><button class="h-pin" title="Добавить в ярлыки">★</button><button class="h-del" title="Удалить запись из истории">✕</button>';
    r.children[3].hidden=!(e.root&&FSA);
    r.children[3].onclick=ev=>{ev.stopPropagation();pinAdd(kind==='file'?{kind:'file',root:e.root,rootName:e.rootName,path:e.path,label:e.name}
      :{kind:'folder',root:e.root,rootName:e.rootName,dir:e.dir,label:e.dir.split('/').pop()});};
    r.children[4].onclick=ev=>{ev.stopPropagation();histDel(e.src||[e]);};
    r.children[0].textContent=new Date(e.t).toLocaleTimeString('ru',{hour:'2-digit',minute:'2-digit'});
    if(kind==='file'){r.children[1].textContent=e.name;r.children[2].textContent=e.path.split('/').slice(0,-1).join(' / ');}
    else{r.children[1].textContent=e.dir.split('/').join(' / ');
      r.children[2].textContent=[e.isRoot?'открыта целиком, '+e.count+' файл.':'',e.seen?'просмотрено: '+e.seen:''].filter(Boolean).join(' · ');}
    r.title=e.root&&FSA?'Открыть':'Открывалось без сохранения доступа — откройте заново кнопкой «Папка» или перетаскиванием';
    r.onclick=()=>histOpen(e);
    B.appendChild(r);
  }
  if(!list.length)B.innerHTML='<p class="pp-empty">За выбранный период ничего нет.</p>';
  histFoot();
}
function histFoot(){
  $('hFoot').textContent=FSA?'Из истории открываются папки, выбранные кнопкой «Папка» или перетаскиванием. При первом открытии браузер спросит разрешение на чтение.'
    :'На этом устройстве браузер не позволяет повторно открыть файл из истории — список только для справки.';
}
async function histOpen(e){
  if(!e.root||!FSA){flash('Нет сохранённого доступа — откройте «'+(e.rootName||e.name)+'» заново кнопкой «Папка»');return;}
  const r=await IDB.get(e.root,'roots');if(!r||!r.h){flash('Доступ не сохранился — откройте «'+(e.rootName||e.name)+'» заново');return;}
  try{let p=await r.h.queryPermission({mode:'read'});if(p!=='granted')p=await r.h.requestPermission({mode:'read'});if(p!=='granted')return;}
  catch(err){flash('Нет доступа: '+err.message);return;}
  $('histPanel').hidden=true;
  try{
    if(r.kind==='directory'){
      if(!items.length||items[0].rid!==e.root)await openDirHandle(r.h);
      if(e.kind==='folder'&&e.dir&&e.dir!==e.rootName){ // вложенная папка — показать только её содержимое
        if(!items.some(x=>x.path.startsWith(e.dir+'/'))){flash('Папка «'+e.name+'» не найдена — возможно, переименована');return;}
        $('typeSel').value='';$('filter').value='';setDir(e.dir);if(!SET.tree){SET.tree=true;saveSet();renderTree();}
        return;}
      if(e.kind==='file'){const it=items.find(x=>x.path===e.path);
        if(!it){flash('Файл «'+e.name+'» не найден в папке — возможно, удалён или переименован');return;}
        jumpTo(it);if(!docked())setFull(true);}
    }else{
      const f=await r.h.getFile();setFiles([{file:f,path:f.name,rid:e.root}],{rootName:''});showItem(0);if(!docked())setFull(true);
    }
  }catch(err){flash('Не удалось открыть: '+(err.message||err));}
}
$('btnHist').onclick=()=>{$('hView').value=SET.hView;$('histPanel').hidden=false;hOpenAuto=true;hOpen.clear();renderHist();};
$('hView').addEventListener('change',e=>{SET.hView=e.target.value;saveSet();renderHist();});
$('hClose').onclick=()=>{$('histPanel').hidden=true;};
$('histPanel').addEventListener('click',e=>{if(e.target.id==='histPanel')$('histPanel').hidden=true;});
for(const id of ['hPeriod','hKind'])$(id).addEventListener('change',renderHist);
$('hSearch').addEventListener('input',renderHist);
$('hClear').onclick=()=>{
  const arr=HLIST.flatMap(e=>e.src||[e]);if(!arr.length)return;
  const per=$('hPeriod').selectedOptions[0].textContent.toLowerCase(),q=$('hSearch').value.trim();
  const msg=$('hView').value==='group'?`Удалить из истории ${arr.length} записей (${per}${q?', по запросу «'+q+'»':''})?`:$('hKind').value==='folder'?`Удалить из истории ${HLIST.length} папок (${per}${q?', по запросу «'+q+'»':''}) вместе с просмотренными в них файлами?`
    :`Удалить из истории ${arr.length} файлов (${per}${q?', по запросу «'+q+'»':''})?`;
  if(confirm(msg))histDel(arr);
};
histLoad();

/* ---------- Настройки: тема, фон, подписи, повороты ---------- */
function bgChanged(){colCache.clear();panes.forEach(p=>p.draw());resetThumbs();}
function changeSet(k,v){const ob=bgKey();SET[k]=v;saveSet();applyTheme();if(bgKey()!==ob)bgChanged();}
$('sTheme').value=SET.theme;
$('sTheme').onchange=e=>{changeSet('theme',e.target.value);fillBgSel();};
mqLight.addEventListener('change',()=>{if(SET.theme==='auto'){const ob=bgKey();applyTheme();if(bgKey()!==ob)bgChanged();}});
const BG_PRESETS=[['auto','по теме'],['#000000','чёрный'],['#0f1012','графит'],['#212830','тёмно-синий (AutoCAD)'],['#3a3d42','серый'],['#d4d7dc','светло-серый'],['#ffffff','белый'],['custom','свой цвет…']];
function fillBgSel(){
  for(const [key,sid,cid,cur] of [['bgDxf','sBgDxf','cBgDxf',dxfBg],['bgPdf','sBgPdf','cBgPdf',pdfBg]]){
    const sel=$(sid),col=$(cid),v=SET[key],known=BG_PRESETS.some(p=>p[0]===v);
    if(!sel.options.length)sel.innerHTML=BG_PRESETS.map(([v,t])=>`<option value="${v}">${t}</option>`).join('');
    sel.value=known?v:'custom';col.hidden=known;col.value=cur();
    sel.onchange=()=>{if(sel.value==='custom'){col.hidden=false;col.value=cur();col.click();}else{col.hidden=true;changeSet(key,sel.value);col.value=cur();}};
    col.oninput=()=>changeSet(key,col.value);
  }
  $('sPdfDark').value=SET.pdfDark?'1':'0';$('sPdfBold').value=String(SET.pdfLv);$('sPdfCont').value=SET.pdfCont?'1':'0';$('sReopen').value=SET.reopen?'1':'0';$('sClick').value=SET.click==='1'?'1':'2';$('sCmpGeo').value=SET.cmpGeo===false?'0':'1';$('sDims').value=SET.dims===false?'0':'1';$('sBlink').value=SET.blink?'1':'0';$('sTexts').value=SET.texts?'1':'0';$('sLineK').value=String(SET.lineK);$('sScope').value=SET.pairScope;
}
$('sPdfDark').onchange=e=>changeSet('pdfDark',e.target.value==='1');
$('sPdfBold').onchange=e=>setContrast(+e.target.value,true);
function setContrast(v,quiet){v=Math.max(LV_MIN,Math.min(LV_MAX,v));SET.pdfLv=v;saveSet();$('sPdfBold').value=String(v);$('vCtN').textContent='линии '+lvTxt(v);panes.forEach(p=>p.draw());
  try{MON.win&&MON.win.postMessage({t:'set'},'*');}catch(e){}
  if(!quiet)flash('Линии PDF: '+lvTxt(v)+' — '+PDF_LVN[v]+' (от −2 до +4, клавиши [ и ])');}
$('sPdfCont').onchange=e=>{SET.pdfCont=e.target.value==='1';saveSet();panes.forEach(p=>p.reloadPdf());};
$('sReopen').onchange=e=>{SET.reopen=e.target.value==='1';saveSet();};
$('sClick').onchange=e=>{SET.click=e.target.value;saveSet();};
$('sLoupe').value=['s','m','l'].includes(SET.loupe)?SET.loupe:'m';$('sLoupe').onchange=e=>{SET.loupe=e.target.value;saveSet();};
$('sPngClip').value=SET.pngClip?'1':'0';$('sPngClip').onchange=e=>{SET.pngClip=e.target.value==='1';saveSet();};
$('sDims').onchange=e=>{SET.dims=e.target.value==='1';saveSet();panes.forEach(p=>p.draw());};
$('sCmpGeo').onchange=e=>{SET.cmpGeo=e.target.value==='1';saveSet();};
$('sBlink').onchange=e=>{SET.blink=e.target.value==='1';saveSet();};
$('sLineK').onchange=e=>{SET.lineK=+e.target.value;SET.lw=false;saveSet();panes.forEach(p=>p.draw());updateBar();};
/* линии DXF: тонкие / средние / жирные / по файлу (толщины из файла — только если они там есть) */
const LINEMODES=[['тонкие',false,1],['средние',false,1.6],['жирные',false,2.4],['по файлу',true,1]];
function lineMode(){return SET.lw&&anyLw()?LINEMODES[3]:LINEMODES.find(m=>!m[1]&&m[2]===SET.lineK)||LINEMODES[0];}
function anyLw(){return panes.some(p=>p.doc&&!p.isPdf&&p.doc.hasLw);}
/* =====================================================================
   ИЗМЕРЕНИЯ в DXF (D или «📏 Измерить»).
   Две точки — расстояние, ΔX, ΔY, угол; точки привязываются к концам, серединам и центрам (значок у курсора).
   Клик по линии без привязки — длина; по окружности — Ø и длина; по дуге — R, угол и длина дуги.
   Esc — убрать измерения, ещё раз Esc — выйти. Всё в координатах файла, с учётом поворота детали на экране.
   ===================================================================== */
const MEAS={on:false};
function measEnt(doc){ // элементы и точки привязки детали (один раз на документ)
  if(doc._meas)return doc._meas;const E=[],S=[];
  const arcE=(cx,cy,r,a0,a1,ccw)=>{E.push({t:'A',cx,cy,r,a0,a1,ccw});S.push([cx,cy,'центр']);S.push([cx+r*Math.cos(a0),cy+r*Math.sin(a0),'конец'],[cx+r*Math.cos(a1),cy+r*Math.sin(a1),'конец']);
    let sw=ccw?a1-a0:a0-a1;while(sw<=0)sw+=Math.PI*2;const am=a0+(ccw?1:-1)*sw/2;S.push([cx+r*Math.cos(am),cy+r*Math.sin(am),'середина']);};
  const lineE=(x1,y1,x2,y2)=>{E.push({t:'L',x1,y1,x2,y2});S.push([x1,y1,'конец'],[x2,y2,'конец'],[(x1+x2)/2,(y1+y2)/2,'середина']);};
  for(const G of doc.groups||[]){if(G.off||G.dim)continue;
    for(const p of G.prims){
      if(p[0]==='L')lineE(p[1],p[2],p[3],p[4]);
      else if(p[0]==='C'){E.push({t:'C',cx:p[1],cy:p[2],r:p[3]});S.push([p[1],p[2],'центр']);for(let k=0;k<4;k++)S.push([p[1]+p[3]*Math.cos(k*Math.PI/2),p[2]+p[3]*Math.sin(k*Math.PI/2),'квадрант']);}
      else if(p[0]==='A')arcE(p[1],p[2],p[3],p[4],p[5],true);
      else if(p[0]==='P'){const a=p[2],n=a.length/3,segs=p[1]?n:n-1;
        for(let i=0;i<segs;i++){const j=(i+1)%n,x1=a[i*3],y1=a[i*3+1],x2=a[j*3],y2=a[j*3+1],b=a[i*3+2];
          const A=b?GEO.bulgeArc(x1,y1,x2,y2,b):null;if(A)arcE(A.cx,A.cy,A.r,A.a0,A.a1,A.ccw);else lineE(x1,y1,x2,y2);}}
    }}
  return doc._meas={E,S};
}
const m2s=(p,x,y)=>{const [wx,wy]=mApply(xfMat(p.xf),x,y);return [p.W/2+(wx-p.cx)*p.s,p.H/2-(wy-p.cy)*p.s];};
const s2m=(p,x,y)=>mApply(mInv(xfMat(p.xf)),...p.s2w(x,y));
function onArc(e,x,y){let a=Math.atan2(y-e.cy,x-e.cx),sw=e.ccw?e.a1-e.a0:e.a0-e.a1;while(sw<=0)sw+=Math.PI*2;let t=e.ccw?a-e.a0:e.a0-a;while(t<0)t+=Math.PI*2;return t<=sw+1e-9;}
function entDist(e,x,y){
  if(e.t==='L'){const dx=e.x2-e.x1,dy=e.y2-e.y1,l=dx*dx+dy*dy;let t=l?((x-e.x1)*dx+(y-e.y1)*dy)/l:0;t=Math.max(0,Math.min(1,t));return Math.hypot(x-e.x1-t*dx,y-e.y1-t*dy);}
  const d=Math.abs(Math.hypot(x-e.cx,y-e.cy)-e.r);if(e.t==='C')return d;return onArc(e,x,y)?d:Infinity;
}
function measPickEnt(p,x,y){const M=measEnt(p.doc),[mx,my]=s2m(p,x,y);let be=null,ed=8/p.s;for(const e of M.E){const d=entDist(e,mx,my);if(d<ed){ed=d;be=e;}}return be;}
function measPickLine(p,x,y){const M=measEnt(p.doc),[mx,my]=s2m(p,x,y);let be=null,ed=7/p.s;for(const e of M.E){if(e.t!=='L')continue;const d=entDist(e,mx,my);if(d<ed){ed=d;be=e;}}return be;}
function measPick(p,x,y){ // что под курсором: точка привязки или элемент
  const M=measEnt(p.doc),[mx,my]=s2m(p,x,y),tol=10/p.s;let best=null,bd=tol;
  for(const q of M.S){const d=Math.hypot(q[0]-mx,q[1]-my);if(d<bd||(best&&d<=bd+1e-9&&q[2]==='центр')){bd=d;best=q;}}
  let be=null,ed=7/p.s;for(const e of M.E){const d=entDist(e,mx,my);if(d<ed){ed=d;be=e;}}
  // маленькая дуга или отверстие (меньше ~20 px на экране): клик по ней — радиус / диаметр, а не точка середины или центра
  if(best&&be&&be.t!=='L'&&be.r*p.s<20&&best[2]!=='конец'&&SET.mmode!=='ang')return {ent:be,pt:[mx,my]};
  if(SET.mmode==='gap'&&be)return {ent:be,pt:[mx,my]};   // «зазор» — всегда по элементу, точки привязки не нужны
  if(best)return {snap:best};
  return be?{ent:be,pt:[mx,my]}:{pt:[mx,my]};
}
/* ---------- размеры как в CAD ----------
   1-й и 2-й клик — точки (только с привязкой: конец, середина, центр, квадрант; «в воздухе» точки не ставятся),
   3-й клик — где положить размерную линию. Увели курсор выше/ниже точек — горизонтальный размер,
   левее/правее — вертикальный, между ними — по прямой (вдоль отрезка). Подсказка у курсора показывает и остальные величины.
   Клик по линии, окружности, дуге вне точек привязки — длина / Ø / R.
   Размеры держатся, пока включён режим (для каждого файла свои); Esc отменяет только начатый размер. */
const mDec=()=>{const v=+SET.mprec;return v>=0&&v<=3?v:1;};
const fmm=v=>(Math.round(v*10**mDec())/10**mDec()).toLocaleString('ru-RU',{minimumFractionDigits:mDec(),maximumFractionDigits:mDec()});
MEAS.store=new Map();
function msOf(p){if(!p.ms){p.ms={pts:[],items:p.it&&MEAS.store.get(p.it.key)||[]};if(p.it)MEAS.store.set(p.it.key,p.ms.items);}return p.ms;}
const w2s=(p,wx,wy)=>[p.W/2+(wx-p.cx)*p.s,p.H/2-(wy-p.cy)*p.s];
const m2w=(p,x,y)=>mApply(xfMat(p.xf),x,y);
function linDim(p,a,b,mw){ // какой размер ставить при курсоре mw (в координатах экрана-мира)
  const A=m2w(p,...a),B=m2w(p,...b),x0=Math.min(A[0],B[0]),x1=Math.max(A[0],B[0]),y0=Math.min(A[1],B[1]),y1=Math.max(A[1],B[1]),g=4/p.s;
  if(mw[1]>y1+g||mw[1]<y0-g)return x1-x0>1e-9?'h':'v';
  if(mw[0]>x1+g||mw[0]<x0-g)return y1-y0>1e-9?'v':'h';
  return 'al';
}
function dimGeom(p,it){ // экранная геометрия размера: выносные, размерная линия, место текста, величина
  const A=m2w(p,...it.a),B=m2w(p,...it.b),O=m2w(p,...it.o);let a2,b2,val;
  if(it.dir==='h'){a2=[A[0],O[1]];b2=[B[0],O[1]];val=Math.abs(B[0]-A[0]);}
  else if(it.dir==='v'){a2=[O[0],A[1]];b2=[O[0],B[1]];val=Math.abs(B[1]-A[1]);}
  else{const dx=B[0]-A[0],dy=B[1]-A[1],L=Math.hypot(dx,dy)||1,nx=-dy/L,ny=dx/L,off=(O[0]-A[0])*nx+(O[1]-A[1])*ny;a2=[A[0]+nx*off,A[1]+ny*off];b2=[B[0]+nx*off,B[1]+ny*off];val=L;}
  return {A:w2s(p,...A),B:w2s(p,...B),a2:w2s(p,...a2),b2:w2s(p,...b2),val};
}
function measInfo(it){ // все величины для подсказки
  const dx=Math.abs(it.b[0]-it.a[0]),dy=Math.abs(it.b[1]-it.a[1]);return 'по X '+fmm(dx)+' · по Y '+fmm(dy)+' · по прямой '+fmm(Math.hypot(dx,dy));}
function measHover(p,x,y){if(!p.doc||p.isPdf||p.ov)return;const M=msOf(p);M.hover=measPick(p,x,y);M.mouse=s2m(p,x,y);M.mw=p.s2w(x,y);p.draw();}
/* ближайшая точка элемента к точке (x,y) */
function closestOn(e,x,y){
  if(e.t==='L'){const dx=e.x2-e.x1,dy=e.y2-e.y1,l=dx*dx+dy*dy;let t=l?((x-e.x1)*dx+(y-e.y1)*dy)/l:0;t=Math.max(0,Math.min(1,t));return [e.x1+t*dx,e.y1+t*dy];}
  const a=Math.atan2(y-e.cy,x-e.cx);
  if(e.t==='C'||onArc(e,e.cx+Math.cos(a),e.cy+Math.sin(a)))return [e.cx+e.r*Math.cos(a),e.cy+e.r*Math.sin(a)];
  const p0=[e.cx+e.r*Math.cos(e.a0),e.cy+e.r*Math.sin(e.a0)],p1=[e.cx+e.r*Math.cos(e.a1),e.cy+e.r*Math.sin(e.a1)];
  return Math.hypot(p0[0]-x,p0[1]-y)<Math.hypot(p1[0]-x,p1[1]-y)?p0:p1;
}
function entPt(e,t){ // точка элемента по параметру 0…1
  if(e.t==='L')return [e.x1+(e.x2-e.x1)*t,e.y1+(e.y2-e.y1)*t];
  let a0=0,sw=Math.PI*2;if(e.t==='A'){a0=e.a0;sw=e.ccw?e.a1-e.a0:e.a0-e.a1;while(sw<=0)sw+=Math.PI*2;}
  const a=a0+(e.t==='A'&&!e.ccw?-1:1)*sw*t;return [e.cx+e.r*Math.cos(a),e.cy+e.r*Math.sin(a)];
}
function gapBetween(e1,e2){ // кратчайшее расстояние между двумя элементами: перебор по первому + уточнение
  const f=t=>{const p=entPt(e1,t),q=closestOn(e2,p[0],p[1]);return {d:Math.hypot(p[0]-q[0],p[1]-q[1]),p,q,t};};
  let best=f(0);const N=e1.t==='L'?60:360;for(let i=1;i<=N;i++){const v=f(i/N);if(v.d<best.d)best=v;}
  let lo=Math.max(0,best.t-1/N),hi=Math.min(1,best.t+1/N);
  for(let k=0;k<60;k++){const m1=lo+(hi-lo)/3,m2=hi-(hi-lo)/3;if(f(m1).d<f(m2).d)hi=m2;else lo=m1;}
  const v=f((lo+hi)/2);return v.d<best.d?v:best;
}
function angBetween(e1,e2){ // угол между отрезками: вершина — точка пересечения прямых, лучи — к дальним концам
  const d1=[e1.x2-e1.x1,e1.y2-e1.y1],d2=[e2.x2-e2.x1,e2.y2-e2.y1],cr=d1[0]*d2[1]-d1[1]*d2[0];
  if(Math.abs(cr)<1e-9*Math.hypot(...d1)*Math.hypot(...d2))return null;
  const t=((e2.x1-e1.x1)*d2[1]-(e2.y1-e1.y1)*d2[0])/cr,V=[e1.x1+d1[0]*t,e1.y1+d1[1]*t];
  const far=(e)=>Math.hypot(e.x1-V[0],e.y1-V[1])>Math.hypot(e.x2-V[0],e.y2-V[1])?[e.x1,e.y1]:[e.x2,e.y2];
  const P1=far(e1),P2=far(e2);let a1=Math.atan2(P1[1]-V[1],P1[0]-V[0]),a2=Math.atan2(P2[1]-V[1],P2[0]-V[0]);
  let d=a2-a1;while(d<=-Math.PI)d+=Math.PI*2;while(d>Math.PI)d-=Math.PI*2;
  return {V,a1,d,deg:Math.abs(d)*180/Math.PI,r:Math.min(Math.hypot(P1[0]-V[0],P1[1]-V[1]),Math.hypot(P2[0]-V[0],P2[1]-V[1]))*0.6};
}
function measClick(p,x,y){
  const M=msOf(p),now=performance.now();
  // двойной клик — «показать всё»; что успел сделать первый клик — откатить
  if(MEAS.last&&MEAS.last.p===p&&now-MEAS.last.t<350&&Math.hypot(x-MEAS.last.x,y-MEAS.last.y)<8){M.pts=MEAS.last.pts;M.items.length=MEAS.last.n;M.rad=MEAS.last.rad;MEAS.last=null;p.fit();return;}
  MEAS.last={p,t:now,x,y,pts:M.pts.slice(),n:M.items.length,rad:M.rad||null};
  const h=measPick(p,x,y),mw=p.s2w(x,y);
  if(SET.mmode==='gap'){ // зазор: клик по одному контуру (отверстие, дуга, линия), потом по другому — кратчайшее расстояние между ними
    const e=h.ent||(h.snap&&measPickEnt(p,x,y));if(!e){flash('Зазор: щёлкните по линии, дуге или отверстию');return;}
    if(!M.gap){M.gap=e;flash('Первый контур. Щёлкните по второму');p.draw();return;}
    if(M.gap===e){flash('Это тот же элемент — щёлкните по другому');return;}
    const g=gapBetween(M.gap,e);M.gap=null;const it={t:'gap',a:g.p,b:g.q,d:g.d};M.items.push(it);flash('Зазор (кратчайшее расстояние) '+fmm(g.d)+' мм  ·  '+measInfo(it));p.draw();return;}
  if(SET.mmode==='ang'){ // угол: клик по одной линии, потом по другой
    const e=h.ent||(h.snap&&measPickLine(p,x,y));if(!e||e.t!=='L'){flash('Угол: щёлкните по прямой линии (отрезку)');return;}
    if(!M.ang){M.ang=e;flash('Первая линия. Щёлкните по второй');p.draw();return;}
    const A=angBetween(M.ang,e);M.ang=null;if(!A){flash('Линии параллельны — угла нет');p.draw();return;}
    M.items.push({t:'ang',e1:M.ang||null,A});flash('Угол '+fmm(A.deg)+'°  ·  смежный '+fmm(180-A.deg)+'°');p.draw();return;}
  if(M.pts.length===2){const a=M.pts[0],b=M.pts[1],it={t:'lin',a,b,dir:linDim(p,a,b,mw),o:s2m(p,x,y)};M.items.push(it);M.pts=[];
    flash((it.dir==='h'?'Горизонтальный ':it.dir==='v'?'Вертикальный ':'По прямой ')+fmm(dimGeom(p,it).val)+' мм  ·  '+measInfo(it));p.draw();return;}
  if(M.rad){ // радиус / диаметр: второй клик — где поставить надпись (выноска от дуги к надписи)
    const it={t:'ent',e:M.rad,o:s2m(p,x,y)};M.items.push(it);M.rad=null;const t=entText(it.e);flash(t.main+'  ·  '+t.sub);p.draw();return;}
  if(!M.pts.length&&h.ent&&!h.snap){
    if(h.ent.t==='L'){M.items.push({t:'ent',e:h.ent});const t=entText(h.ent);flash(t.main+'  ·  '+t.sub);p.draw();return;}
    M.rad=h.ent;flash((h.ent.t==='C'?'Диаметр':'Радиус')+': отведите курсор и щёлкните, где поставить надпись');p.draw();return;}
  if(!h.snap){flash('Наведите на конец, середину или центр — точка ставится только с привязкой (зелёный значок)');return;}
  M.pts.push([h.snap[0],h.snap[1]]);
  if(M.pts.length===2&&SET.mmode==='dist'){const it={t:'dist',a:M.pts[0],b:M.pts[1]};M.items.push(it);M.pts=[];flash('Расстояние '+fmm(Math.hypot(it.b[0]-it.a[0],it.b[1]-it.a[1]))+' мм  ·  '+measInfo(it));p.draw();return;}
  flash(M.pts.length===1?'Первая точка. Укажите вторую':'Теперь отведите курсор и щёлкните, где положить размер: выше/ниже — горизонтальный, левее/правее — вертикальный');
  p.draw();
}
function entText(e){
  if(e.t==='L')return {main:'L '+fmm(Math.hypot(e.x2-e.x1,e.y2-e.y1)),sub:'длина отрезка'};
  if(e.t==='C')return {main:'Ø'+fmm(e.r*2),sub:'R '+fmm(e.r)+' · длина окружности '+fmm(2*Math.PI*e.r)};
  let sw=e.ccw?e.a1-e.a0:e.a0-e.a1;while(sw<=0)sw+=Math.PI*2;
  return {main:'R'+fmm(e.r),sub:'Ø'+fmm(e.r*2)+' · дуга '+fmm(sw*180/Math.PI)+'° · длина '+fmm(e.r*sw)};
}
function measText(it){if(it.t==='ent')return entText(it.e);const dx=Math.abs(it.b[0]-it.a[0]),dy=Math.abs(it.b[1]-it.a[1]),d=Math.hypot(dx,dy);
  return {main:fmm(d)+' мм',sub:measInfo(it)};}
function measPaint(p,c,d){
  const M=msOf(p);c.save();c.setTransform(d,0,0,d,0,0);
  const col='#ffd23f',bg='rgba(16,18,22,.92)';
  const halo=lum(dxfBg())>150?'rgba(255,255,255,.95)':'rgba(16,18,22,.95)';
  const tag=(x,y,t,ang,small,clr)=>{ // надпись всегда горизонтально, без рамки; тёмный «ореол» вокруг букв — чтобы не сливалась с контуром
    c.save();c.font=(small?'':'bold ')+(small?11:14)+'px system-ui,sans-serif';c.textAlign='center';c.textBaseline='middle';
    c.lineJoin='round';c.strokeStyle=halo;c.lineWidth=small?3:4;c.strokeText(t,x,y);c.fillStyle=clr||(small?'#d6dae0':col);c.fillText(t,x,y);c.restore();};
  const arrow=(x,y,ax,ay)=>{const L=Math.hypot(ax,ay)||1,ux=ax/L,uy=ay/L,s=9;c.beginPath();c.moveTo(x,y);c.lineTo(x-ux*s-uy*3,y-uy*s+ux*3);c.lineTo(x-ux*s+uy*3,y-uy*s-ux*3);c.closePath();c.fill();};
  const drawDim=(it,pre)=>{const G=dimGeom(p,it);c.strokeStyle=col;c.fillStyle=col;c.lineWidth=1.2;c.setLineDash(pre?[5,4]:[]);
    const ext=(P0,P1)=>{const dx=P1[0]-P0[0],dy=P1[1]-P0[1],L=Math.hypot(dx,dy);if(L<1)return;const ux=dx/L,uy=dy/L,g=Math.min(4,L/3);c.moveTo(P0[0]+ux*g,P0[1]+uy*g);c.lineTo(P1[0]+ux*7,P1[1]+uy*7);};
    c.globalAlpha=.75;c.beginPath();ext(G.A,G.a2);ext(G.B,G.b2);c.stroke();c.globalAlpha=1;   // выносные: с зазором от детали и выходом за размерную линию
    const vx=G.b2[0]-G.a2[0],vy=G.b2[1]-G.a2[1],mx=(G.a2[0]+G.b2[0])/2,my=(G.a2[1]+G.b2[1])/2,t=fmm(G.val);
    c.font='bold 14px system-ui,sans-serif';const tw=c.measureText(t).width;
    if(it.dir==='v'){ // вертикальный — как в CAD: надпись по середине размерной линии, линия под ней разорвана
      const L=Math.hypot(vx,vy),ux=vx/(L||1),uy=vy/(L||1),gap=Math.min(L/2,11);
      c.beginPath();c.moveTo(...G.a2);c.lineTo(mx-ux*gap,my-uy*gap);c.moveTo(mx+ux*gap,my+uy*gap);c.lineTo(...G.b2);c.stroke();c.setLineDash([]);
      if(L>24){arrow(...G.a2,-vx,-vy);arrow(...G.b2,vx,vy);}
      tag(mx,my,t);
    }else{
      c.beginPath();c.moveTo(...G.a2);c.lineTo(...G.b2);c.stroke();c.setLineDash([]);
      if(Math.hypot(vx,vy)>24){arrow(...G.a2,-vx,-vy);arrow(...G.b2,vx,vy);}
      tag(mx,my-11,t);
    }
    if(pre)tag(mx,my+16,measInfo(it),0,true);};
  // «Расстояние» как в AutoCAD: по прямой, по X, по Y и угол — пунктиром
  const drawDist=(it,pre)=>{const A=m2w(p,...it.a),B=m2w(p,...it.b),sa=w2s(p,...A),sb=w2s(p,...B),sc=w2s(p,B[0],A[1]);
    const dx=Math.abs(B[0]-A[0]),dy=Math.abs(B[1]-A[1]),L=Math.hypot(dx,dy),gc='#c9ced6';
    c.setLineDash([2,3]);c.lineWidth=1.2;c.strokeStyle=gc;c.beginPath();c.moveTo(...sa);c.lineTo(...sb);c.moveTo(...sa);c.lineTo(...sc);c.lineTo(...sb);c.stroke();
    let ang=Math.atan2(B[1]-A[1],B[0]-A[0]);if(ang<0)ang+=Math.PI*2;const r=Math.min(60,Math.hypot(sb[0]-sa[0],sb[1]-sa[1])*0.35);
    if(L>1e-9&&dx>1e-9&&dy>1e-9){c.beginPath();c.arc(sa[0],sa[1],r,0,-ang,true);c.stroke();const am=-ang/2;tag(sa[0]+(r+18)*Math.cos(am),sa[1]+(r+12)*Math.sin(am),fmm(ang*180/Math.PI)+'°',0,true,gc);}
    c.setLineDash([]);c.fillStyle=col;for(const q of [sa,sb]){c.beginPath();c.arc(q[0],q[1],3.5,0,Math.PI*2);c.fill();}
    tag((sa[0]+sb[0])/2-14,(sa[1]+sb[1])/2-12,fmm(L));
    if(dx>1e-9&&dy>1e-9){tag((sa[0]+sc[0])/2,sc[1]+(sc[1]>sb[1]?14:-12),fmm(dx),0,false,'#8fd3ff');tag(sc[0]+(sc[0]>sa[0]?8:-8)+(sc[0]>sa[0]?1:-1)*c.measureText(fmm(dy)).width*0.6,(sc[1]+sb[1])/2,fmm(dy),0,false,'#8fd3ff');}};
  // выноска радиуса / диаметра: стрелка на дуге в точке, ближайшей к надписи, полка с текстом
  const radLeader=(e,o,txt,pre)=>{
    let a=Math.atan2(o[1]-e.cy,o[0]-e.cx);
    if(e.t==='A'&&!onArc(e,e.cx+Math.cos(a),e.cy+Math.sin(a))){const d0=Math.abs(Math.atan2(Math.sin(a-e.a0),Math.cos(a-e.a0))),d1=Math.abs(Math.atan2(Math.sin(a-e.a1),Math.cos(a-e.a1)));a=d0<d1?e.a0:e.a1;}
    const P=m2s(p,e.cx+e.r*Math.cos(a),e.cy+e.r*Math.sin(a)),O=m2s(p,...o);
    c.save();c.strokeStyle=col;c.fillStyle=col;c.lineWidth=1.2;if(pre)c.setLineDash([5,4]);
    if(e.t==='A'||e.t==='C'){ // дугу подсветить тонко
      c.globalAlpha=.55;c.lineWidth=2.2;c.beginPath();const n=64;let a0=0,sw=Math.PI*2;if(e.t==='A'){a0=e.a0;sw=e.ccw?e.a1-e.a0:e.a0-e.a1;while(sw<=0)sw+=Math.PI*2;}
      for(let i=0;i<=n;i++){const t=a0+(e.t==='A'&&!e.ccw?-1:1)*sw*i/n,q=m2s(p,e.cx+e.r*Math.cos(t),e.cy+e.r*Math.sin(t));i?c.lineTo(...q):c.moveTo(...q);}c.stroke();c.globalAlpha=1;c.lineWidth=1.2;}
    c.font='bold 14px system-ui,sans-serif';const w=c.measureText(txt).width+8,dir=O[0]>=P[0]?1:-1;
    c.beginPath();c.moveTo(...P);c.lineTo(...O);c.lineTo(O[0]+dir*w,O[1]);c.stroke();c.setLineDash([]);
    if(Math.hypot(O[0]-P[0],O[1]-P[1])>12)arrow(P[0],P[1],P[0]-O[0],P[1]-O[1]);
    c.restore();tag(O[0]+dir*w/2,O[1]-10,txt);
  };
  const hl=e=>{c.strokeStyle=col;c.lineWidth=3;c.beginPath();
    if(e.t==='L'){c.moveTo(...m2s(p,e.x1,e.y1));c.lineTo(...m2s(p,e.x2,e.y2));}
    else{const n=64;let a0=0,sw=Math.PI*2;if(e.t==='A'){a0=e.a0;sw=e.ccw?e.a1-e.a0:e.a0-e.a1;while(sw<=0)sw+=Math.PI*2;}
      for(let i=0;i<=n;i++){const a=a0+(e.t==='A'&&!e.ccw?-1:1)*sw*i/n,q=m2s(p,e.cx+e.r*Math.cos(a),e.cy+e.r*Math.sin(a));i?c.lineTo(...q):c.moveTo(...q);}}
    c.stroke();};
  // диаметры всех отверстий — сразу при включении режима
  c.font='12px system-ui,sans-serif';
  if(SET.mholes!==false)for(const e of measEnt(p.doc).E){if(e.t!=='C')continue;const r=e.r*p.s;if(r<4)continue;const [x,y]=m2s(p,e.cx,e.cy),t='Ø'+fmm(e.r*2);
    const w=c.measureText(t).width+8,lx=x+r*0.72+2,ly=y-r*0.72-10;if(lx>p.W||ly<-10||lx+w<0||ly>p.H)continue;
    c.fillStyle='rgba(16,18,22,.8)';c.fillRect(lx,ly,w,16);c.fillStyle='#8fd3ff';c.textAlign='left';c.textBaseline='middle';c.fillText(t,lx+4,ly+8.5);}
  for(const it of M.items){
    if(it.t==='lin')drawDim(it,false);
    else if(it.t==='dist')drawDist(it,false);
    else if(it.t==='gap'){const a=m2s(p,...it.a),b=m2s(p,...it.b),vx=b[0]-a[0],vy=b[1]-a[1],L=Math.hypot(vx,vy);
      c.strokeStyle=col;c.fillStyle=col;c.lineWidth=1.3;c.beginPath();c.moveTo(...a);c.lineTo(...b);c.stroke();
      if(L>16){arrow(...a,-vx,-vy);arrow(...b,vx,vy);}else{for(const q of [a,b]){c.beginPath();c.arc(q[0],q[1],3,0,Math.PI*2);c.fill();}}
      const nx=L?-vy/L:0,ny=L?vx/L:-1;tag((a[0]+b[0])/2+nx*14,(a[1]+b[1])/2+ny*14-(Math.abs(ny)<0.3?10:0),fmm(it.d));}
    else if(it.t==='ang'){const A=it.A,V=m2s(p,...A.V),R=Math.max(24,A.r*p.s),M2=xfMat(p.xf),det=M2[0]*M2[3]-M2[1]*M2[2],rot=Math.atan2(M2[1],M2[0]);
      // угол в координатах экрана (с учётом поворота/зеркала детали)
      const sa=det<0?Math.PI-A.a1:A.a1,sd=det<0?-A.d:A.d,s0=-(sa+rot),s1=-(sa+rot+sd);
      c.strokeStyle=col;c.lineWidth=1.3;c.beginPath();c.arc(V[0],V[1],R,s0,s1,sd>0);c.stroke();
      c.fillStyle=col;c.beginPath();c.arc(V[0],V[1],3,0,Math.PI*2);c.fill();
      const am=(s0+s1)/2;tag(V[0]+(R+22)*Math.cos(am),V[1]+(R+14)*Math.sin(am),fmm(A.deg)+'°');}
    else{const e=it.e,t=entText(e);if(e.t==='L'){hl(e);const a=m2s(p,e.x1,e.y1),b=m2s(p,e.x2,e.y2);tag((a[0]+b[0])/2,(a[1]+b[1])/2-14,t.main);}
      else radLeader(e,it.o||[e.cx+e.r*1.3,e.cy+e.r*0.3],t.main,false);}
  }
  // начатый размер
  const H=M.hover;
  if(M.pts.length){c.fillStyle=col;for(const q of M.pts){const s=m2s(p,...q);c.beginPath();c.arc(s[0],s[1],4,0,Math.PI*2);c.fill();}
    if(M.pts.length===1&&M.mouse){const b=H&&H.snap?[H.snap[0],H.snap[1]]:M.mouse,s0=m2s(p,...M.pts[0]),s1=m2s(p,...b);c.setLineDash([4,4]);c.strokeStyle=col;c.lineWidth=1;c.beginPath();c.moveTo(...s0);c.lineTo(...s1);c.stroke();c.setLineDash([]);}
    if(M.pts.length===1&&M.mouse&&SET.mmode==='dist'&&H&&H.snap)drawDist({a:M.pts[0],b:[H.snap[0],H.snap[1]]},true);
    if(M.pts.length===2&&M.mw){const it={t:'lin',a:M.pts[0],b:M.pts[1],dir:linDim(p,M.pts[0],M.pts[1],M.mw),o:M.mouse};drawDim(it,true);}}
  if(H&&H.snap&&M.pts.length<2){const [x,y]=m2s(p,H.snap[0],H.snap[1]);c.strokeStyle='#39d353';c.lineWidth=2;c.beginPath();
    if(H.snap[2]==='центр'){c.arc(x,y,6,0,Math.PI*2);}else if(H.snap[2]==='середина'){c.moveTo(x,y-7);c.lineTo(x+7,y+5);c.lineTo(x-7,y+5);c.closePath();}else if(H.snap[2]==='квадрант'){c.moveTo(x,y-7);c.lineTo(x+7,y);c.lineTo(x,y+7);c.lineTo(x-7,y);c.closePath();}else c.rect(x-5,y-5,10,10);
    c.stroke();c.fillStyle='#39d353';c.font='11px system-ui,sans-serif';c.textAlign='left';c.textBaseline='top';c.fillText(H.snap[2],x+9,y+6);}
  else if(H&&H.ent&&!M.pts.length){hl(H.ent);}
  if(M.ang)hl(M.ang);
  if(M.gap)hl(M.gap);
  if(M.rad&&M.mouse)radLeader(M.rad,M.mouse,entText(M.rad).main,true);
  c.restore();
}
function measToggle(on){
  MEAS.on=on===undefined?!MEAS.on:on;if(MEAS.on&&LOUPE.on)loupeOff();   // лупа «по кнопке мыши» и размеры вместе не работают — включили одно, другое выключается
  $('vMeas').classList.toggle('on',MEAS.on);$('measBox').hidden=!MEAS.on;
  if(!MEAS.on&&SET.mkeep==='mode')MEAS.store.clear();
  for(const p of panes){p.ms=null;p.cv.style.cursor=MEAS.on?'crosshair':'';p.draw();}
  if(MEAS.on)flash('Размеры: две точки (с привязкой) и третий клик — где положить размер. Клик по линии / отверстию — длина / Ø. Esc — отменить начатый, Backspace — убрать последний');
}
function measUndo(all){for(const p of panes){const M=p.ms;if(!M)continue;if((M.pts.length||M.ang||M.rad||M.gap)&&!all){M.pts=[];M.ang=null;M.rad=null;M.gap=null;}else if(all)M.items.length=0;else M.items.pop();p.draw();}}
$('measMode').value=['dist','ang','gap'].includes(SET.mmode)?SET.mmode:'dim';$('measMode').onchange=e=>{SET.mmode=e.target.value;saveSet();for(const p of panes)if(p.ms){p.ms.pts=[];p.ms.ang=null;p.draw();}};
$('measHoles').classList.toggle('on',SET.mholes!==false);$('measHoles').onclick=()=>{SET.mholes=SET.mholes===false;saveSet();$('measHoles').classList.toggle('on',SET.mholes!==false);panes.forEach(p=>p.draw());};
$('sMkeep').value=['view','proj'].includes(SET.mkeep)?SET.mkeep:'mode';$('sMkeep').onchange=e=>{SET.mkeep=e.target.value;saveSet();};
$('measPrec').value=String(mDec());$('measPrec').onchange=e=>{SET.mprec=+e.target.value;saveSet();panes.forEach(p=>p.draw());};
$('measUndo').onclick=()=>measUndo(false);$('measClear').onclick=()=>measUndo(true);
$('vMeas').onclick=()=>measToggle();
/* =====================================================================
   ТАБЛИЦА DXF ПАПКИ и ПРОВЕРКА ПЕРЕД РЕЗКОЙ.
   Площадь, длина реза, врезки и замечания считает GEO.analyze (в отдельном потоке).
   Правила редактируются: станок (лазер / плазма / координатно-пробивной) и числа в каждом правиле.
   Масса = площадь × толщина × плотность (плотность — по ключевым словам в названии материала).
   ===================================================================== */
const RULE_DEF={
  laser :{name:'Лазер',holeK:1,holeAbs:1,webK:1,webAbs:1,minLen:0.1,gapMax:2,join:0.01},
  plasma:{name:'Плазма',holeK:1.5,holeAbs:4,webK:1.5,webAbs:3,minLen:0.1,gapMax:2,join:0.01},
  punch :{name:'Координатно-пробивной',holeK:1,holeAbs:3,webK:1,webAbs:2,minLen:0.1,gapMax:2,join:0.01}};
const CHK_DEF={open:true,gap:true,dup:true,small:true,hole:true,web:true,text:false,out:true};
const CHK_N={open:'незамкнутые контуры',gap:'разрывы контура (до «макс. разрыв»)',dup:'двойные линии',small:'очень мелкие элементы',hole:'малые отверстия и вырезы',web:'узкие перемычки',text:'надписи в файле',out:'элементы вне детали'};
const DENS_DEF='нерж, aisi, 12х18, 08х18, inox = 7.9\nамг, ад1, ад31, al, д16, алюм = 2.7\nлатунь, л63 = 8.5\nмедь, м1, cu = 8.9\nостальное (сталь) = 7.85';
function rules(){const r=SET.rules||(SET.rules={});r.m=r.m||'laser';r.P=r.P||{};for(const k in RULE_DEF)r.P[k]=Object.assign({},RULE_DEF[k],r.P[k]||{});
  r.chk=Object.assign({},CHK_DEF,r.chk||{});if(typeof r.dens!=='string')r.dens=DENS_DEF;return r;}
function density(mat){const m=(mat||'').toLowerCase();let def=7.85;
  for(const line of rules().dens.split('\n')){const i=line.lastIndexOf('=');if(i<0)continue;const v=parseFloat(line.slice(i+1).replace(',','.'));if(!(v>0))continue;
    const keys=line.slice(0,i).split(',').map(x=>x.trim().toLowerCase()).filter(Boolean);
    if(keys.some(k=>k.startsWith('остальн')))def=v;else if(m&&keys.some(k=>m.includes(k)))return v;}
  return def;}
function rulesFor(it){const r=rules(),P=r.P[r.m],mt=mtInfo(it);return Object.assign({},P,{s:mt&&mtNum(mt.thk)<1e8?mtNum(mt.thk):0,chk:r.chk});}
const ANA=new Map();   // key файла → {sig, r}
const rulesSig=()=>JSON.stringify([rules().m,rules().P[rules().m],rules().chk]);
async function anaGet(it){
  const sig=rulesSig()+'|'+(mtInfo(it)||{}).thk,c=ANA.get(it.key);if(c&&c.sig===sig)return c.r;
  const doc=await getDoc(it);const r=await geoCompare.analyze(doc,rulesFor(it));r.origin=doc.origin;ANA.set(it.key,{sig,r});chkBadge(it,r);return r;
}
function chkBadge(it,r){
  if(!it.chkb){it.chkb=document.createElement('span');it.chkb.className='chkb';it.tile.querySelector('.th').appendChild(it.chkb);
    it.chkb.addEventListener('click',e=>{e.stopPropagation();const i=view.indexOf(it);if(i<0)return;showItem(i);if(!docked())setFull(true);setTimeout(()=>chkToggle(true),50);});}
  const n=r.issues.length;it.chkb.hidden=false;it.chkb.className='chkb '+(n?'bad':'ok');it.chkb.textContent=n?'⚠ '+n:'✓';
  it.chkb.title=n?'Проверка перед резкой ('+rules().P[rules().m].name+'): '+r.issues.slice(0,8).map(x=>x.text).join('; ')+(n>8?'…':'')+' — клик: показать на детали':'Проверка перед резкой: замечаний нет';
}
/* ---------- колонки таблицы ---------- */
const f1=(v,n)=>v==null||!isFinite(v)?'':(Math.round(v*10**n)/10**n).toLocaleString('ru-RU',{minimumFractionDigits:n,maximumFractionDigits:n});
const TCOLS=[
  {k:'name',t:'Файл',v:(it)=>it.name,always:true},
  {k:'desig',t:'Обозначение',v:it=>nameParts(it).desig||''},
  {k:'mat',t:'Материал',v:it=>(mtInfo(it)||{}).mat||''},
  {k:'thk',t:'Толщина, мм',v:it=>{const m=mtInfo(it);return m&&m.thk?mtNum(m.thk):''},num:2,trim:1},
  {k:'qty',t:'Кол-во',v:it=>(mtInfo(it)||{}).qty||'',num:0},
  {k:'size',t:'Габарит, мм',v:(it,r)=>r&&r.size?Math.round(Math.max(...r.size))+' × '+Math.round(Math.min(...r.size)):''},
  {k:'area',t:'Площадь, м²',v:(it,r)=>r?r.area/1e6:'',num:4},
  {k:'mass',t:'Масса, кг',v:(it,r)=>{const m=mtInfo(it);return r&&m&&m.thk?r.area*mtNum(m.thk)*density(m.mat)/1e6:'';},num:2},
  {k:'cut',t:'Длина реза, м',v:(it,r)=>r?r.cut/1000:'',num:2},
  {k:'pierce',t:'Врезок',v:(it,r)=>r?r.pierces:'',num:0},
  {k:'iss',t:'Замечания',v:(it,r)=>r?r.issues.length:'',num:0},
];
if(!Array.isArray(SET.tcols))SET.tcols=TCOLS.map(c=>c.k);
const TBL={rows:[],sort:null,dir:1,tok:0};
function tblItems(){return view.filter(it=>it.type==='dxf');}
async function tblOpen(){
  const P=$('tblPanel');P.hidden=false;const L=tblItems();
  $('tblTitle').textContent='Таблица DXF'+(curDir?' — '+curDir.split('/').pop():'')+' · файлов: '+L.length+(MTF?' · фильтр: '+MTF.replace('|',' · '):'');
  $('tblMachine').value=rules().m;
  TBL.rows=L.map(it=>({it,r:(ANA.get(it.key)||{}).r||null}));tblRender();
  const tok=++TBL.tok;let n=0;
  for(const row of TBL.rows){
    if(tok!==TBL.tok||P.hidden)return;
    try{row.r=await anaGet(row.it);}catch(e){row.err=e.message;}
    n++;$('tblProg').textContent=n<TBL.rows.length?'считаю '+n+' / '+TBL.rows.length+'…':'';
    if(n%6===0||n===TBL.rows.length)tblRender();
  }
}
function tblRender(){
  const cols=TCOLS.filter(c=>c.always||SET.tcols.includes(c.k)),T=$('tblBody');T.textContent='';
  const head=document.createElement('tr');
  for(const c of cols){const th=document.createElement('th');th.textContent=c.t+(TBL.sort===c.k?(TBL.dir>0?' ▲':' ▼'):'');if(c.num!=null)th.className='n';
    th.onclick=()=>{TBL.dir=TBL.sort===c.k?-TBL.dir:1;TBL.sort=c.k;tblRender();};head.appendChild(th);}
  T.appendChild(head);
  let rows=TBL.rows.slice();
  if(TBL.sort){const c=TCOLS.find(x=>x.k===TBL.sort);rows.sort((a,b)=>{const x=c.v(a.it,a.r),y=c.v(b.it,b.r);
    return TBL.dir*((typeof x==='number'&&typeof y==='number')?x-y:String(x).localeCompare(String(y),'ru',{numeric:true}));});}
  for(const row of rows){const tr=document.createElement('tr');
    for(const c of cols){const td=document.createElement('td');let v=c.v(row.it,row.r);
      if(c.num!=null){td.className='n';if(typeof v==='number')v=c.trim?v.toLocaleString('ru-RU',{maximumFractionDigits:c.num}):f1(v,c.num);}
      if(c.k==='iss'&&row.r){td.className='n '+(row.r.issues.length?'bad':'ok');td.textContent=row.r.issues.length?'⚠ '+row.r.issues.length:'✓';td.title=row.r.issues.map(x=>x.text).join('\n')||'замечаний нет';}
      else td.textContent=row.err&&c.k==='name'?v+' — ошибка: '+row.err:(v===''&&!row.r&&c.k!=='name'&&c.k!=='desig'&&c.k!=='mat'&&c.k!=='thk'&&c.k!=='qty'?'…':v);
      tr.appendChild(td);}
    tr.onclick=()=>{const i=view.indexOf(row.it);if(i<0)return;$('tblPanel').hidden=true;showItem(i);if(!docked())setFull(true);};
    T.appendChild(tr);}
  // итоги по материалу и толщине (с учётом количества)
  const G=new Map();
  for(const row of TBL.rows){const m=mtInfo(row.it),k=m?mtLabel(m):'без материала в имени',q=(m&&m.qty)||1,r=row.r;
    const g=G.get(k)||{n:0,q:0,area:0,mass:0,cut:0,pierce:0,iss:0,mt:m};g.n++;g.q+=q;
    if(r){g.area+=r.area*q/1e6;g.cut+=r.cut*q/1000;g.pierce+=r.pierces*q;g.iss+=r.issues.length?1:0;if(m&&m.thk)g.mass+=r.area*mtNum(m.thk)*density(m.mat)/1e6*q;}
    G.set(k,g);}
  const S=$('tblSum');S.textContent='';
  const sh=document.createElement('tr');const want=k=>SET.tcols.includes(k);
  const sc=[['Материал · толщина',g=>g.k],['Файлов',g=>g.n],['Деталей, шт',g=>g.q],...(want('area')?[['Площадь, м²',g=>f1(g.area,3)]]:[]),...(want('mass')?[['Масса, кг',g=>f1(g.mass,1)]]:[]),
    ...(want('cut')?[['Длина реза, м',g=>f1(g.cut,1)]]:[]),...(want('pierce')?[['Врезок',g=>g.pierce]]:[]),...(want('iss')?[['С замечаниями',g=>g.iss]]:[])];
  for(const [t] of sc){const th=document.createElement('th');th.textContent=t;sh.appendChild(th);}S.appendChild(sh);
  const all={k:'Всего',n:0,q:0,area:0,mass:0,cut:0,pierce:0,iss:0};
  const gl=[...G].sort((a,b)=>a[0].localeCompare(b[0],'ru',{numeric:true}));
  for(const [k,g] of gl){g.k=k;for(const f of ['n','q','area','mass','cut','pierce','iss'])all[f]+=g[f];}
  for(const g of [...gl.map(x=>x[1]),all]){const tr=document.createElement('tr');if(g===all)tr.className='tot';
    for(const [,fn] of sc){const td=document.createElement('td');td.textContent=fn(g);tr.appendChild(td);}S.appendChild(tr);}
  TBL.sum={sc,rows:[...gl.map(x=>x[1]),all]};
}
function tblCols(){const M=$('tblColMenu');M.textContent='';
  for(const c of TCOLS){if(c.always)continue;const l=document.createElement('label');l.innerHTML='<input type="checkbox"> ';l.append(c.t);
    const cb=l.querySelector('input');cb.checked=SET.tcols.includes(c.k);cb.onchange=()=>{SET.tcols=TCOLS.filter(x=>x.k===c.k?cb.checked:SET.tcols.includes(x.k)).map(x=>x.k);saveSet();tblRender();};M.appendChild(l);}
  M.hidden=!M.hidden;}
/* ---------- Excel (.xlsx) без библиотек: несжатый ZIP + XML ---------- */
const CRC=(()=>{const t=new Uint32Array(256);for(let n=0;n<256;n++){let c=n;for(let k=0;k<8;k++)c=c&1?0xEDB88320^(c>>>1):c>>>1;t[n]=c>>>0;}
  return b=>{let c=0xFFFFFFFF;for(let i=0;i<b.length;i++)c=t[(c^b[i])&255]^(c>>>8);return (c^0xFFFFFFFF)>>>0;};})();
function zipStore(files){ // [{name, data:Uint8Array}] → Blob
  const enc=new TextEncoder(),parts=[],cen=[];let off=0;
  const u16=v=>[v&255,v>>8&255],u32=v=>[v&255,v>>8&255,v>>16&255,v>>>24&255];
  for(const f of files){const nm=enc.encode(f.name),crc=CRC(f.data),sz=f.data.length;
    const h=new Uint8Array([...u32(0x04034b50),...u16(20),...u16(0x0800),...u16(0),...u16(0),...u16(0),...u32(crc),...u32(sz),...u32(sz),...u16(nm.length),...u16(0)]);
    parts.push(h,nm,f.data);
    cen.push(new Uint8Array([...u32(0x02014b50),...u16(20),...u16(20),...u16(0x0800),...u16(0),...u16(0),...u16(0),...u32(crc),...u32(sz),...u32(sz),...u16(nm.length),...u16(0),...u16(0),...u16(0),...u16(0),...u32(0),...u32(off)]),nm);
    off+=h.length+nm.length+sz;}
  let cs=0;for(const c of cen)cs+=c.length;
  const end=new Uint8Array([...u32(0x06054b50),...u16(0),...u16(0),...u16(files.length),...u16(files.length),...u32(cs),...u32(off),...u16(0)]);
  return new Blob([...parts,...cen,end],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
}
function xlsx(sheets){ // [{name, rows:[[str|num]], widths:[...]}]; первая строка — жирная
  const esc=v=>String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/[\x00-\x08\x0b\x0c\x0e-\x1f]/g,'');
  const col=i=>{let s='';i++;while(i){const m=(i-1)%26;s=String.fromCharCode(65+m)+s;i=Math.floor((i-1)/26);}return s;};
  const enc=new TextEncoder(),F=[];
  const sheetXml=sh=>'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetViews><sheetView workbookViewId="0"><pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/></sheetView></sheetViews>'+
    (sh.widths?'<cols>'+sh.widths.map((w,i)=>'<col min="'+(i+1)+'" max="'+(i+1)+'" width="'+w+'" customWidth="1"/>').join('')+'</cols>':'')+'<sheetData>'+
    sh.rows.map((r,ri)=>'<row r="'+(ri+1)+'">'+r.map((v,ci)=>{const ref=col(ci)+(ri+1),st=ri===0?' s="1"':'';
      if(typeof v==='number'&&isFinite(v))return '<c r="'+ref+'"'+st+'><v>'+v+'</v></c>';if(v===''||v==null)return '';return '<c r="'+ref+'" t="inlineStr"'+st+'><is><t xml:space="preserve">'+esc(v)+'</t></is></c>';}).join('')+'</row>').join('')+
    '</sheetData>'+(sh.rows.length>1?'<autoFilter ref="A1:'+col(sh.rows[0].length-1)+sh.rows.length+'"/>':'')+'</worksheet>';
  F.push({name:'[Content_Types].xml',x:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>'+sheets.map((s,i)=>'<Override PartName="/xl/worksheets/sheet'+(i+1)+'.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>').join('')+'</Types>'});
  F.push({name:'_rels/.rels',x:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>'});
  F.push({name:'xl/workbook.xml',x:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets>'+sheets.map((s,i)=>'<sheet name="'+esc(s.name).slice(0,31)+'" sheetId="'+(i+1)+'" r:id="rId'+(i+1)+'"/>').join('')+'</sheets>'+
    sheets.map((s,i)=>s.rows.length>1?'':'').join('')+'</workbook>'});
  F.push({name:'xl/_rels/workbook.xml.rels',x:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'+sheets.map((s,i)=>'<Relationship Id="rId'+(i+1)+'" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet'+(i+1)+'.xml"/>').join('')+'<Relationship Id="rId'+(sheets.length+1)+'" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/></Relationships>'});
  F.push({name:'xl/styles.xml',x:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><fonts count="2"><font><sz val="11"/><name val="Calibri"/></font><font><b/><sz val="11"/><name val="Calibri"/></font></fonts><fills count="2"><fill><patternFill patternType="none"/></fill><fill><patternFill patternType="gray125"/></fill></fills><borders count="1"><border/></borders><cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs><cellXfs count="2"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/><xf numFmtId="0" fontId="1" fillId="0" borderId="0" xfId="0" applyFont="1"/></cellXfs><cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles></styleSheet>'});
  sheets.forEach((s,i)=>F.push({name:'xl/worksheets/sheet'+(i+1)+'.xml',x:sheetXml(s)}));
  return zipStore(F.map(f=>({name:f.name,data:enc.encode(f.x)})));
}
function tblExport(){
  const cols=TCOLS.filter(c=>c.always||SET.tcols.includes(c.k));
  const rows=[cols.map(c=>c.t).concat(SET.tcols.includes('iss')?['Список замечаний']:[]).concat(['Путь'])];
  for(const row of TBL.rows){const r=row.r;rows.push(cols.map(c=>{let v=c.v(row.it,r);if(typeof v==='number'&&c.num!=null)v=Math.round(v*10**c.num)/10**c.num;return v;})
    .concat(SET.tcols.includes('iss')?[r?r.issues.map(x=>x.text).join('; '):'']:[]).concat([row.it.path]));}
  const sum=[TBL.sum.sc.map(x=>x[0])];for(const g of TBL.sum.rows)sum.push(TBL.sum.sc.map(([,fn])=>{const v=fn(g);const n=typeof v==='string'?parseFloat(v.replace(/\s/g,'').replace(',','.')):v;return typeof v==='string'&&!isNaN(n)&&/^[\d\s,.-]+$/.test(v)?n:v;}));
  const name=(curDir?curDir.split('/').pop():(items[0]?items[0].path.split('/')[0]:'DXF'))+' — таблица DXF.xlsx';
  const b=xlsx([{name:'Детали',rows,widths:cols.map(c=>c.k==='name'?44:c.k==='desig'?30:14).concat(SET.tcols.includes('iss')?[60]:[]).concat([60])},{name:'Итоги',rows:sum,widths:[28,10,12,14,12,14,10,14]}]);
  const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=name.replace(/[\\/:*?"<>|]/g,'_');document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},2000);
  flash('Таблица сохранена: '+a.download);
}
/* ---------- правила проверки ---------- */
function rulesOpen(){
  const r=rules(),B=$('rulesBody');B.textContent='';$('rulesPanel').hidden=false;
  const row=(t,el,tip)=>{const d=document.createElement('div');d.className='set-row';d.innerHTML='<span></span>';d.firstChild.textContent=t;if(tip)d.title=tip;d.appendChild(el);B.appendChild(d);};
  const sel=document.createElement('select');for(const k in RULE_DEF){const o=document.createElement('option');o.value=k;o.textContent=RULE_DEF[k].name;sel.appendChild(o);}sel.value=r.m;
  sel.onchange=()=>{r.m=sel.value;saveSet();rulesOpen();rulesChanged();};row('Станок',sel,'Для каждого станка свои числа');
  const P=r.P[r.m],num=(k,t,tip,step)=>{const i=document.createElement('input');i.type='number';i.step=step||'0.1';i.min='0';i.value=P[k];i.style.width='80px';
    i.onchange=()=>{const v=parseFloat(i.value);if(v>=0){P[k]=v;saveSet();rulesChanged();}};row(t,i,tip);};
  const sec=t=>{const d=document.createElement('div');d.className='set-sec';d.textContent=t;B.appendChild(d);};
  sec('Отверстия и перемычки — от толщины s (из имени файла)');
  num('holeK','Отверстие не меньше, × s','Минимальный диаметр отверстия (ширина выреза) = коэффициент × толщина');
  num('holeAbs','…и не меньше, мм','Но не меньше этого числа миллиметров');
  num('webK','Перемычка не меньше, × s','Минимальное расстояние между контурами (отверстие–отверстие, отверстие–край)');
  num('webAbs','…и не меньше, мм','');
  sec('Контуры');
  num('gapMax','Разрыв считать до, мм','Концы незамкнутого контура ближе этого — «разрыв контура»; дальше — «незамкнутый контур»');
  num('join','Концы сходятся, если ближе, мм','Точность стыковки элементов в контур','0.001');
  num('minLen','Мелкий элемент — короче, мм','');
  sec('Что проверять');
  for(const k in CHK_N){const l=document.createElement('label');l.className='set-row';l.innerHTML='<span></span><input type="checkbox">';l.firstChild.textContent=CHK_N[k];
    const cb=l.querySelector('input');cb.checked=!!r.chk[k];cb.onchange=()=>{r.chk[k]=cb.checked;saveSet();rulesChanged();};B.appendChild(l);}
  sec('Плотность материала, г/см³ (для массы)');
  const ta=document.createElement('textarea');ta.rows=6;ta.style.width='100%';ta.value=r.dens;ta.title='Слова из названия материала через запятую = плотность. «остальное» — для всех прочих';
  ta.onchange=()=>{r.dens=ta.value;saveSet();if(!$('tblPanel').hidden)tblRender();};B.appendChild(ta);
  const rs=document.createElement('button');rs.textContent='Вернуть стандартные значения для «'+RULE_DEF[r.m].name+'»';rs.onclick=()=>{r.P[r.m]=Object.assign({},RULE_DEF[r.m]);r.chk=Object.assign({},CHK_DEF);r.dens=DENS_DEF;saveSet();rulesOpen();rulesChanged();};
  const d=document.createElement('div');d.style.margin='10px 0';d.appendChild(rs);B.appendChild(d);
}
let rulesT=0;
function rulesChanged(){clearTimeout(rulesT);rulesT=setTimeout(()=>{$('tblMachine').value=rules().m;for(const p of panes)if(p.chk)chkRun(p);if(!$('tblPanel').hidden)tblOpen();},400);}
/* ---------- проверка на детали (кнопка «✓ Проверка» в просмотре) ---------- */
async function chkRun(p){
  if(!p.it||p.it.type!=='dxf'||!p.doc)return;const it=p.it;p.chk={busy:true};
  try{const r=await anaGet(it);if(p.it!==it)return;p.chk={r,cur:-1};}catch(e){p.chk=null;flash('Проверка не удалась: '+e.message);return;}
  p.draw();chkList(p);
  const n=p.chk.r.issues.length;flash(n?'Проверка ('+rules().P[rules().m].name+'): замечаний '+n+' — список справа, клик приближает':'Проверка ('+rules().P[rules().m].name+'): замечаний нет ✓');
}
function chkToggle(on){
  const p=panes[VW.active]||panes[0];if(!p)return;on=on===undefined?!p.chk:on;
  for(const q of panes){q.chk=null;q.draw();}
  $('vChk').classList.toggle('on',on);$('chkList').hidden=true;
  if(on)for(const q of panes.slice(0,VW.set.length))if(q.it&&q.it.type==='dxf')chkRun(q);
}
function chkList(p){
  const L=$('chkList'),r=p.chk&&p.chk.r;L.textContent='';if(!r)return;L.hidden=false;
  const h=document.createElement('div');h.className='pp-h';h.innerHTML='<b></b><span class="sp"></span><button title="Правила проверки">Правила…</button><button>✕</button>';
  h.querySelector('b').textContent=(r.issues.length?'Замечаний: '+r.issues.length:'Замечаний нет ✓')+' · '+rules().P[rules().m].name;
  h.querySelectorAll('button')[0].onclick=rulesOpen;h.querySelectorAll('button')[1].onclick=()=>{L.hidden=true;};L.appendChild(h);
  const info=document.createElement('div');info.className='pp-empty';
  info.textContent='Площадь '+f1(r.area/1e6,4)+' м² · рез '+f1(r.cut/1000,2)+' м · врезок '+r.pierces+(rulesFor(p.it).s?' · толщина '+rulesFor(p.it).s+' мм':' · толщина в имени не найдена — правила «× s» не применяются');L.appendChild(info);
  r.issues.forEach((x,i)=>{const d=document.createElement('div');d.className='ovl'+(i===p.chk.cur?' cur':'');d.innerHTML='<b></b><span></span>';d.querySelector('b').textContent=numTxt(i);d.querySelector('span').textContent=x.text;
    d.onclick=()=>{p.chk.cur=i;const w=Math.max(x.bb[2]-x.bb[0],x.bb[3]-x.bb[1],10);const [wx,wy]=mApply(xfMat(p.xf),(x.bb[0]+x.bb[2])/2,(x.bb[1]+x.bb[3])/2);
      p.fitted=false;p.s=p.clampS(Math.min(p.W,p.H)/(w*4));p.cx=wx;p.cy=wy;p.draw();chkList(p);};L.appendChild(d);});
}
function chkPaint(p,c,d){
  const r=p.chk&&p.chk.r;if(!r)return;c.save();c.setTransform(d,0,0,d,0,0);c.font='bold 13px system-ui,sans-serif';c.textAlign='center';c.textBaseline='middle';
  r.issues.forEach((x,i)=>{const [X,Y]=m2s(p,x.x,x.y),cur=p.chk.cur===i;
    const a=m2s(p,x.bb[0],x.bb[1]),b=m2s(p,x.bb[2],x.bb[3]);c.strokeStyle='#ff8c4d';c.lineWidth=cur?2.5:1.5;c.setLineDash([5,3]);
    const rx=Math.min(a[0],b[0])-6,ry=Math.min(a[1],b[1])-6;c.strokeRect(rx,ry,Math.abs(b[0]-a[0])+12,Math.abs(b[1]-a[1])+12);c.setLineDash([]);
    c.fillStyle=cur?'#ffd23f':'#ff8c4d';c.beginPath();c.arc(rx,ry,10,0,Math.PI*2);c.fill();c.fillStyle='#111';c.fillText(String(i+1),rx,ry+0.5);});
  c.restore();
}
$('btnTable').onclick=tblOpen;$('tblClose').onclick=()=>{$('tblPanel').hidden=true;TBL.tok++;};
$('tblColBtn').onclick=tblCols;$('tblRules').onclick=rulesOpen;$('tblXlsx').onclick=tblExport;
$('tblMachine').onchange=e=>{rules().m=e.target.value;saveSet();rulesChanged();};
$('rulesClose').onclick=()=>{$('rulesPanel').hidden=true;};
$('vChk').onclick=()=>chkToggle();
/* ---------- поворот листа PDF: где текст лежит боком — предложить повернуть ---------- */
const PROT=new Map(Object.entries((()=>{try{return JSON.parse(localStorage.getItem('dxfv.prot')||'{}');}catch(e){return {};}})()));
function savePROT(){try{localStorage.setItem('dxfv.prot',JSON.stringify(Object.fromEntries(PROT)));}catch(e){}}
const SUGROT=new Map();
async function pdfSuggestRot(p,e){ // по направлению текста: если большая часть надписей идёт вертикально — лист повёрнут
  const key=p.it.key;let v=SUGROT.get(key);
  if(v===undefined){
    try{const tc=await e.page.getTextContent(),W={0:0,90:0,180:0,270:0};let all=0;
      for(const t of tc.items){const L=(t.str||'').trim().length;if(!L)continue;const a=Math.atan2(t.transform[1],t.transform[0])*180/Math.PI,b=((Math.round(a/90)*90)%360+360)%360;W[b]+=L;all+=L;}
      let best=0;for(const k in W)if(W[k]>W[best])best=+k;
      v=all>=20&&W[best]>=all*0.6?((best-(e.page.rotate||0))%360+360)%360:null;   // лишний поворот, при котором текст станет горизонтальным
    }catch(x){v=null;}
    SUGROT.set(key,v);
  }
  if(p.it&&p.it.key===key){p.sugRot=v;if(panes[VW.active]===p)updateBar();}
}
$('vPdfRot').onclick=()=>{const p=panes[VW.active];if(p&&p.sugRot!=null)p.pdfRotate(((p.sugRot-(p.prot||0))%360+360)%360);};
/* ---------- вписать по ширине ---------- */
function fitWidth(p){
  if(!p.doc||!p.W)return;
  if(p.isPdf&&p.pg.length){const e=p.curPage()||p.pg[0],w=p.cont?p.pw:e.w,s=p.W*0.98/w;p.fitted=false;p.s=p.clampS(s);p.cx=p.cont?p.pw/2:e.ox+e.w/2;
    p.cy=p.ph-e.oy-p.H/2/p.s+8/p.s;if(p.cont)p.clampCont();p.draw();p.changed();return;}
  const b=p.doc.bbox;if(!b)return;const M=xfMat(p.xf);let x0=Infinity,x1=-Infinity,y0=Infinity,y1=-Infinity;
  for(const [x,y] of [[b[0],b[1]],[b[2],b[1]],[b[0],b[3]],[b[2],b[3]]]){const q=mApply(M,x,y);x0=Math.min(x0,q[0]);x1=Math.max(x1,q[0]);y0=Math.min(y0,q[1]);y1=Math.max(y1,q[1]);}
  p.fitted=false;p.s=p.clampS(p.W*0.96/Math.max(x1-x0,1e-6));p.cx=(x0+x1)/2;p.cy=(y0+y1)/2;p.draw();p.changed();
}
$('vFitW').onclick=()=>{for(let k=0;k<VW.set.length;k++)fitWidth(panes[k]);};
/* ---------- лупа: удерживать Z или кнопка 🔍; в режиме лупы — колесо меняет увеличение, левая кнопка с удержанием — ещё ×2 ---------- */
const LOUPE={on:false,key:false,down:false,k:3,boost:false,p:null,x:0,y:0,tm:0,tok:0};
const LR=()=>({s:110,m:170,l:240}[SET.loupe]||170);   // радиус лупы, px
const loupeOn=()=>LOUPE.key||(LOUPE.on&&LOUPE.down);   // лупа видна: удерживается Z, или включена кнопкой и нажата левая кнопка мыши
function loupeOff(){LOUPE.on=false;LOUPE.key=false;LOUPE.down=false;LOUPE.boost=false;loupeSet();}
function loupeSet(){const on=loupeOn()&&viewerShown();$('vLoupe').classList.toggle('on',LOUPE.on);$('loupe').hidden=!on||!LOUPE.p;
  for(const p of panes)p.cv.style.cursor=on?'none':LOUPE.on?'zoom-in':(MEAS.on?'crosshair':'');if(on&&LOUPE.p)loupeDraw();}
function loupeK(f){LOUPE.k=Math.max(2,Math.min(16,Math.round(LOUPE.k*f*4)/4));SET.loupeK=LOUPE.k;saveSet();if(loupeOn())loupeDraw();else flash('Лупа ×'+String(LOUPE.k).replace('.',','));}
if(SET.loupeK>=2&&SET.loupeK<=16)LOUPE.k=SET.loupeK;
function loupeMove(p,x,y){LOUPE.p=p;LOUPE.x=x;LOUPE.y=y;if(!loupeOn())return;$('loupe').hidden=false;loupeDraw();}
function loupeDraw(){
  const p=LOUPE.p;if(!p||!p.doc||!viewerShown()){$('loupe').hidden=true;return;}const L=$('loupe'),R=LR(),d=devicePixelRatio||1,k=LOUPE.k*(LOUPE.boost?2:1);
  const r=p.cv.getBoundingClientRect(),lx=r.left+LOUPE.x-R,ly=r.top+LOUPE.y-R;L.style.left=lx+'px';L.style.top=ly+'px';
  const sr=$('stage').getBoundingClientRect(),ins=[Math.max(0,sr.top-ly),Math.max(0,lx+2*R-sr.right),Math.max(0,ly+2*R-sr.bottom),Math.max(0,sr.left-lx)];
  L.style.clipPath=ins.some(v=>v>0)?'inset('+ins.map(v=>v+'px').join(' ')+')':'';   // не выходить за окно просмотра (на панели и список)
  if(L.width!==2*R*d){L.width=L.height=2*R*d;L.style.width=L.style.height=2*R+'px';}
  const c=L.getContext('2d');c.setTransform(1,0,0,1,0,0);c.clearRect(0,0,L.width,L.height);c.save();c.beginPath();c.arc(R*d,R*d,R*d-1,0,Math.PI*2);c.clip();
  const [wx,wy]=p.s2w(LOUPE.x,LOUPE.y),s=p.s*k;
  if(!p.isPdf&&p.doc.bbox){c.fillStyle=dxfBg();c.fillRect(0,0,L.width,L.height);
    renderDoc(c,p.doc,{s,cx:wx,cy:wy,W:2*R,H:2*R,dpr:d,xf:p.xf,hidden:p.hidden,lw:SET.lw,texts:SET.texts,k:SET.lineK});}
  else{ // PDF: сразу — увеличенный кусок экрана, через миг — точная отрисовка этого места
    c.imageSmoothingEnabled=true;const sw=2*R*d/k;c.drawImage(p.cv,LOUPE.x*d-sw/2,LOUPE.y*d-sw/2,sw,sw,0,0,2*R*d,2*R*d);
    clearTimeout(LOUPE.tm);const tok=++LOUPE.tok;LOUPE.tm=setTimeout(()=>loupePdf(p,wx,wy,s,tok),110);}
  c.restore();c.lineWidth=2*d;c.strokeStyle='#ffd23f';c.beginPath();c.arc(R*d,R*d,R*d-1,0,Math.PI*2);c.stroke();
  c.strokeStyle='rgba(255,210,63,.6)';c.lineWidth=d;c.beginPath();c.moveTo(R*d-8*d,R*d);c.lineTo(R*d+8*d,R*d);c.moveTo(R*d,R*d-8*d);c.lineTo(R*d,R*d+8*d);c.stroke();
  c.fillStyle='rgba(16,18,22,.8)';c.fillRect(R*d-22*d,2*R*d-26*d,44*d,18*d);c.fillStyle='#ffd23f';c.font=(12*d)+'px system-ui,sans-serif';c.textAlign='center';c.textBaseline='middle';c.fillText('×'+k,R*d,2*R*d-17*d);
}
async function loupePdf(p,wx,wy,s,tok){
  const e=p.pg.find(e=>{const y=p.ph-wy;return y>=e.oy-1&&y<=e.oy+e.h+1;});if(!e||!e.page)return;
  const R=LR(),d=devicePixelRatio||1,S=s*d,x0=wx-e.ox-R/s,y0=(p.ph-wy)-e.oy-R/s;
  const c=document.createElement('canvas');c.width=c.height=2*R*d;
  try{await e.page.render({canvasContext:c.getContext('2d'),viewport:e.page.getViewport({scale:S,rotation:e.rot,offsetX:-x0*S,offsetY:-y0*S})}).promise;}catch(x){return;}
  if(tok!==LOUPE.tok||!loupeOn())return;
  const L=$('loupe').getContext('2d');L.save();L.beginPath();L.arc(R*d,R*d,R*d-1,0,Math.PI*2);L.clip();
  const px0=(0-x0)*S,py0=(0-y0)*S;L.beginPath();L.rect(px0,py0,e.w*S,e.h*S);L.clip();   // только сам лист — поля вокруг остаются как на экране
  const f=pdfFilter();if(f)L.filter=f;L.drawImage(c,0,0);L.restore();
  L.lineWidth=2*d;L.strokeStyle='#ffd23f';L.beginPath();L.arc(R*d,R*d,R*d-1,0,Math.PI*2);L.stroke();
  L.strokeStyle='rgba(217,130,43,.8)';L.lineWidth=d;L.beginPath();L.moveTo(R*d-8*d,R*d);L.lineTo(R*d+8*d,R*d);L.moveTo(R*d,R*d-8*d);L.lineTo(R*d,R*d+8*d);L.stroke();
  L.fillStyle='rgba(16,18,22,.8)';L.fillRect(R*d-22*d,2*R*d-26*d,44*d,18*d);L.fillStyle='#ffd23f';L.font=(12*d)+'px system-ui,sans-serif';L.textAlign='center';L.textBaseline='middle';L.fillText('×'+Math.round(s/p.s),R*d,2*R*d-17*d);
}
$('vLoupe').onclick=()=>{LOUPE.on=!LOUPE.on;LOUPE.down=false;if(LOUPE.on&&MEAS.on)measToggle(false);loupeSet();if(LOUPE.on)flash('Лупа: клик — показать лупу, водите курсором, колесо — сильнее/слабее; ещё клик — убрать. Перетаскивание и колесо без лупы — как обычно. Esc — выключить');};
document.addEventListener('keydown',e=>{if((e.key==='z'||e.key==='Z'||e.key==='я'||e.key==='Я')&&!e.ctrlKey&&!e.metaKey&&!e.repeat&&viewerShown()&&!/INPUT|TEXTAREA|SELECT/.test((e.target&&e.target.tagName)||'')){LOUPE.key=true;loupeSet();}});
document.addEventListener('keyup',e=>{if(e.key==='z'||e.key==='Z'||e.key==='я'||e.key==='Я'){LOUPE.key=false;loupeSet();}});
window.addEventListener('blur',()=>{LOUPE.key=false;LOUPE.boost=false;loupeSet();});

/* ---------- сохранить вид картинкой (PNG): всё, только PDF или только DXF; по желанию — в буфер обмена ---------- */
function pngOpen(){const M=$('pngMenu');M.hidden=!M.hidden;if(!M.hidden)menuFix(M,$('vPng'));$('pngClip').checked=!!SET.pngClip;
  const kinds=new Set(VW.set.map((x,i)=>panes[i]&&panes[i].isPdf?'pdf':'dxf'));$('pngOnlyPdf').disabled=!kinds.has('pdf');$('pngOnlyDxf').disabled=!kinds.has('dxf');}
async function pngSave(){
  const what=(document.querySelector('input[name=pngWhat]:checked')||{}).value||'all';$('pngMenu').hidden=true;
  const ps=panes.slice(0,VW.set.length).filter(p=>p.it&&(what==='all'||(what==='pdf')===!!p.isPdf));if(!ps.length){flash('Нечего сохранять');return;}
  const d=devicePixelRatio||1,stage=$('stage').getBoundingClientRect();
  let rects=ps.map(p=>{const r=p.cv.getBoundingClientRect();return {p,x:(r.left-stage.left)*d,y:(r.top-stage.top)*d,w:p.cv.width,h:p.cv.height};});
  if(what!=='all'){let x=0;rects=rects.map(r=>{const o=Object.assign({},r,{x,y:0});x+=r.w;return o;});}
  const W=Math.max(...rects.map(r=>r.x+r.w)),H=Math.max(...rects.map(r=>r.y+r.h)),C=document.createElement('canvas');C.width=Math.round(W);C.height=Math.round(H);
  const c=C.getContext('2d');c.fillStyle=getComputedStyle(document.body).backgroundColor||'#000';c.fillRect(0,0,C.width,C.height);
  for(const r of rects){c.drawImage(r.p.cv,r.x,r.y);   // в картинку попадает то, что на экране: размеры, проверка, сравнение
    const t=r.p.it.name+(r.p.dims()?'  ·  '+r.p.dims():'');c.font=(12*d)+'px system-ui,sans-serif';const tw=c.measureText(t).width+12*d;
    c.fillStyle='rgba(16,18,22,.8)';c.fillRect(r.x+6*d,r.y+6*d,tw,20*d);c.fillStyle='#e6e9ee';c.textBaseline='middle';c.fillText(t,r.x+12*d,r.y+16.5*d);}
  const blob=await new Promise(res=>C.toBlob(res,'image/png'));if(!blob){flash('Не удалось создать картинку');return;}
  const name=(ps[0].it.name.replace(/\.(dxf|pdf)$/i,'')+(ps.length>1?' и ещё '+(ps.length-1):'')+'.png').replace(/[\\/:*?"<>|]/g,'_');
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},2000);
  let clip='';if($('pngClip').checked){try{await navigator.clipboard.write([new ClipboardItem({'image/png':blob})]);clip=' и скопирована в буфер — можно вставить Ctrl+V';}catch(e){clip=' (в буфер скопировать не удалось: '+e.message+')';}}
  flash('Картинка сохранена: '+name+clip);
}
$('vPng').onclick=e=>{e.stopPropagation();pngOpen();};$('pngGo').onclick=pngSave;$('pngClip').onchange=e=>{SET.pngClip=e.target.checked;saveSet();};
document.addEventListener('click',e=>{if(!e.target.closest('#pngMenu')&&e.target.id!=='vPng')$('pngMenu').hidden=true;});
function cycleLineK(){const n=LINEMODES.length-(anyLw()?0:1);let i=(LINEMODES.indexOf(lineMode())+1)%n;const m=LINEMODES[i];
  SET.lw=m[1];SET.lineK=m[2];saveSet();panes.forEach(p=>p.draw());$('sLineK').value=String(SET.lineK);updateBar();flash('Линии DXF: '+m[0]);}
$('sScope').onchange=e=>{SET.pairScope=e.target.value;saveSet();if(VW.idx>=0&&viewerShown())showItem(VW.idx);};
$('sTexts').onchange=e=>{SET.texts=e.target.value==='1';saveSet();bgChanged();};
const CAPS=[['name','Имя файла'],['wrap','Имя полностью, в несколько строк'],['type','Тип (DXF / PDF)'],['size','Размер файла'],['date','Дата изменения'],['dir','Подпапка']];
function fillCaps(){
  const T=$('capT');T.innerHTML='<tr><th></th><th>Сетка</th><th>Список</th></tr>';
  for(const [k,t] of CAPS){
    const tr=document.createElement('tr');tr.innerHTML='<td></td><td></td><td></td>';tr.children[0].textContent=t;
    for(const [i,key] of [[1,'capGrid'],[2,'capList']]){
      if(k==='wrap'&&key==='capList'){tr.children[i].textContent='всегда';tr.children[i].style.color='var(--mut)';tr.children[i].style.fontSize='11px';continue;}
      const cb=document.createElement('input');cb.type='checkbox';cb.checked=!!SET[key][k];
      cb.onchange=()=>{SET[key][k]=cb.checked?1:0;saveSet();applyCaps();};tr.children[i].appendChild(cb);
    }
    T.appendChild(tr);
  }
}
const CAPV=[['name','Имя файла'],['dims','Габарит / формат листа'],['spec','Материал · толщина · кол-во'],['dir','Подпапка'],['date','Дата изменения'],['size','Размер файла'],['single','Подпись и при одном файле']];
function fillCapV(){const B=$('capV');B.textContent='';
  for(const [k,t] of CAPV){const l=document.createElement('label');const cb=document.createElement('input');cb.type='checkbox';cb.checked=!!SET.capV[k];
    cb.onchange=()=>{SET.capV[k]=cb.checked?1:0;saveSet();layoutStage();panes.forEach(p=>p.renderCap());};l.append(cb,' '+t);B.appendChild(l);}}
function fillXf(){$('xfCount').textContent=XFS.size?`Повёрнуто при просмотре: ${XFS.size} файл.`:'Повёрнутых файлов нет';$('xfResetAll').disabled=!XFS.size;}
$('xfResetAll').onclick=()=>{
  if(!confirm(`Вернуть все ${XFS.size} повёрнутых DXF в положение как в файле?`))return;
  XFS.clear();LS.set('xf',{});
  for(const p of panes)if(p.doc&&!p.isPdf&&p.doc.bbox){p.orig=false;p.keepXf=null;p.applyXf({rot:0,mirror:false});p.onUpdate();}
  updXfBadges();fillXf();
};
$('btnSet').onclick=()=>{closePairPanel();$('pinPanel').hidden=true;const p=$('setPanel');p.hidden=!p.hidden;if(!p.hidden){fillBgSel();fillCaps();fillCapV();fillXf();}};
$('setClose').onclick=()=>{$('setPanel').hidden=true;};

/* =====================================================================
   ЯРЛЫКИ: закреплённые папки (изделие или узел внутри) и файлы
   {id, kind:'folder'|'file', root (id сохранённого доступа), rootName, dir|path, label}
   ===================================================================== */
let PINS=LS.get('pins',[]);if(!Array.isArray(PINS))PINS=[];
const savePins=()=>LS.set('pins',PINS);
function pinAdd(p){
  if(!p.root){flash('Для ярлыка откройте папку кнопкой «Папка» или перетаскиванием — тогда браузер запомнит доступ к ней');return;}
  const same=PINS.find(x=>x.kind===p.kind&&x.root===p.root&&(x.dir||'')===(p.dir||'')&&(x.path||'')===(p.path||''));
  if(same){flash('Такой ярлык уже есть: «'+same.label+'»');return;}
  PINS.push(Object.assign({id:'p'+Date.now().toString(36)},p));savePins();
  flash('Добавлен ярлык «'+p.label+'»');if(!$('pinPanel').hidden)renderPins();
}
function curFolderPin(){
  const it=items[0];if(!it||!it.rid)return null;
  const root=TREE_ROOT?TREE_ROOT.path:it.rootName;const dir=curDir||root;
  return {kind:'folder',root:it.rid,rootName:it.rootName,dir,label:dir.split('/').pop()||it.rootName};
}
function renderPins(){
  const A=$('pinAdd');A.textContent='';A.className='pin-add';
  const fp=curFolderPin(),cur=VW.set.length?curItem():null;
  if(fp){const b=document.createElement('button');b.textContent='＋ Папка: '+fp.dir.split('/').join(' / ');b.onclick=()=>pinAdd(fp);A.appendChild(b);}
  if(cur&&cur.rid){const b=document.createElement('button');b.textContent='＋ Файл: '+cur.name;
    b.onclick=()=>pinAdd({kind:'file',root:cur.rid,rootName:cur.rootName,path:cur.path,label:cur.name});A.appendChild(b);}
  if(!A.children.length)A.hidden=true;else A.hidden=false;
  const L=$('pinList');L.textContent='';
  PINS.forEach((p,i)=>{
    const r=document.createElement('div');r.className='pin'+(FSA?'':' off');
    r.innerHTML='<span class="pi"></span><span class="pt"><div class="pl"></div><div class="pp"></div></span><button title="Выше">↑</button><button title="Переименовать">✎</button><button title="Удалить ярлык">✕</button>';
    r.children[0].textContent=p.kind==='file'?(/\.pdf$/i.test(p.path)?'📄':'📐'):'📁';
    r.querySelector('.pl').textContent=p.label;
    r.querySelector('.pp').textContent=(p.kind==='file'?p.path.split('/').slice(0,-1):p.dir.split('/')).join(' / ');
    const [up,ren,del]=r.querySelectorAll('button');
    up.hidden=i===0;
    up.onclick=e=>{e.stopPropagation();PINS.splice(i-1,0,PINS.splice(i,1)[0]);savePins();renderPins();};
    ren.onclick=e=>{e.stopPropagation();const v=prompt('Название ярлыка',p.label);if(v&&v.trim()){p.label=v.trim();savePins();renderPins();}};
    del.onclick=e=>{e.stopPropagation();if(confirm('Удалить ярлык «'+p.label+'»?')){PINS.splice(i,1);savePins();renderPins();}};
    r.onclick=()=>pinOpen(p);
    L.appendChild(r);
  });
  if(!PINS.length)L.innerHTML='<div class="pp-empty">Ярлыков пока нет. Откройте папку изделия и нажмите «＋ Папка» — или ★ у записи в истории.</div>';
  $('pinFoot').textContent=FSA?'Клик — открыть. При первом открытии за сеанс браузер спросит разрешение на чтение папки.'
    :'На этом устройстве браузер не позволяет открывать папки по ярлыку — работает только на ПК.';
}
async function pinOpen(p){
  if(!FSA){flash('Ярлыки работают только на ПК в Chrome');return;}
  const r=await IDB.get(p.root,'roots');if(!r||!r.h){flash('Доступ к «'+p.rootName+'» не сохранился — откройте папку заново и пересоздайте ярлык');return;}
  try{let q=await r.h.queryPermission({mode:'read'});if(q!=='granted')q=await r.h.requestPermission({mode:'read'});if(q!=='granted')return;}
  catch(err){flash('Нет доступа: '+err.message);return;}
  $('pinPanel').hidden=true;
  try{
    if(r.kind==='directory'){
      if(!items.length||items[0].rid!==p.root){if(VW.full)setFull(false);await openDirHandle(r.h);}
      if(p.kind==='folder'){
        if(p.dir&&p.dir!==p.rootName&&p.dir!==(TREE_ROOT&&TREE_ROOT.path)){
          if(!items.some(x=>x.path.startsWith(p.dir+'/'))){flash('Папка «'+p.label+'» не найдена — возможно, переименована');return;}
          $('typeSel').value='';$('filter').value='';setDir(p.dir);if(!SET.tree){SET.tree=true;saveSet();renderTree();}
        }else{$('filter').value='';}   // всё изделие: остаётся то, на чём остановились в прошлый раз
      }else{const it=items.find(x=>x.path===p.path);if(!it){flash('Файл «'+p.label+'» не найден — возможно, удалён или переименован');return;}
        jumpTo(it);if(!docked())setFull(true);}
    }else{const f=await r.h.getFile();setFiles([{file:f,path:f.name,rid:p.root}],{rootName:''});showItem(0);if(!docked())setFull(true);}
  }catch(err){flash('Сервер или папка недоступны: '+(err.message||err));}
}
$('btnPins').onclick=()=>{$('setPanel').hidden=true;$('cmpPanel').hidden=true;closePairPanel();const P=$('pinPanel');P.hidden=!P.hidden;if(!P.hidden)renderPins();};
$('pinClose').onclick=()=>{$('pinPanel').hidden=true;};
$('vPin').onclick=()=>{const it=curItem();if(it)pinAdd({kind:'file',root:it.rid,rootName:it.rootName,path:it.path,label:it.name});};

/* =====================================================================
   ВТОРОЙ МОНИТОР: отдельное окно показывает пару текущего файла.
   Основное окно — DXF → на втором чертёж; основное — PDF → на втором его развёртки.
   «⇄ поменять» (Tab) — основное окно переходит к паре, второе показывает противоположное.
   ===================================================================== */
const FOLLOW=location.hash==='#second';
const MON={win:null,timer:0};
const monOn=()=>!FOLLOW&&!!MON.win&&!MON.win.closed;
function monSwap(){SET.monMain=SET.monMain==='pdf'?'dxf':'pdf';saveSet();if(VW.idx>=0)showItem(VW.idx);
  flash('Основной монитор: '+(SET.monMain==='pdf'?'чертежи PDF':'развёртки DXF')+', второй: '+(SET.monMain==='pdf'?'развёртки DXF':'чертежи PDF'));}
function monTab(d){ // Tab при двух мониторах: на основном несколько исполнений — по ним, иначе поменять мониторы
  const mine=(VW.kit||[]).filter(x=>x.type===SET.monMain);
  if(SET.monMain==='dxf'&&mine.length>1){const k=mine.indexOf(VW.set[0]);jumpTo(mine[(k+d+mine.length)%mine.length]);}else monSwap();
}
function monSync(){
  if(!monOn())return;
  const it=view[VW.idx];const list=it?(VW.monList||[]):[];
  try{MON.win.postMessage({t:'show',from:it?it.name:'',list:list.map(x=>({file:x.file,path:x.path,key:x.key,name:x.name,rid:x.rid||null,rootName:x.rootName,dups:x.dups?x.dups.map(y=>y.path):null}))},'*');}catch(e){}
}
async function openSecond(){
  if(MON.win&&!MON.win.closed){MON.win.close();MON.win=null;if(VW.idx>=0&&viewerShown())showItem(VW.idx);else updateBar();return;}
  let feat='popup,width=1100,height=800',o=null,asked=false;
  if('getScreenDetails' in window){ // сначала — какой экран второй (Chrome один раз спросит «управление окнами»)
    try{const st=await navigator.permissions.query({name:'window-management'}).catch(()=>null);asked=!st||st.state==='prompt';
      const sd=await getScreenDetails();const cur=sd.currentScreen;o=sd.screens.find(x=>x!==cur)||null;
      if(o)feat=`popup,left=${o.availLeft},top=${o.availTop},width=${o.availWidth},height=${o.availHeight}`;}
    catch(e){flash('Без разрешения «Управление окнами» Chrome не переносит окно на второй экран — перетащите его вручную (Win+Shift+→)');}
  }
  const w=window.open(location.href.split('#')[0]+'#second','dxfv-second',feat);
  if(!w){flash(asked?'Разрешение получено — нажмите «2-й монитор» ещё раз':'Браузер заблокировал второе окно — разрешите всплывающие окна для этого сайта (значок в адресной строке)');return;}
  if(o){try{w.moveTo(o.availLeft,o.availTop);w.resizeTo(o.availWidth,o.availHeight);}catch(e){}}
  MON.win=w;updateBar();
  clearInterval(MON.timer);MON.timer=setInterval(()=>{if(!MON.win||MON.win.closed){clearInterval(MON.timer);MON.win=null;if(VW.idx>=0&&viewerShown())showItem(VW.idx);else updateBar();}},1000);
}
window.addEventListener('message',e=>{
  const d=e.data;if(!d||typeof d!=='object')return;
  if(!FOLLOW&&MON.win&&e.source===MON.win){
    if(d.t==='ready'){if(VW.idx>=0&&viewerShown())showItem(VW.idx);else monSync();}
    else if(d.t==='swap')monSwap();
    else if(d.t==='key'){const k=d.key;
      if(k==='Tab')monTab(d.shift?-1:1);
      else if(/^(ArrowRight|ArrowDown|PageDown| )$/.test(k)){if(viewerShown())step(1);else{VW.idx=Math.min(view.length-1,VW.idx+1);markCurrent(view[VW.idx]);monSync();}}
      else if(/^(ArrowLeft|ArrowUp|PageUp)$/.test(k)){if(viewerShown())step(-1);else{VW.idx=Math.max(0,VW.idx-1);markCurrent(view[VW.idx]);monSync();}}}
  }
  if(FOLLOW&&e.source===window.opener&&d.t==='show')followerShow(d);
  if(FOLLOW&&e.source===window.opener&&d.t==='set'){Object.assign(SET,LS.get('set',{}));applyTheme();colCache.clear();panes.forEach(p=>p.draw());}
});
const FMAP=new Map();let FFROM='';
function followerSend(m){try{window.opener&&window.opener.postMessage(m,'*');}catch(e){}}
function followerShow(d){
  FFROM=d.from||'';
  const set=d.list.map(x=>{let it=FMAP.get(x.key);if(!it){it=makeItem(x.file,x.path,x.rid,x.rootName||'');it.key=x.key;it.state=2;FMAP.set(x.key,it);}
    it.dups=x.dups?x.dups.map(p=>({path:p})):null;return it;});
  if(set.length>10)set.length=10;
  showSet(set,0);
  if(!set.length){$('stageMsg').hidden=false;$('stageMsg').textContent=FFROM?'Для «'+FFROM+'» пара не найдена':'Откройте файл в основном окне';}
}
function followerBar(){
  $('vClose').hidden=false;$('vClose').title='Закрыть второй экран';
  $('vPrev').hidden=$('vNext').hidden=false;
  for(const id of ['vPairMenu','vSide','vPin','vMon','vSync'])$(id).hidden=true;
  const fb=$('vFull');fb.hidden=false;fb.textContent=document.fullscreenElement?'🗗':'⛶';fb.title='Во весь экран (F11)';
  fb.onclick=()=>{document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen().catch(()=>{});setTimeout(followerBar,300);};
  const b=$('vPair');b.hidden=false;b.classList.remove('none');b.textContent='⇄ поменять';b.title='Поменять мониторы местами: основное окно перейдёт к паре (Tab)';
  if(!VW.set.length)$('vName').textContent=FFROM?'Пара для «'+FFROM+'» не найдена':'Второй монитор — ждёт файл из основного окна';
}
if(FOLLOW){
  document.body.classList.add('follower');document.title='DXF — второй монитор';
  VW.full=true;
  $('vClose').onclick=()=>window.close();
  $('vPrev').onclick=()=>followerSend({t:'key',key:'ArrowLeft'});
  $('vNext').onclick=()=>followerSend({t:'key',key:'ArrowRight'});
  window.addEventListener('load',()=>followerSend({t:'ready'}));setTimeout(()=>followerSend({t:'ready'}),300);
}
// настройки и повороты меняются в основном окне — второе подхватывает их сразу
window.addEventListener('storage',e=>{if(!FOLLOW)return;
  if(e.key==='dxfv.set'){Object.assign(SET,LS.get('set',{}));applyTheme();colCache.clear();panes.forEach(p=>p.draw());}
  if(e.key==='dxfv.xf'){XFS.clear();for(const [k,v] of Object.entries(LS.get('xf',{})))XFS.set(k,v);
    for(const p of panes)if(p.doc&&!p.isPdf&&p.it){const x=XFS.get(xfKey(p.it))||{rot:0,mirror:false};p.applyXf(x);p.onUpdate();}}});

/* =====================================================================
   СРАВНЕНИЕ С ДРУГОЙ ПАПКОЙ и ручное сравнение двух файлов (Ctrl+клик)
   Пары — по обозначению (децимальный номер / начало имени), один тип с одним типом.
   = совпадает (то же имя и размер) · ≠ отличается (другое имя или размер) · нов — в другой папке нет
   ===================================================================== */
let CMP=null;const SEL=new Set();
function cmpKey(it){
  const P=pkeys(it);let d;
  if(P.dec)d=P.dec+(P.exec?'-'+P.exec:'');
  else if(it.type==='dxf')d=P.desig;
  else{const t=P.b.split(' ')[0];d=t.length>=3&&/\d/.test(t)?t:P.b;}
  return it.type+':'+d;
}
/* части имени для сравнения: DXF — обозначение, материал, толщина, количество; PDF — обозначение, наименование */
function nameParts(it){
  const base=it.name.replace(/\.(dxf|pdf)$/i,'');
  if(it.type==='pdf'){const d=DEC.exec(nrm(it.name));const m=/^(\S*\d\S*)\s+(.*)$/.exec(base);
    return {desig:m?m[1]:(d?d[0]:base),title:m?m[2].trim():''};}
  const b=base.replace(/[-_ ](form|flat|развертка|развёртка|розгортка)$/i,'');
  let m=/^(.*?)-([^-]+)-(\d+(?:[.,]\d+)?)-[kKкК](\d+)$/.exec(b);
  if(m)return {desig:m[1],mat:m[2],thk:m[3].replace(',','.'),qty:m[4]};
  // старые имена: «… Основа_Ст3_S10-1шт»
  const q=/(\d+)\s*шт/i.exec(b),t=/(?:^|[\s_-])[SsСс](\d+(?:[.,]\d+)?)(?=$|[\s_-])/.exec(b),mt=/(?:^|[\s_-])((?:Ст|St|AISI|Cynk|Al|08пс|09Г2С|65Г|Zn)[\w.]*)/i.exec(b);
  const d=/^(\S*\d[\S]*?)(?=[\s_]|-[^\d]|$)/.exec(b);
  return {desig:d?d[1]:b,mat:mt?mt[1]:'',thk:t?t[1].replace(',','.'):'',qty:q?q[1]:''};
}
const PART_N={desig:'обозначение',title:'наименование',mat:'материал',thk:'толщина',qty:'количество'};
function nameChanges(a,b){ // что поменялось в имени: [{k,from,to}]  (a — открытая папка, b — та, с которой сравниваем)
  const A=nameParts(a),B=nameParts(b),out=[];
  for(const k of Object.keys(PART_N))if(k in A||k in B){const x=(A[k]||'').toLowerCase(),y=(B[k]||'').toLowerCase();if(x!==y)out.push({k,from:B[k]||'—',to:A[k]||'—'});}
  if(!out.length&&a.name!==b.name)out.push({k:'name',from:b.name,to:a.name});
  return out;
}
const chText=ch=>ch.map(c=>(PART_N[c.k]||'имя')+': '+c.from+' → '+c.to).join('; ');
/* сравнение с другой папкой. Сравнивается папка, выбранная в дереве (или вся открытая, если ничего не выбрано).
   Пары — по обозначению; содержимое проверяется в фоне (cmpDeep). Статусы:
     same — одинаковые; name — имя изменено, содержимое то же; geo — пересохранён, геометрия DXF та же;
     diff — отличается; ren — переименован (пары по обозначению нет, но такой же файл есть под другим именем); new — нет в той папке */
function cmpSet(arr,name,rid){
  const ct=$('grid').querySelector('.tile.cur'),focus=docked()&&!VW.full?curItem():(ct&&ct._it)||(SEL.size===1?[...SEL][0]:null)||null;  // выделенный файл — сразу открыть его сравнение
  const scope=items.filter(it=>!curDir||it.path.startsWith(curDir+'/'));
  const paths=new Set(scope.map(it=>it.path+'|'+it.file.size));
  if(arr.length&&arr.every(x=>paths.has(x.path+'|'+x.file.size))){flash('Для сравнения выбрана та же папка, что открыта, — выберите другую (старый заказ, архив)');return;}
  const bItems=arr.filter(x=>/\.(dxf|pdf)$/i.test(x.file.name)).map(x=>{const it=makeItem(x.file,x.path,rid||null,name);it.state=2;it.cmpB=true;return it;});
  const byKey=new Map();for(const b of bItems){const k=cmpKey(b);if(!byKey.has(k))byKey.set(k,[]);byKey.get(k).push(b);}
  const used=new Set(),map=new Map();
  for(const a of scope){
    const c=byKey.get(cmpKey(a));
    if(!c){map.set(a,{st:'new'});continue;}
    c.forEach(x=>used.add(x));
    const best=c.find(x=>fname(x.path)===fname(a.path))||c.slice().sort((x,y)=>y.file.lastModified-x.file.lastModified)[0];
    const ch=nameChanges(a,best);
    map.set(a,{st:!ch.length&&best.file.size===a.file.size?'same':'diff',b:best,others:c,ch,why:ch.length?chText(ch):'',pend:true});
  }
  CMP={name,rid,items:bItems,map,onlyB:bItems.filter(b=>!used.has(b)),filter:'',scope:curDir};
  $('cmpFilter').value='';updCmp();applyFilter();
  cmpDeep(CMP);
  if(focus&&map.has(focus))cmpOpenFor(focus);
}
function cmpMatch(it,cf){const st=(CMP.map.get(it)||{}).st;return cf==='chg'?(st==='diff'||st==='geo'||st==='name'||st==='ren'):st===cf;}
/* точная проверка в фоне: побайтно; DXF с разным содержимым — по геометрии; непарные — поиск переименованных */
async function cmpDeep(C){
  const pairs=[...C.map.entries()].filter(([a,c])=>c.b);
  const lone=[...C.map.entries()].filter(([a,c])=>c.st==='new');
  C.deep={n:pairs.length+lone.length,done:0};updCmp();
  const eqBytes=async(f1,f2)=>{if(f1.size!==f2.size)return false;const [x,y]=await Promise.all([f1.arrayBuffer(),f2.arrayBuffer()]);
    const A=new Uint8Array(x),B=new Uint8Array(y);for(let i=0;i<A.length;i++)if(A[i]!==B[i])return false;return true;};
  const tick=a=>{C.deep.done++;if(C.deep.done%5===0||C.deep.done===C.deep.n){updCmp();if(CMP&&CMP.filter)applyFilter();}else updBadge(a);};
  for(const [a,c] of pairs){
    if(CMP!==C)return;
    try{
      const nm=c.ch.length?chText(c.ch):'';
      if(await eqBytes(a.file,c.b.file)){c.st=c.ch.length?'name':'same';c.why=nm;}
      else if(a.type==='dxf'&&c.b.type==='dxf'){
        const [da,db]=await Promise.all([getDoc(a),getDoc(c.b)]);if(CMP!==C)return;
        const r=await geoCompare(da,db,SET.tol);if(CMP!==C)return;
        c.geo=r.same?0:(r.clusters||[]).length;
        if(r.same){c.st='geo';c.why=[nm,'файл пересохранён, геометрия та же (допуск '+SET.tol+' мм)'].filter(Boolean).join('; ');}
        else{c.st='diff';c.why=[nm,'геометрия отличается'+(r.fail?': '+r.fail:' (мест: '+r.clusters.length+')')].filter(Boolean).join('; ');}
      }else{c.st='diff';c.why=[nm,'содержимое отличается'].filter(Boolean).join('; ');}
    }catch(e){c.why=(c.why?c.why+'; ':'')+'не проверено: '+e.message;}
    c.pend=false;tick(a);
  }
  // переименованные: такой же файл (побайтно) лежит там под другим обозначением
  const pool=C.onlyB.slice();
  for(const [a,c] of lone){
    if(CMP!==C)return;
    try{for(const b of pool){if(b.type!==a.type||b.file.size!==a.file.size)continue;
      if(await eqBytes(a.file,b.file)){c.st='ren';c.b=b;c.ch=nameChanges(a,b);c.why=chText(c.ch);pool.splice(pool.indexOf(b),1);C.onlyB.splice(C.onlyB.indexOf(b),1);break;}}}catch(e){}
    tick(a);
  }
  C.deep=null;updCmp();if(CMP&&CMP.filter)applyFilter();
}
const CMP_TXT={same:'=',name:'имя',geo:'≈',diff:'≠',ren:'⇢',new:'нов'};
function updBadge(it){const c=CMP&&CMP.map.get(it),b=it.cmpb;
    if(!c){b.hidden=true;return;}
    b.hidden=false;b.className='cmpb '+c.st+(c.pend&&CMP.deep?' pend':'');b.textContent=CMP_TXT[c.st];
    const more=c.others&&c.others.length>1?' ('+c.others.length+' версии там)':'',W='«'+CMP.name+'»';
    b.title=c.pend&&CMP.deep?'Проверяется содержимое…'
      :c.st==='same'?'Одинаковый с '+W+' — клик: открыть рядом'
      :c.st==='name'?'Имя изменено, содержимое то же: '+c.why+' — клик: открыть рядом'
      :c.st==='geo'?'Пересохранён: '+c.why+' — клик: открыть рядом'+more
      :c.st==='diff'?'Отличается от '+W+': '+(c.why||'содержимое')+' — клик: открыть рядом'+more
      :c.st==='ren'?'Переименован: '+c.why+' — клик: открыть рядом'
      :'В '+W+' такого файла нет'+(it.type==='dxf'?' — клик: выбрать деталь для сравнения вручную':'');}
function updCmp(){
  for(const it of items)updBadge(it);
  $('cmpBar').hidden=!CMP;$('btnCmp').classList.toggle('on',!!CMP);
  if(!CMP)return;
  const n={same:0,name:0,geo:0,diff:0,ren:0,new:0};for(const c of CMP.map.values())n[c.st]++;
  $('cmpInfo').innerHTML='';const s=document.createElement('span');
  const part=(k,t)=>n[k]?' · <b>'+CMP_TXT[k]+' '+n[k]+'</b> '+t:'';
  s.innerHTML='<b></b> ⇆ <b></b>: '+(part('same','одинаковые')+part('name','имя изменено')+part('geo','пересохранены')+part('diff','отличаются')+part('ren','переименованы')+part('new','новые')).slice(3)+
    (CMP.deep?' · <i>проверка '+CMP.deep.done+' / '+CMP.deep.n+'…</i>':'');
  const bs=s.querySelectorAll('b');bs[0].textContent=CMP.scope?CMP.scope.split('/').pop():(items[0]?items[0].path.split('/')[0]:'');bs[1].textContent=CMP.name;$('cmpInfo').appendChild(s);
  $('cmpOnlyBtn').textContent='Только там: '+CMP.onlyB.length;$('cmpOnlyBtn').disabled=!CMP.onlyB.length;
}
function cmpEnd(){CMP=null;if(VW.cmp&&!VW.cmp.manual){VW.cmp=null;if(VW.idx>=0&&viewerShown())showItem(VW.idx);}updCmp();applyFilter();}
function cmpOpen(a,b,manual){
  const i=view.indexOf(a);if(i>=0){VW.idx=i;markCurrent(a);}
  closePairPanel();showSet([a,b],0);VW.cmp={a,b,manual:!!manual};updateBar();
  if(!docked())setFull(true);
  if(a.type==='dxf'&&b.type==='dxf'&&SET.cmpGeo!==false){ovStart();return;}
  setTimeout(()=>{const p=panes[0];if(p&&p.doc&&SET.sync)p.changed();},400);
}
/* =====================================================================
   СРАВНЕНИЕ ДВУХ DXF: детали совмещаются (авто + вручную), отличия подсвечены и описаны словами.
   Вид «две панели» (по умолчанию): слева открытая деталь, справа — с которой сравниваем, повёрнутая так же;
     масштаб и сдвиг общие; красное — есть только слева, зелёное — только справа; ①②③ — номера отличий.
   Вид «наложение» (N): обе детали в одном окне. Мигание (пробел, включается в настройках) — по очереди то одна, то другая.
   ===================================================================== */
let OV=null;
if(!(SET.tol>0))SET.tol=0.1;
if(SET.cmpView!=='over')SET.cmpView='two';
function ovClear(){OV=null;for(const p of panes)if(p.ov){p.ov=null;}$('ovBar').hidden=true;$('ovList').hidden=true;}
function ovPanes(){return panes.filter(p=>p.ov);}
async function ovStart(M,keepView){
  const c=VW.cmp||(OV&&{a:OV.a,b:OV.b,manual:true});if(!c)return;const a=c.a,b=c.b;
  if(a.type!=='dxf'||b.type!=='dxf'){flash('Сравнение контуров — только для двух DXF');return;}
  VW.plain=false;
  const tok={},again=OV&&OV.a===a&&OV.b===b&&OV.res;   // пересчёт после ручной подгонки — старая картинка видна до готовности
  if(again)OV.tok=tok;else OV={a,b,tok,keep:true,mode:SET.cmpView,blink:null,M:M||null};
  OV.keep=true;
  if(OV.mode==='over'){if(!(VW.set.length===1&&panes[0]&&panes[0].it===a))showSet([a],0);}
  else if(!(VW.set.length===2&&panes[0]&&panes[0].it===a&&panes[1]&&panes[1].it===b))showSet([a,b],0);
  OV.keep=false;VW.cmp=c;
  if(!again)for(const p of panes.slice(0,VW.set.length))p.ov={busy:true};
  $('ovBar').hidden=false;
  const top=x=>x.path.split('/')[0],same=a.name===b.name;
  $('ovNa').textContent=(OV.mode==='over'?'только в ':'слева: ')+(same?top(a):a.name);$('ovNa').parentNode.title='Красным — есть только в «'+a.path+'»';
  $('ovNb').textContent=(OV.mode==='over'?'только в ':'справа: ')+(same?(b.cmpB&&CMP?CMP.name:top(b)):b.name);$('ovNb').parentNode.title='Зелёным — есть только в «'+b.path+'»';
  $('ovMode').textContent=OV.mode==='over'?'Две панели':'Наложение';
  $('ovTol').value=String(SET.tol);$('ovRes').className='';$('ovRes').textContent=again?'Пересчитываю…':'Сравниваю…';$('ovNum').textContent='';
  updateBar();
  let da,db;try{[da,db]=await Promise.all([getDoc(a),getDoc(b)]);}catch(e){if(OV&&OV.tok===tok)$('ovRes').textContent='Файл не открылся';return;}
  if(!OV||OV.tok!==tok)return;
  let r;const t0=performance.now();
  try{r=await geoCompare(da,db,SET.tol,M||null);}catch(e){if(OV&&OV.tok===tok)$('ovRes').textContent='Не удалось сравнить: '+e.message;return;}
  if(!OV||OV.tok!==tok)return;
  if(r.fail){$('ovRes').textContent=r.fail;return;}
  if(M&&OV.M!==M)return;   // пока считали, деталь сдвинули ещё — дождаться следующего пересчёта
  OV.res=r;OV.M=r.M;OV.D=null;OV.cur=-1;OV.ms=Math.round(performance.now()-t0);
  const bb=r.bbA.slice();for(const o of r.LB)for(let i=0;i<o.length;i+=2){bb[0]=Math.min(bb[0],o[i]);bb[1]=Math.min(bb[1],o[i+1]);bb[2]=Math.max(bb[2],o[i]);bb[3]=Math.max(bb[3],o[i+1]);}
  const sides=OV.mode==='over'?['both']:['a','b'];
  sides.forEach((sd,i)=>{const p=panes[i];if(!p)return;p.ov={res:r,bb,side:sd};if(!keepView){p.fitted=true;p.applyView('fit');}else p.draw();});
  ovInfo();ovRenderList();
}
function ovInfo(){
  const r=OV&&OV.res;if(!r)return;const e=$('ovRes'),n=r.clusters.length;
  const sz=v=>fmt(v[0])+'×'+fmt(v[1]);
  if(r.same){e.className='ok';e.textContent='✓ Совпадает (допуск '+SET.tol+' мм)';}
  else{e.className='bad';e.textContent='Отличий: '+n;}
  e.title='Совпадает '+Math.floor(r.a.frac*1000)/10+'% контура слева и '+Math.floor(r.b.frac*1000)/10+'% справа · габарит '+sz(r.sizeA)+' и '+sz(r.sizeB)+(r.mir?' · вторая деталь отражена':'')+' · '+OV.ms+' мс';
  $('ovNum').textContent=n?(OV.cur>=0?(OV.cur+1)+' / '+n:''):'';
  $('ovPrev').disabled=$('ovNext').disabled=$('ovListBtn').disabled=!n;
  $('ovListBtn').textContent='Список отличий'+(n?' ('+n+')':'')+' ▾';
}
const CIRC='①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳';
const numTxt=i=>i<20?CIRC[i]:'('+(i+1)+')';
function ovRenderList(){
  const L=$('ovList'),r=OV&&OV.res;L.textContent='';if(!r)return;
  if(!r.clusters.length){L.innerHTML='<div class="pp-empty">Отличий нет</div>';return;}
  (r.desc&&r.desc.length?r.desc:r.clusters.map(bb=>({bb,text:'отличие'}))).forEach((d,i)=>{
    const row=document.createElement('div');row.className='ovl'+(i===OV.cur?' cur':'');row.innerHTML='<b></b><span></span>';
    row.querySelector('b').textContent=numTxt(i);row.querySelector('span').textContent=d.text;
    row.onclick=()=>{OV.cur=i-1;ovGo(1);};L.appendChild(row);});
}
function ovGo(d){
  const r=OV&&OV.res;if(!r||!r.clusters.length)return;const n=r.clusters.length;
  OV.cur=OV.cur<0?(d>0?0:n-1):(OV.cur+d+n)%n;const c=r.clusters[OV.cur];
  const w=Math.max(c[2]-c[0],c[3]-c[1],Math.max(r.sizeA[0],r.sizeA[1])*0.04);
  for(const p of ovPanes()){const s=Math.min(p.W/(w*2.4),p.H/(w*2.4));p.fitted=false;p.s=p.clampS(s);p.cx=(c[0]+c[2])/2;p.cy=(c[1]+c[3])/2;p.draw();}
  ovInfo();ovRenderList();
  const t=r.desc&&r.desc[OV.cur];if(t)flash(numTxt(OV.cur)+' '+t.text);
}
/* ручная подгонка второй детали: сдвиг (Shift+перетаскивание), поворот на 90°, зеркало — затем пересчёт отличий */
function ovApply(D){
  if(!OV||!OV.res)return;OV.M=GEO.mul(D,OV.M);OV.D=OV.D?GEO.mul(D,OV.D):D;for(const p of ovPanes())p.draw();
  clearTimeout(OV.t);OV.t=setTimeout(()=>ovStart(OV.M,true),250);
}
function ovNudge(p,dx,dy){ovApply([1,0,0,1,dx,dy]);}
function ovCenterB(){const r=OV.res,L=r.LB;let x0=Infinity,y0=Infinity,x1=-Infinity,y1=-Infinity;const D=OV.D||[1,0,0,1,0,0];
  for(const o of L)for(let i=0;i<o.length;i+=2){const x=D[0]*o[i]+D[2]*o[i+1]+D[4],y=D[1]*o[i]+D[3]*o[i+1]+D[5];x0=Math.min(x0,x);x1=Math.max(x1,x);y0=Math.min(y0,y);y1=Math.max(y1,y);}
  return [(x0+x1)/2,(y0+y1)/2];}
function ovRot(deg,mir){if(!OV||!OV.res)return;const [cx,cy]=ovCenterB(),a=deg*Math.PI/180,c=Math.cos(a),s=Math.sin(a),m=mir?-1:1;
  const R=[c*m,s*m,-s,c,0,0];ovApply(GEO.mul([1,0,0,1,cx,cy],GEO.mul(R,[1,0,0,1,-cx,-cy])));}
function ovPaint(p,c,d){
  const o=p.ov,r=o.res,D=OV&&OV.D,s=p.s;
  let side=o.side;if(side==='both'&&OV&&OV.blink)side=OV.blink;   // мигание: по очереди
  c.save();c.setTransform(s*d,0,0,-s*d,(p.W/2-p.cx*s)*d,(p.H/2+p.cy*s)*d);c.lineCap='round';c.lineJoin='round';
  const light=lum(dxfBg())>150,base=light?'#4b5058':'#c4c9d0',dim=light?'#a0a5ad':'#5d636c';
  const poly=(L,M)=>{c.beginPath();for(const q of L){
      if(M){c.moveTo(M[0]*q[0]+M[2]*q[1]+M[4],M[1]*q[0]+M[3]*q[1]+M[5]);for(let i=2;i<q.length;i+=2)c.lineTo(M[0]*q[i]+M[2]*q[i+1]+M[4],M[1]*q[i]+M[3]*q[i+1]+M[5]);}
      else{c.moveTo(q[0],q[1]);for(let i=2;i<q.length;i+=2)c.lineTo(q[i],q[i+1]);}}c.stroke();};
  const runs=R=>{c.beginPath();for(const q of R){c.moveTo(q.x[0],q.y[0]);for(let i=1;i<q.x.length;i++)c.lineTo(q.x[i],q.y[i]);}c.stroke();};
  const lw=1.3*(SET.lineK||1)/s,hw=3.2*(SET.lineK||1)/s;
  if(side==='a'||side==='both'){c.lineWidth=lw;c.strokeStyle=base;poly(r.LA);}
  if(side==='b'||side==='both'){c.lineWidth=lw;c.strokeStyle=D?'#4ea1ff':(side==='both'?base:base);poly(r.LB,D||null);}
  if(!D){
    c.lineWidth=hw;
    if(side==='a'||side==='both'){c.strokeStyle='#ff4d4d';runs(r.a.runs);}
    if(side==='b'||side==='both'){c.strokeStyle='#39d353';runs(r.b.runs);}
    // номера отличий и текущее — в рамке
    c.setTransform(d,0,0,d,0,0);c.font='bold 15px system-ui,sans-serif';c.textAlign='center';c.textBaseline='middle';
    r.clusters.forEach((q,i)=>{
      const X=p.W/2+((q[0]+q[2])/2-p.cx)*s,Y0=p.H/2-(q[3]-p.cy)*s,Y=Y0-14;if(X<-20||X>p.W+20||Y<-20||Y>p.H+20)return;
      const cur=OV&&OV.cur===i;c.fillStyle=cur?'#ffd23f':'rgba(20,22,26,.85)';c.beginPath();c.arc(X,Y,11,0,Math.PI*2);c.fill();
      c.lineWidth=1.5;c.strokeStyle='#ffd23f';c.stroke();c.fillStyle=cur?'#111':'#ffd23f';c.fillText(String(i+1),X,Y+0.5);
      if(cur){const g=8;c.setLineDash([6,4]);c.lineWidth=1.5;c.strokeRect(p.W/2+(q[0]-p.cx)*s-g,p.H/2-(q[3]-p.cy)*s-g,(q[2]-q[0])*s+2*g,(q[3]-q[1])*s+2*g);c.setLineDash([]);}
    });
  }
  if(OV&&OV.blink&&o.side==='both'){c.setTransform(d,0,0,d,0,0);c.font='bold 14px system-ui,sans-serif';c.textAlign='left';c.fillStyle=OV.blink==='a'?'#ff4d4d':'#39d353';
    c.fillText(OV.blink==='a'?'◀ слева: '+OV.a.name:'▶ справа: '+OV.b.name,12,p.H-14);}
  c.restore();
}
function ovMode(m){if(!OV)return;OV.mode=m;SET.cmpView=m;saveSet();OV.blink=null;const M=OV.M;OV.res=null;ovStart(M,false);}
function ovEnd(){const c=VW.cmp;ovClear();VW.plain=true;if(c)showSet([c.a,c.b],0);updateBar();}
function ovBlink(){ // пробел в наложении: по очереди только одна деталь, только другая, обе
  if(!OV||!OV.res)return false;
  if(OV.mode!=='over'){ovMode('over');}
  OV.blink=OV.blink==='a'?'b':OV.blink==='b'?null:'a';for(const p of ovPanes())p.draw();return true;}
$('vOv').onclick=()=>{if(OV)ovMode(OV.mode==='over'?'two':'over');else ovStart();};
$('ovMode').onclick=()=>ovMode(OV&&OV.mode==='over'?'two':'over');
$('ovEnd').onclick=ovEnd;$('ovPrev').onclick=()=>ovGo(-1);$('ovNext').onclick=()=>ovGo(1);
$('ovListBtn').onclick=()=>{$('ovList').hidden=!$('ovList').hidden;ovRenderList();};
$('ovAuto').onclick=()=>{if(OV){OV.D=null;ovStart(null,false);}};
$('ovRotL').onclick=()=>ovRot(90);$('ovRotR').onclick=()=>ovRot(-90);$('ovMir').onclick=()=>ovRot(0,true);
$('ovTol').onchange=e=>{SET.tol=+e.target.value;saveSet();if(OV)ovStart(OV.M,true);};
/* =====================================================================
   «Сравнить с…»: выбрать вторую деталь вручную — имена старых файлов могут не совпадать,
   поэтому список отсортирован по похожести габарита (поворот не важен), есть поиск и «Файл с диска…»
   ===================================================================== */
const PICK={a:null,tok:0,list:[],sig:new Map()};
function pickCands(a){
  const src=CMP?CMP.items.concat(items):items,seen=new Set(),out=[];
  for(const it of src){if(it===a||it.type!=='dxf'||seen.has(it.key))continue;seen.add(it.key);out.push(it);}
  return out;
}
async function pickSig(it){ // «отпечаток» детали, не зависящий от поворота: габарит вдоль главных осей и длина всех контуров
  if(PICK.sig.has(it.key))return PICK.sig.get(it.key);
  let v=null;
  try{const doc=await getDoc(it),g=GEO.prep(doc,0.5),c=Math.cos(g.ang),sn=Math.sin(g.ang),p=g.pts;
    let u0=Infinity,u1=-Infinity,w0=Infinity,w1=-Infinity;
    for(let i=0;i<p.length;i+=2){const x=p[i]-g.cx,y=p[i+1]-g.cy,u=x*c+y*sn,w=-x*sn+y*c;if(u<u0)u0=u;if(u>u1)u1=u;if(w<w0)w0=w;if(w>w1)w1=w;}
    if(p.length)v=[Math.min(u1-u0,w1-w0),Math.max(u1-u0,w1-w0),g.len];
  }catch(e){}
  PICK.sig.set(it.key,v);await new Promise(r=>setTimeout(r,0));return v;
}
function pickScore(p,q){if(!p||!q)return -1;const r=(a,b)=>Math.abs(a-b)/Math.max(a,b,1);
  return Math.max(0,1-(r(p[0],q[0])+r(p[1],q[1]))*1.5-r(p[2],q[2])*0.5);}
async function pickOpen(a){
  a=a||curItem();if(!a||a.type!=='dxf')return;
  PICK.a=a;const tok=++PICK.tok;$('pickPanel').hidden=false;$('pickQ').value='';
  $('pickFor').textContent='для: '+a.path;
  PICK.list=pickCands(a).map(it=>({it,sc:-1,other:!!(CMP&&CMP.items.includes(it))}));pickRender();
  const sa=await pickSig(a);if(tok!==PICK.tok)return;
  PICK.sa=sa;let n=0;
  for(const r of PICK.list){ // по очереди, сначала из той же «ветки» имени
    if(tok!==PICK.tok||$('pickPanel').hidden)return;
    r.sc=pickScore(sa,await pickSig(r.it));n++;
    if(n%8===0||n===PICK.list.length){$('pickInfo').textContent=n<PICK.list.length?'Подбираю похожие по габариту: '+n+' / '+PICK.list.length+'…':'';pickRender();}
  }
  $('pickInfo').textContent=PICK.list.length?'':'Других DXF нет — откройте общую папку, «⇆ Сравнить» с другой папкой или «Файл с диска…»';
}
function pickRender(){
  const L=$('pickList'),q=$('pickQ').value.trim().toLowerCase();L.textContent='';
  const rows=PICK.list.filter(r=>!q||r.it.path.toLowerCase().includes(q)).sort((x,y)=>(y.sc+(y.other?0.01:0)-x.sc-(x.other?0.01:0))||x.it.name.localeCompare(y.it.name,'ru',{numeric:true})).slice(0,120);
  for(const r of rows){const d=document.createElement('div');d.className='pk';
    const sg=PICK.sig.get(r.it.key),dir=r.it.path.includes('/')?r.it.path.slice(0,r.it.path.lastIndexOf('/')):'';
    d.innerHTML='<span class="pn"></span><span class="ps"></span><span class="pd"></span>';
    d.querySelector('.pn').textContent=r.it.name;d.querySelector('.pd').textContent=(r.other?'⇆ ':'')+dir;
    d.querySelector('.ps').innerHTML=sg?('≈ '+Math.round(sg[1])+' × '+Math.round(sg[0])+(r.sc>=0.995?'<br><b>размер совпал</b>':r.sc>0.85?'<br>размер близок':'')):'…';
    d.title='Габарит вдоль осей детали (поворот в файле не важен) и длина контуров: '+(sg?fmt(sg[2]):'?')+' мм';
    d.onclick=()=>pickGo(r.it);L.appendChild(d);}
}
function pickGo(b){const a=PICK.a;pickClose();if(!a)return;cmpOpen(a,b,true);}
function pickClose(){PICK.tok++;$('pickPanel').hidden=true;}
$('vWith').onclick=()=>pickOpen();
$('pickClose').onclick=pickClose;$('pickQ').oninput=pickRender;
$('pickFile').onclick=()=>$('pickInput').click();
$('pickInput').onchange=e=>{const f=e.target.files[0];e.target.value='';if(!f)return;const it=makeItem(f,'с диска/'+f.name,null,'с диска');pickGo(it);};
function cmpOpenFor(a){
  const c=CMP&&CMP.map.get(a);if(!c)return;
  if(c.st==='new'){showItem(view.indexOf(a));if(!docked())setFull(true);if(a.type==='dxf')pickOpen(a);else flash('В «'+CMP.name+'» нет файла с обозначением '+a.name);return;}
  cmpOpen(a,c.b);
}
async function cmpFromHandle(h,rid){
  $('cmpPanel').hidden=true;$('status').textContent='Чтение папки для сравнения «'+h.name+'»…';
  const out=[];walkShown=0;try{await walkDir(h,h.name,out);}catch(e){flash('Папка не читается: '+e.message);return;}
  const id=rid||await rememberRoot(h);
  if(id){const L=(LS.get('cmpRecent',[])||[]).filter(x=>x.id!==id);L.unshift({id,name:h.name,t:Date.now(),n:out.filter(x=>/\.(dxf|pdf)$/i.test(x.file.name)).length});LS.set('cmpRecent',L.slice(0,12));}
  cmpSet(out,h.name,id);updateStatus();
}
/* окно «Сравнить с папкой»: недавние папки сравнения, ярлыки, история.
   Папку, открытую сейчас (или внутри неё), выбрать нельзя. Путь: Chrome не отдаёт полный путь на диске,
   поэтому показывается цепочка папок от известной открытой когда-либо папки. */
async function curDirHandle(){
  const rid=items[0]&&items[0].rid;if(!rid)return null;
  try{const rr=await IDB.get(rid,'roots');if(!rr||!rr.h)return null;let h=rr.h;
    if(curDir)for(const seg of curDir.split('/').slice(1))h=await h.getDirectoryHandle(seg);return h;}catch(e){return null;}
}
async function renderCmpPanel(){
  const R=$('cmpRecent');R.textContent='';
  if(!FSA){R.innerHTML='<div class="pp-empty">На этом устройстве — только «Выбрать папку…».</div>';return;}
  const seen=new Set(),list=[];
  for(const x of LS.get('cmpRecent',[])||[])if(!seen.has(x.id)){seen.add(x.id);list.push({label:x.name,root:x.id,dir:x.name,rootName:x.name,t:x.t,n:x.n,recent:true});}
  for(const p of PINS)if(p.kind==='folder'&&!seen.has(p.root+'|'+p.dir)){seen.add(p.root+'|'+p.dir);list.push({label:'★ '+p.label,root:p.root,dir:p.dir,rootName:p.rootName});}
  for(const e of HIST)if(e.kind==='folder'&&e.root&&!seen.has(e.root)&&!seen.has(e.root+'|'+e.rootName)&&list.length<16){seen.add(e.root+'|'+e.rootName);list.push({label:e.rootName,root:e.root,dir:e.rootName,rootName:e.rootName});}
  const cur=await curDirHandle(),roots=((await IDB.all('roots').catch(()=>[]))||[]).filter(r=>r&&r.h&&r.kind==='directory').sort((a,b)=>(b.t||0)-(a.t||0)).slice(0,30);
  const fmtT=t=>{const d=new Date(t);return d.toLocaleDateString('ru-RU',{day:'2-digit',month:'2-digit'})+' '+d.toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});};
  for(const x of list){
    const r=document.createElement('div');r.className='pin';r.innerHTML='<span class="pi">📁</span><span class="pt"><div class="pl"></div><div class="pp"></div></span>';
    r.querySelector('.pl').textContent=x.label;
    const info=[x.dir.split('/').join(' / ')];if(x.n!=null)info.push('файлов: '+x.n);if(x.t)info.push('сравнивали '+fmtT(x.t));
    r.querySelector('.pp').textContent=info.join(' · ');R.appendChild(r);
    // та же папка, что открыта? и где она лежит
    (async()=>{
      let h=null;try{const rr=await IDB.get(x.root,'roots');h=rr&&rr.h;if(h&&x.dir&&x.dir!==x.rootName){for(const seg of x.dir.split('/').slice(1))h=await h.getDirectoryHandle(seg);}}catch(e){h=null;}
      if(!h||!cur)return;
      let self=false;try{self=await h.isSameEntry(cur)||!!(await cur.resolve(h));}catch(e){}
      if(self){r.classList.add('dis');r.title='Эта папка открыта сейчас — с ней сравнивать нечего';r.querySelector('.pl').textContent=x.label+' — открыта сейчас';return;}
      for(const rt of roots){try{if(await rt.h.isSameEntry(h))continue;const p=await rt.h.resolve(h);
        if(p&&p.length){r.querySelector('.pp').textContent=[[rt.name,...p].join(' / ')].concat(info.slice(1)).join(' · ');break;}}catch(e){}}
    })();
    r.onclick=async()=>{
      if(r.classList.contains('dis')){flash('Эта папка открыта сейчас — выберите другую (старый заказ, архив)');return;}
      const rr=await IDB.get(x.root,'roots');if(!rr||!rr.h){flash('Доступ не сохранился — выберите папку заново');return;}
      try{let q=await rr.h.queryPermission({mode:'read'});if(q!=='granted')q=await rr.h.requestPermission({mode:'read'});if(q!=='granted')return;}catch(e){return;}
      let hh=rr.h;if(x.dir&&x.dir!==x.rootName){for(const seg of x.dir.split('/').slice(1)){try{hh=await hh.getDirectoryHandle(seg);}catch(e){flash('Папка «'+x.dir+'» не найдена');return;}}}
      cmpFromHandle(hh,x.dir===x.rootName?x.root:null);
    };
  }
  if(!R.children.length)R.innerHTML='<div class="pp-empty">Здесь появятся папки, с которыми уже сравнивали, ярлыки и недавние.</div>';
}
$('btnCmp').onclick=()=>{
  if(CMP){if(confirm('Закончить сравнение с «'+CMP.name+'»?'))cmpEnd();return;}
  for(const id of ['setPanel','pinPanel'])$(id).hidden=true;const P=$('cmpPanel');P.hidden=!P.hidden;if(!P.hidden)renderCmpPanel();};
$('cmpClose').onclick=()=>{$('cmpPanel').hidden=true;};
$('cmpPick').onclick=async()=>{
  if(FSA){try{await cmpFromHandle(await showDirectoryPicker({id:'dxfv-cmp',mode:'read'}));}catch(e){if(e&&e.name!=='AbortError')$('inCmp').click();}}
  else $('inCmp').click();
};
$('inCmp').onchange=e=>{const fs=[...e.target.files];const root=fs.length&&fs[0].webkitRelativePath?fs[0].webkitRelativePath.split('/')[0]:'папка';
  $('cmpPanel').hidden=true;cmpSet(fs.map(f=>({file:f,path:f.webkitRelativePath||f.name})),root,null);e.target.value='';};
$('cmpEnd').onclick=cmpEnd;
$('cmpFilter').onchange=e=>{if(CMP){CMP.filter=e.target.value;applyFilter();}};
$('cmpOnlyBtn').onclick=()=>{
  const P=$('onlyPanel');P.hidden=!P.hidden;if(P.hidden||!CMP)return;
  $('onlyTitle').textContent='Есть только в «'+CMP.name+'»';const L=$('onlyList');L.textContent='';
  for(const b of CMP.onlyB){const r=document.createElement('div');r.className='pin';r.innerHTML='<span class="pi"></span><span class="pt"><div class="pl"></div><div class="pp"></div></span>';
    r.children[0].textContent=b.type==='pdf'?'📄':'📐';r.querySelector('.pl').textContent=b.name;r.querySelector('.pp').textContent=b.path.split('/').slice(0,-1).join(' / ');
    r.onclick=()=>{P.hidden=true;showSet([b],0);VW.cmp={a:b,b:b,manual:true};VW.set=[b];updateBar();if(!docked())setFull(true);};L.appendChild(r);}
};
$('onlyClose').onclick=()=>{$('onlyPanel').hidden=true;};
/* Ctrl+клик по двум файлам → «Сравнить рядом» */
function toggleSel(it){
  if(SEL.has(it)){SEL.delete(it);it.tile.classList.remove('sel');}
  else{if(SEL.size>=2){const f=[...SEL][0];SEL.delete(f);f.tile.classList.remove('sel');}SEL.add(it);it.tile.classList.add('sel');}
  $('selBar').hidden=!SEL.size;$('selGo').disabled=SEL.size!==2;
  $('selInfo').textContent=SEL.size===2?'Выбрано 2 файла':'Выбран 1 файл — Ctrl+клик по второму';
}
function clearSel(){for(const it of SEL)it.tile.classList.remove('sel');SEL.clear();$('selBar').hidden=true;}
$('selGo').onclick=()=>{if(SEL.size!==2)return;const [a,b]=[...SEL];clearSel();cmpOpen(a,b,true);};
$('selClear').onclick=clearSel;

/* ---------- Клавиатура ---------- */
/* при листании клавиатурой не подсвечивать плитку под мышью — чтобы не было «второй рамки» */
// кнопка после клика мышью не держит фокус — иначе Enter/пробел повторно жмут её вместо навигации
document.addEventListener('pointerup',e=>{const b=e.target.closest&&e.target.closest('button');if(b)setTimeout(()=>b.blur(),0);});
document.addEventListener('keydown',e=>{if(/^(Arrow|Page|Home|End)/.test(e.key))document.body.classList.add('kbd');},true);
document.addEventListener('mousemove',()=>{if(document.body.classList.contains('kbd'))document.body.classList.remove('kbd');});
function gridCols(){const t=$('grid').children;if(t.length<2)return 1;const y=t[0].offsetTop;let n=0;while(n<t.length&&t[n].offsetTop===y)n++;return n||1;}
function pageRows(){const t=$('grid').children[0];return t?Math.max(1,Math.floor($('gridWrap').clientHeight/(t.offsetHeight+8))):1;}
document.addEventListener('keydown',e=>{
  const k=e.key;
  if(MEAS.on&&viewerShown()&&e.ctrlKey&&/^[zZяЯ]$/.test(k)){e.preventDefault();measUndo(false);return;}
  if(e.ctrlKey||e.altKey||e.metaKey)return;   // Ctrl+R, Ctrl+F, Ctrl+L, Ctrl+0, Ctrl+Shift+B … — браузеру
  for(const id of ['logPanel','histPanel'])if(!$(id).hidden){if(k==='Escape')$(id).hidden=true;return;}
  if(k==='Escape'&&!$('setPanel').hidden){$('setPanel').hidden=true;return;}
  if(k==='Escape'&&!$('pinPanel').hidden){$('pinPanel').hidden=true;return;}
  if(k==='Escape'&&!$('pairPanel').hidden){closePairPanel();e.preventDefault();return;}
  if(e.target.id==='filter'&&(k==='ArrowDown'||k==='Enter')){e.target.blur();e.preventDefault();if(view.length&&VW.idx<0){if(docked())showItem(0);else{VW.idx=0;markCurrent(view[0]);}}return;}
  if(/^(INPUT|SELECT|TEXTAREA)$/.test(e.target.tagName))return;
  if(k==='Escape'&&!$('pickPanel').hidden){pickClose();return;}
  if(k==='Escape'&&(LOUPE.on||LOUPE.key)){loupeOff();return;}
  if(loupeOn()&&viewerShown()&&(k==='+'||k==='='||k==='-'||k==='_')){loupeK(k==='-'||k==='_'?0.8:1.25);return;}   // лупа на экране: + / − — её увеличение
  if(k==='Escape'&&!$('rulesPanel').hidden){$('rulesPanel').hidden=true;return;}
  if(!$('tblPanel').hidden){if(k==='Escape'){$('tblPanel').hidden=true;TBL.tok++;}return;}
  if(MEAS.on&&viewerShown()){   // размеры: Esc — отменить начатый (остальные остаются), Backspace / Ctrl+Z — убрать последний
    if(k==='Escape'&&panes.some(p=>p.ms&&(p.ms.pts.length||p.ms.ang||p.ms.rad||p.ms.gap))){for(const p of panes)if(p.ms){p.ms.pts=[];p.ms.ang=null;p.ms.rad=null;p.ms.gap=null;p.draw();}return;}
    if(k==='Escape'){measToggle(false);return;}
    if(k==='Backspace'||(e.ctrlKey&&/^[zZяЯ]$/.test(k))){e.preventDefault();measUndo(false);return;}
  }
  if(k==='Escape'&&SEL.size&&!VW.full){clearSel();return;}
  if(FOLLOW){ // второй монитор: листание передаётся в основное окно
    if(/^(ArrowRight|ArrowLeft|ArrowUp|ArrowDown| |Tab)$/.test(k)||((k==='PageDown'||k==='PageUp')&&!(panes[VW.active]&&panes[VW.active].isPdf&&panes[VW.active].doc.pages>1))){
      e.preventDefault();followerSend({t:'key',key:k,shift:e.shiftKey});return;}
  }
  if(!FOLLOW&&!VW.full&&KB.zone==='tree'&&!$('tree').hidden){if(treeKey(k)){e.preventDefault();return;}}
  if(!FOLLOW&&!VW.full&&k==='Backspace'){e.preventDefault();if(!goUp())toTree();return;}
  const tileNav=!FOLLOW&&(!viewerShown()||(docked()&&!VW.full&&folderMode()));  // курсор по плиткам: без окна просмотра, а «по папкам» — и с окном рядом
  if(!FOLLOW&&!view.length&&!(folderMode()&&gridTiles().length&&tileNav))return;
  if(tileNav){ // сетка/список без окна просмотра: курсор по плиткам (папки и файлы), Enter или пробел — открыть
    const ts=gridTiles(),list=SET.layout==='list',cols=list?1:gridCols();
    let i=ts.findIndex(t=>t.classList.contains('cur')),h=true;
    if(i<0&&VW.idx>=0)i=ts.indexOf(view[VW.idx].tile);
    if(k==='ArrowLeft'&&(list||i<=0||i%cols===0)&&toTree()){e.preventDefault();return;}  // из первого столбца — в дерево
    if(k==='Tab'&&i>=0&&ts[i]._it){e.preventDefault();kbMark(ts[i]);openSel('pair',e.shiftKey?-1:1);return;}
    if(/^[rRкК]$/.test(k)&&i>=0&&ts[i]._it){e.preventDefault();kbMark(ts[i]);openSel('side');return;}
    if(/^[vVмМ]$/.test(k)&&i>=0&&ts[i]._it&&ts[i]._it.type==='dxf'){e.preventDefault();showItem(view.indexOf(ts[i]._it));if(!docked())setFull(true);pickOpen(ts[i]._it);return;}
    if(k==='ArrowRight')i=i<0?0:i+1;else if(k==='ArrowLeft')i=i<0?0:i-1;
    else if(k==='ArrowDown')i=i<0?0:i+cols;else if(k==='ArrowUp')i=i<0?0:i-cols;
    else if(k==='Home')i=0;else if(k==='End')i=ts.length-1;
    else if(k==='PageDown')i=(i<0?0:i)+cols*pageRows();else if(k==='PageUp')i=(i<0?0:i)-cols*pageRows();
    else if((k==='Enter'||k===' ')&&i>=0){e.preventDefault();const t=ts[i];
      if(t._dir!==undefined&&!t._it)goDir(t._dir,t.classList.contains('up')?curDir:null);else{if(VW.idx!==view.indexOf(t._it)||!docked())showItem(view.indexOf(t._it));setFull(true);}return;}
    else h=false;
    if(h){e.preventDefault();kbMark(ts[Math.min(Math.max(i,0),ts.length-1)]);}
    return;
  }
  const ap=panes[VW.active];let h=true;
  const gridDock=docked()&&!VW.full&&SET.layout!=='list'&&VW.set.length<2;
  if(k===' '&&OV&&SET.blink&&ovBlink());   // мигание в сравнении
  else if(k==='ArrowRight'||k===' ')step(1);
  else if(k==='ArrowLeft'){if(docked()&&!VW.full&&SET.layout==='list'&&VW.idx<=0&&toTree());else step(-1);}
  else if(k==='ArrowDown'||k==='ArrowUp'){const d=k==='ArrowDown'?1:-1;
    if(gridDock)showItem(Math.min(Math.max((VW.idx<0?0:VW.idx)+d*gridCols(),0),view.length-1));else step(d);}
  else if(k==='PageDown'){if(!(ap&&ap.pageGo(1)))step(1);}
  else if(k==='PageUp'){if(!(ap&&ap.pageGo(-1)))step(-1);}
  else if(k==='Tab'&&monOn())monTab(e.shiftKey?-1:1);
  else if(k==='Tab'){if(VW.set.length>1){const n=VW.set.length;setActive(panes[(VW.active+(e.shiftKey?-1:1)+n)%n]);}else cyclePair(e.shiftKey?-1:1);}
  else if(k==='Enter'){if(docked()&&!VW.full&&VW.idx>=0)setFull(true);else h=false;}
  else if(k==='Escape'&&OV&&!$('ovList').hidden)$('ovList').hidden=true;
  else if(k==='Escape'&&OV)ovEnd();
  else if(/^[nNтТ]$/.test(k)&&OV)ovMode(OV.mode==='over'?'two':'over');
  else if(/^[nNтТ]$/.test(k)&&!$('vOv').hidden)$('vOv').click();
  else if(/^[vVмМ]$/.test(k)&&!$('vWith').hidden)pickOpen();
  else if((k===','||k==='б'||k==='Б')&&OV)ovGo(-1);
  else if((k==='.'||k==='ю'||k==='Ю')&&OV)ovGo(1);
  else if(k==='Escape'){if(VW.cmp&&docked()&&!VW.full)showItem(VW.idx);else if(VW.full)setFull(false);else h=false;}
  else if(/^[lLдД]$/.test(k)&&VW.cmp)$('vSync').click();
  else if(/^[rRкК]$/.test(k))$('vSide').click();
  else if(/^[wWцЦ]$/.test(k))cycleLineK();
  else if(/^[dDвВ]$/.test(k)&&!$('vMeas').hidden)measToggle();
  else if(/^[cCсС]$/.test(k)&&!$('vChk').hidden)chkToggle();
  else if(k==='['||k==='х'||k==='Х')setContrast(SET.pdfLv-1);
  else if(k===']'||k==='ъ'||k==='Ъ')setContrast(SET.pdfLv+1);
  else if(/^[qQйЙ]$/.test(k))$('vRotL').click();
  else if(/^[eEуУ]$/.test(k))$('vRotR').click();
  else if(/^[MЬ]$/.test(k))$('vMirV').click();
  else if(/^[mь]$/.test(k))$('vMir').click();
  else if(k==='0')apDo(p=>p.setXf({rot:0,mirror:false}));
  else if(/^[oOщЩ]$/.test(k))apDo(p=>p.toggleOrig());
  else if((k==='Home'||k==='End')&&docked()&&!VW.full&&view.length)showItem(k==='Home'?0:view.length-1);  // окно рядом: первый / последний файл
  else if(e.shiftKey&&/^[fFаА]$/.test(k))$('vFitW').click();
  else if(k==='Home'||/^[fFаА]$/.test(k))$('vFit').click();
  else if((k==='+'||k==='=')&&ap)ap.zoomAt(ap.W/2,ap.H/2,1.25);
  else if((k==='-'||k==='_')&&ap)ap.zoomAt(ap.W/2,ap.H/2,0.8);
  else h=false;
  if(h)e.preventDefault();
});

placeViewer();updateStatus();updateBar();

/* справка: текст — в help.part; здесь только открыть/закрыть, оглавление и поиск */
function helpOpen(sec){
  const P=$('helpPanel'),N=$('helpNav'),B=$('helpBody');
  if(!N.children.length)for(const x of B.querySelectorAll('section')){const a=document.createElement('a');a.textContent=x.dataset.t;a.onclick=()=>{$('helpQ').value='';helpFind();x.scrollIntoView({block:'start'});};N.appendChild(a);}
  P.hidden=false;if(sec){const x=[...B.querySelectorAll('section')].find(s=>s.dataset.t===sec);if(x)x.scrollIntoView({block:'start'});}
  setTimeout(()=>$('helpQ').focus(),0);
}
function helpFind(){
  const q=$('helpQ').value.trim().toLowerCase(),B=$('helpBody');
  for(const m of B.querySelectorAll('mark'))m.replaceWith(document.createTextNode(m.textContent));B.normalize();
  for(const x of B.querySelectorAll('section')){
    const hit=!q||x.textContent.toLowerCase().includes(q);x.classList.toggle('hid',!hit);
    if(q&&hit){const w=document.createTreeWalker(x,NodeFilter.SHOW_TEXT),L=[];while(w.nextNode())L.push(w.currentNode);
      for(const t of L){const i=t.data.toLowerCase().indexOf(q);if(i<0)continue;const r=t.splitText(i);r.splitText(q.length);const m=document.createElement('mark');m.textContent=r.data;r.replaceWith(m);}}
  }
}
$('btnHelp').onclick=()=>helpOpen();$('helpClose').onclick=()=>{$('helpPanel').hidden=true;};
$('helpPanel').addEventListener('click',e=>{if(e.target.id==='helpPanel')$('helpPanel').hidden=true;});
$('helpQ').oninput=helpFind;
document.addEventListener('keydown',e=>{
  if(e.key==='F1'){e.preventDefault();$('helpPanel').hidden?helpOpen():($('helpPanel').hidden=true);e.stopImmediatePropagation();return;}
  if(!$('helpPanel').hidden){if(e.key==='Escape'){$('helpPanel').hidden=true;}e.stopImmediatePropagation();}   // пока открыта справка, клавиши программы не срабатывают
},true);

/* при запуске — открыть последнюю папку (если браузер сохранил разрешение; иначе кнопка в пустом окне) */
(async()=>{
  if(FOLLOW||!FSA||!SET.reopen||typeof IDB==='undefined')return;
  const lr=LS.get('lastRoot',null);if(!lr||!lr.rid)return;
  let r;try{r=await IDB.get(lr.rid,'roots');}catch(e){return;}
  if(!r||!r.h||r.kind!=='directory'||items.length)return;
  let p='prompt';try{p=await r.h.queryPermission({mode:'read'});}catch(e){return;}
  if(p==='granted'){if(!items.length)openDirHandle(r.h);return;}
  const b=document.createElement('button');b.className='reopen';b.textContent='▶ Открыть «'+r.name+'»';b.title='Последняя открытая папка';
  b.onclick=async()=>{try{if(await r.h.requestPermission({mode:'read'})==='granted')openDirHandle(r.h);}catch(e){flash('Нет доступа: '+e.message);}};
  const d=document.createElement('div');d.style.margin='0 0 18px';d.appendChild(b);$('empty').prepend(d);
})();

/* ---------- PWA: офлайн-кэш, обновления, открытие файлов из Проводника ---------- */
if(location.protocol.startsWith('http')&&'serviceWorker' in navigator){
  let reloading=false;
  navigator.serviceWorker.addEventListener('controllerchange',()=>{if(reloading)return;reloading=true;location.reload();});
  navigator.serviceWorker.register('sw.js').then(reg=>{
    const offer=w=>{const b=$('updBar');b.hidden=false;$('updBtn').onclick=()=>{w.postMessage('skip');b.hidden=true;};};
    if(reg.waiting&&navigator.serviceWorker.controller)offer(reg.waiting);
    reg.addEventListener('updatefound',()=>{const w=reg.installing;w&&w.addEventListener('statechange',()=>{
      if(w.state==='installed'&&navigator.serviceWorker.controller)offer(w);});});
    document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible')reg.update().catch(()=>{});});
  }).catch(()=>{});
}
if('launchQueue' in window){
  launchQueue.setConsumer(async p=>{if(p.files&&p.files.length)await openFileHandles(p.files);});
}
</script>
</body>
</html>
