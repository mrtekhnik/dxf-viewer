/* =====================================================================
   ГЕОМЕТРИЧЕСКОЕ СРАВНЕНИЕ ДВУХ DXF (этап 2)
   Без DOM и без глобальных переменных главного потока — можно перенести в Worker.
     GEO.prep(doc,tol)        — контуры как ломаные (дуги разбиты с ошибкой ≤ tol/10), точки по длине, центр, размер
     GEO.align(A,B,tol)       — подобрать положение B на A: сдвиг, поворот на любой угол, зеркало → матрица M
     GEO.diff(A,B,M,tol)      — какие участки A не лежат на B и наоборот (с допуском tol, мм)
   Матрица M = [a,b,c,d,e,f]:  x' = a·x + c·y + e,  y' = b·x + d·y + f   (как xfMat)
   ===================================================================== */
function GEOCORE(){
  const TAU=Math.PI*2;
  function bulgeArc(x1,y1,x2,y2,b){ // та же формула, что в ядре DXF
    const dx=x2-x1,dy=y2-y1,d=Math.hypot(dx,dy);
    if(d<1e-12||Math.abs(b)<1e-7)return null;
    const k=(1-b*b)/(4*b),cx=(x1+x2)/2-dy*k,cy=(y1+y2)/2+dx*k;
    return {cx,cy,r:d*(1+b*b)/(4*Math.abs(b)),a0:Math.atan2(y1-cy,x1-cx),a1:Math.atan2(y2-cy,x2-cx),ccw:b>0};
  }
  /* дуга от a0 до a1 (ccw — против часовой) → точки */
  function arcPts(o,cx,cy,r,a0,a1,ccw,chord,first){
    let sw=ccw?a1-a0:a0-a1;while(sw<=1e-12)sw+=TAU;if(sw>TAU)sw=TAU;
    const st=chord<r?2*Math.acos(1-chord/r):Math.PI/2,n=Math.max(2,Math.min(4000,Math.ceil(sw/st)));
    for(let i=first?0:1;i<=n;i++){const a=a0+(ccw?1:-1)*sw*i/n;o.push(cx+r*Math.cos(a),cy+r*Math.sin(a));}
  }
  function flatten(doc,chord){
    const L=[];
    for(const G of doc.groups||[]){if(G.off)continue;
      for(const p of G.prims){
        if(p[0]==='L')L.push([p[1],p[2],p[3],p[4]]);
        else if(p[0]==='C'){const o=[];arcPts(o,p[1],p[2],p[3],0,TAU,true,chord,true);L.push(o);}
        else if(p[0]==='A'){const o=[];arcPts(o,p[1],p[2],p[3],p[4],p[5],true,chord,true);L.push(o);}
        else if(p[0]==='P'){const a=p[2],n=a.length/3,segs=p[1]?n:n-1;if(n<2)continue;const o=[a[0],a[1]];
          for(let i=0;i<segs;i++){const j=(i+1)%n,x1=a[i*3],y1=a[i*3+1],x2=a[j*3],y2=a[j*3+1],b=a[i*3+2];
            const A=b?bulgeArc(x1,y1,x2,y2,b):null;
            if(A)arcPts(o,A.cx,A.cy,A.r,A.a0,A.a1,A.ccw,chord,false);else o.push(x2,y2);}
          L.push(o);}
      }}
    return L;
  }
  /* точки вдоль ломаных с шагом step (концы — всегда) */
  function sample(L,step){
    const P=[];
    for(let k=0;k<L.length;k++){const o=L[k],xs=[],ys=[];
      for(let i=0;i+3<o.length;i+=2){const x1=o[i],y1=o[i+1],x2=o[i+2],y2=o[i+3],d=Math.hypot(x2-x1,y2-y1),n=Math.max(1,Math.ceil(d/step));
        for(let j=i?1:0;j<=n;j++){xs.push(x1+(x2-x1)*j/n);ys.push(y1+(y2-y1)*j/n);}}
      if(xs.length)P.push({k,x:xs,y:ys});}
    return P;
  }
  const xfL=(L,M)=>L.map(o=>{const r=new Array(o.length);for(let i=0;i<o.length;i+=2){const x=o[i],y=o[i+1];r[i]=M[0]*x+M[2]*y+M[4];r[i+1]=M[1]*x+M[3]*y+M[5];}return r;});
  const mul=(A,B)=>[A[0]*B[0]+A[2]*B[1],A[1]*B[0]+A[3]*B[1],A[0]*B[2]+A[2]*B[3],A[1]*B[2]+A[3]*B[3],A[0]*B[4]+A[2]*B[5]+A[4],A[1]*B[4]+A[3]*B[5]+A[5]];
  /* сетка отрезков — быстрый поиск ближайшей точки */
  function index(L,cell){
    let x0=Infinity,y0=Infinity,x1=-Infinity,y1=-Infinity;
    for(const o of L)for(let i=0;i<o.length;i+=2){const x=o[i],y=o[i+1];if(x<x0)x0=x;if(x>x1)x1=x;if(y<y0)y0=y;if(y>y1)y1=y;}
    if(!(x1>=x0))return null;
    const nx=Math.max(1,Math.min(2048,Math.ceil((x1-x0)/cell)+1)),ny=Math.max(1,Math.min(2048,Math.ceil((y1-y0)/cell)+1)),cw=Math.max((x1-x0)/(nx-0.5),1e-9),ch=Math.max((y1-y0)/(ny-0.5),1e-9);
    const cells=new Map(),S=[];
    for(const o of L)for(let i=0;i+3<o.length;i+=2){const a=o[i],b=o[i+1],c=o[i+2],d=o[i+3],id=S.length;S.push(a,b,c,d);
      const i0=Math.floor((Math.min(a,c)-x0)/cw),i1=Math.floor((Math.max(a,c)-x0)/cw),j0=Math.floor((Math.min(b,d)-y0)/ch),j1=Math.floor((Math.max(b,d)-y0)/ch);
      for(let ii=i0;ii<=i1;ii++)for(let jj=j0;jj<=j1;jj++){const key=jj*nx+ii;let e=cells.get(key);if(!e)cells.set(key,e=[]);e.push(id);}}
    return {x0,y0,cw,ch,nx,ny,cells,S};
  }
  /* ближайшая точка в радиусе R: [d,px,py] или null; any — достаточно любой точки ближе R (быстрее) */
  function nearest(I,x,y,R,any){
    if(!I)return null;const S=I.S;let best=R*R,bx=0,by=0,hit=false;
    const i0=Math.max(0,Math.floor((x-R-I.x0)/I.cw)),i1=Math.min(I.nx-1,Math.floor((x+R-I.x0)/I.cw)),j0=Math.max(0,Math.floor((y-R-I.y0)/I.ch)),j1=Math.min(I.ny-1,Math.floor((y+R-I.y0)/I.ch));
    for(let jj=j0;jj<=j1;jj++)for(let ii=i0;ii<=i1;ii++){const e=I.cells.get(jj*I.nx+ii);if(!e)continue;
      for(let k=0;k<e.length;k++){const id=e[k],a=S[id],b=S[id+1],dx=S[id+2]-a,dy=S[id+3]-b,l2=dx*dx+dy*dy;
        let t=l2>0?((x-a)*dx+(y-b)*dy)/l2:0;t=t<0?0:t>1?1:t;const px=a+t*dx,py=b+t*dy,ex=x-px,ey=y-py,q=ex*ex+ey*ey;
        if(q<=best){best=q;bx=px;by=py;hit=true;if(any)return [Math.sqrt(q),px,py];}}}
    return hit?[Math.sqrt(best),bx,by]:null;
  }
  /* «опорные точки» детали — центры окружностей и дуг с радиусом: по ним совмещаются детали, даже если одна из них заметно изменена */
  function feats(doc){
    const F=[],seen=new Set(),add=(x,y,r)=>{if(!(r>0)||!isFinite(x+y+r))return;const k=Math.round(x*20)+'|'+Math.round(y*20)+'|'+Math.round(r*20);if(seen.has(k))return;seen.add(k);F.push([x,y,r]);};
    for(const G of doc.groups||[]){if(G.off)continue;
      for(const p of G.prims){
        if(p[0]==='C'||p[0]==='A')add(p[1],p[2],p[3]);
        else if(p[0]==='P'){const a=p[2],n=a.length/3,segs=p[1]?n:n-1;
          for(let i=0;i<segs;i++){const b=a[i*3+2];if(!b)continue;const j=(i+1)%n,A=bulgeArc(a[i*3],a[i*3+1],a[j*3],a[j*3+1],b);if(A)add(A.cx,A.cy,A.r);}}}}
    return F;
  }
  function prep(doc,tol){
    const L=flatten(doc,Math.max(tol/10,1e-4));
    let x0=Infinity,y0=Infinity,x1=-Infinity,y1=-Infinity,len=0;
    for(const o of L)for(let i=0;i<o.length;i+=2){const x=o[i],y=o[i+1];if(x<x0)x0=x;if(x>x1)x1=x;if(y<y0)y0=y;if(y>y1)y1=y;if(i)len+=Math.hypot(x-o[i-2],y-o[i-1]);}
    const size=Math.max(x1-x0,y1-y0)||1;
    // центр и главные оси — по точкам, равномерно распределённым по длине контура
    const P=sample(L,Math.max(len/1500,size/2000,1e-6));let n=0,mx=0,my=0;
    for(const p of P)for(let i=0;i<p.x.length;i++){mx+=p.x[i];my+=p.y[i];n++;}
    mx/=n||1;my/=n||1;let sxx=0,syy=0,sxy=0;
    for(const p of P)for(let i=0;i<p.x.length;i++){const dx=p.x[i]-mx,dy=p.y[i]-my;sxx+=dx*dx;syy+=dy*dy;sxy+=dx*dy;}
    const ang=0.5*Math.atan2(2*sxy,sxx-syy);
    const pts=[];for(const p of P)for(let i=0;i<p.x.length;i++)pts.push(p.x[i],p.y[i]);
    const C=[];for(const G of doc.groups||[]){if(G.off)continue;for(const p of G.prims)if(p[0]==='C')C.push([p[1],p[2],p[3]]);}
    return {L,bbox:[x0,y0,x1,y1],size,len,cx:mx,cy:my,ang,pts,n:L.length,F:feats(doc),C};
  }
  /* сколько точек B (после M) лежат на A ближе r — оценка совмещения */
  function score(IA,B,M,r,maxN){
    const p=B.pts,N=p.length/2,stp=Math.max(1,Math.floor(N/maxN));let s=0,c=0;
    for(let i=0;i<N;i+=stp){const x=p[i*2],y=p[i*2+1],X=M[0]*x+M[2]*y+M[4],Y=M[1]*x+M[3]*y+M[5];const q=nearest(IA,X,Y,r);s+=q?1-q[0]/r:0;c++;}
    return c?s/c:0;
  }
  /* уточнение: ICP — ближайшие точки + жёсткое совмещение (сдвиг и поворот, зеркало не меняется) */
  function icp(IA,B,M,r0,rMin,iters){
    const p=B.pts,N=p.length/2,stp=Math.max(1,Math.floor(N/600));let r=r0;
    for(let it=0;it<iters;it++){
      let n=0,px=0,py=0,qx=0,qy=0;const P=[],Q=[];
      for(let i=0;i<N;i+=stp){const x=p[i*2],y=p[i*2+1],X=M[0]*x+M[2]*y+M[4],Y=M[1]*x+M[3]*y+M[5];const q=nearest(IA,X,Y,r);
        if(q){P.push(X,Y);Q.push(q[1],q[2]);px+=X;py+=Y;qx+=q[1];qy+=q[2];n++;}}
      if(n<3)break;px/=n;py/=n;qx/=n;qy/=n;let sxx=0,sxy=0;
      for(let i=0;i<P.length;i+=2){const ax=P[i]-px,ay=P[i+1]-py,bx=Q[i]-qx,by=Q[i+1]-qy;sxx+=ax*bx+ay*by;sxy+=ax*by-ay*bx;}
      const t=Math.atan2(sxy,sxx),c=Math.cos(t),s=Math.sin(t);
      const D=[c,s,-s,c,qx-(c*px-s*py),qy-(s*px+c*py)];M=mul(D,M);
      if(Math.abs(t)<1e-7&&Math.hypot(D[4],D[5])<rMin*0.01)r=Math.max(rMin,r*0.5);else r=Math.max(rMin,r*0.7);
    }
    return M;
  }
  /* подбор положения B на A */
  const inv=M=>{const d=M[0]*M[3]-M[1]*M[2];return [M[3]/d,-M[1]/d,-M[2]/d,M[0]/d,(M[2]*M[5]-M[3]*M[4])/d,(M[1]*M[4]-M[0]*M[5])/d];};
  /* M: B → A. Положение B: повернуть на a (с зеркалом x→−x до поворота), затем точку q из B совместить с точкой p из A */
  function mk(a,mir,qx,qy,px,py){const c=Math.cos(a),s=Math.sin(a),m=mir?-1:1;return mul([1,0,0,1,px,py],mul([c*m,s*m,-s,c,0,0],[1,0,0,1,-qx,-qy]));}
  /* подбор положения B на A.
     Варианты: 1) центр к центру, главные оси детали; 2) по опорным точкам (центры отверстий и дуг одинакового радиуса):
     пара точек A ↔ пара точек B с тем же расстоянием даёт поворот и сдвиг — так совмещаются и заметно изменённые детали.
     Лучшие варианты уточняются ICP, итог — доля совпавших контуров в обе стороны. */
  function align(A,B,tol){
    const size=Math.max(A.size,B.size),IA=index(A.L,Math.max(size/150,tol*2)),IB=index(B.L,Math.max(size/150,tol*2));
    const cand=[],seen=new Set();
    const push=(a,mir,qx,qy,px,py,src)=>{a=((a%TAU)+TAU)%TAU;const M=mk(a,mir,qx,qy,px,py);
      const key=(mir?'m':'')+Math.round(a*200)+'|'+Math.round(M[4]/(size*0.004))+'|'+Math.round(M[5]/(size*0.004));if(seen.has(key))return;seen.add(key);cand.push({M,mir,src});};
    for(const mir of [false,true]){
      const bAng=mir?Math.PI-B.ang:B.ang;
      for(let k=0;k<4;k++){push(A.ang-bAng+k*Math.PI/2,mir,B.cx,B.cy,A.cx,A.cy,'pca');push(k*Math.PI/2,mir,B.cx,B.cy,A.cx,A.cy,'axis');}
    }
    // опорные точки
    const pick=(F,n)=>{if(F.length<=n)return F;const st=F.length/n,o=[];for(let i=0;i<n;i++)o.push(F[Math.floor(i*st)]);return o;};
    const FA=pick(A.F,70),FB=pick(B.F,70),rt=r=>Math.max(tol*2,r*0.01),dq=Math.max(tol*3,size*0.002);
    if(FA.length&&FB.length){
      const pairs=new Map();  // пары B по (радиусы, расстояние)
      for(let i=0;i<FB.length;i++)for(let j=0;j<FB.length;j++){if(i===j)continue;const p=FB[i],q=FB[j],d=Math.hypot(q[0]-p[0],q[1]-p[1]);if(d<size*0.05)continue;
        const k=Math.round(p[2]/0.25)+'|'+Math.round(q[2]/0.25)+'|'+Math.round(d/dq);let e=pairs.get(k);if(!e)pairs.set(k,e=[]);if(e.length<40)e.push([p,q]);}
      let nh=0;
      for(let i=0;i<FA.length&&nh<800;i++)for(let j=0;j<FA.length&&nh<800;j++){if(i===j)continue;const p=FA[i],q=FA[j],d=Math.hypot(q[0]-p[0],q[1]-p[1]);if(d<size*0.05)continue;
        for(const dd of [-1,0,1]){const e=pairs.get(Math.round(p[2]/0.25)+'|'+Math.round(q[2]/0.25)+'|'+(Math.round(d/dq)+dd));if(!e)continue;
          for(const [u,v] of e){if(Math.abs(u[2]-p[2])>rt(p[2])||Math.abs(v[2]-q[2])>rt(q[2])||Math.abs(Math.hypot(v[0]-u[0],v[1]-u[1])-d)>dq)continue;
            for(const mir of [false,true]){const ub=mir?-u[0]:u[0],vb=mir?-v[0]:v[0];
              const a=Math.atan2(q[1]-p[1],q[0]-p[0])-Math.atan2(v[1]-u[1],vb-ub);push(a,mir,u[0],u[1],p[0],p[1],'feat2');nh++;}}}}
      // одна опорная точка + повороты на 0/90/180/270 — когда у детали одно-два отверстия
      if(nh<50)for(const p of FA.slice(0,25))for(const u of FB.slice(0,25)){if(Math.abs(u[2]-p[2])>rt(p[2]))continue;
        for(const mir of [false,true])for(let k=0;k<4;k++)push(k*Math.PI/2,mir,u[0],u[1],p[0],p[1],'feat1');}
    }
    const sym=(M,r,n)=>(score(IA,B,M,r,n)+score(IB,A,inv(M),r,n))/2;
    const r0=Math.max(tol*3,size*0.004);
    for(const C of cand)C.sc=sym(C.M,C.src==='pca'||C.src==='axis'?size*0.02:r0*2,C.src==='pca'||C.src==='axis'?300:150);
    cand.sort((x,y)=>y.sc-x.sc);
    // лучшие из обеих групп — на уточнение
    const top=[...cand.filter(c=>c.src==='pca'||c.src==='axis').slice(0,3),...cand.filter(c=>c.src.startsWith('feat')).slice(0,6)];
    let best=null;
    for(const C of top){const M=icp(IA,B,C.M,C.src.startsWith('feat')?r0*3:size*0.05,Math.max(tol,size*1e-5),40);const sc=sym(M,Math.max(tol*3,size*0.002),1500);
      if(!best||sc>best.sc)best={M,sc,mir:C.mir};}
    return best;
  }
  /* отличия: участки A, которых нет на B (после M), и наоборот */
  function diff(A,B,M,tol){
    const size=Math.max(A.size,B.size),step=Math.max(tol*1.5,size/4000),cell=Math.max(size/256,tol*4);
    const LB=xfL(B.L,M),IA=index(A.L,cell),IB=index(LB,cell);
    const side=(L,I)=>{const P=sample(L,step);let bad=0,all=0;const runs=[];
      for(const p of P){let run=null;
        for(let i=0;i<p.x.length;i++){const ok=!!nearest(I,p.x[i],p.y[i],tol,true);all++;if(!ok)bad++;
          if(!ok){if(!run){run={x:[],y:[]};if(i)run.x.push(p.x[i-1]),run.y.push(p.y[i-1]);}run.x.push(p.x[i]);run.y.push(p.y[i]);}
          else if(run){run.x.push(p.x[i]);run.y.push(p.y[i]);runs.push(run);run=null;}}
        if(run)runs.push(run);}
      // одиночная «плохая» точка между хорошими — шум разбиения дуг, не отличие
      const real=runs.filter(r=>r.x.length>3||Math.hypot(r.x[r.x.length-1]-r.x[0],r.y[r.y.length-1]-r.y[0])>tol*4);
      let blen=0;for(const r of real)for(let i=1;i<r.x.length;i++)blen+=Math.hypot(r.x[i]-r.x[i-1],r.y[i]-r.y[i-1]);
      return {runs:real,bad:blen,frac:all?1-bad/all:1};};
    const a=side(A.L,IB),b=side(LB,IA);
    // группы отличий — рядом лежащие участки обеих сторон
    const boxes=[];
    for(const [s,rs] of [['a',a.runs],['b',b.runs]])for(const r of rs){let x0=Infinity,y0=Infinity,x1=-Infinity,y1=-Infinity;
      for(let i=0;i<r.x.length;i++){x0=Math.min(x0,r.x[i]);x1=Math.max(x1,r.x[i]);y0=Math.min(y0,r.y[i]);y1=Math.max(y1,r.y[i]);}boxes.push([x0,y0,x1,y1]);}
    const g=size*0.01,cl=[];
    for(const b0 of boxes){let m=null;
      for(const c of cl)if(b0[0]<=c[2]+g&&b0[2]>=c[0]-g&&b0[1]<=c[3]+g&&b0[3]>=c[1]-g){m=c;break;}
      if(m){m[0]=Math.min(m[0],b0[0]);m[1]=Math.min(m[1],b0[1]);m[2]=Math.max(m[2],b0[2]);m[3]=Math.max(m[3],b0[3]);}else cl.push(b0.slice());}
    for(let ch=true;ch;){ch=false;for(let i=0;i<cl.length;i++)for(let j=cl.length-1;j>i;j--){const p=cl[i],q=cl[j];
      if(q[0]<=p[2]+g&&q[2]>=p[0]-g&&q[1]<=p[3]+g&&q[3]>=p[1]-g){p[0]=Math.min(p[0],q[0]);p[1]=Math.min(p[1],q[1]);p[2]=Math.max(p[2],q[2]);p[3]=Math.max(p[3],q[3]);cl.splice(j,1);ch=true;}}}
    cl.sort((p,q)=>(q[3]+q[1])-(p[3]+p[1])||(p[0]-q[0]));  // сверху вниз, слева направо
    return {LB,a,b,clusters:cl,same:!a.runs.length&&!b.runs.length};
  }
  /* всё сразу: подготовка, совмещение, отличия */
  /* описание отличий словами — по каждой группе: отверстия (окружности) и участки контура.
     «слева» — первая деталь (A), «справа» — вторая (B). */
  const f1=v=>{const r=Math.round(v*10)/10;return String(r).replace('.',',');};
  function describe(A,B,M,d,tol){
    const CB=B.C.map(c=>[M[0]*c[0]+M[2]*c[1]+M[4],M[1]*c[0]+M[3]*c[1]+M[5],c[2]]);
    const inB=(c,b)=>c[0]>=b[0]-c[2]-tol&&c[0]<=b[2]+c[2]+tol&&c[1]>=b[1]-c[2]-tol&&c[1]<=b[3]+c[2]+tol;
    const near=(c,L,fr)=>L.find(x=>Math.hypot(x[0]-c[0],x[1]-c[1])<=fr&&x!==c);
    const usedA=new Set(),usedB=new Set();
    return d.clusters.map(bb=>{
      const ca=A.C.filter(c=>inB(c,bb)),cb=CB.filter(c=>inB(c,bb)),items=[];
      const same=(x,y)=>Math.hypot(x[0]-y[0],x[1]-y[1])<=tol&&Math.abs(x[2]-y[2])<=tol;
      const ra=ca.filter(c=>!cb.some(y=>same(c,y))),rb=cb.filter(c=>!ca.some(y=>same(c,y)));
      const grp=new Map(),add=(k,t)=>{const g=grp.get(k)||{n:0,t};g.n++;grp.set(k,g);};
      for(const c of ra){if(usedA.has(c))continue;
        const y=rb.find(y=>!usedB.has(y)&&Math.hypot(y[0]-c[0],y[1]-c[1])<=tol);           // тот же центр, другой диаметр
        if(y){usedA.add(c);usedB.add(y);add('d'+f1(c[2]*2)+'>'+f1(y[2]*2),n=>(n>1?n+' отверстия':'отверстие')+' Ø'+f1(c[2]*2)+' слева → Ø'+f1(y[2]*2)+' справа');continue;}
        const z=rb.find(y=>!usedB.has(y)&&Math.abs(y[2]-c[2])<=tol&&Math.hypot(y[0]-c[0],y[1]-c[1])<=Math.max(c[2]*4,A.size*0.05)); // тот же диаметр, сдвинуто
        if(z){usedA.add(c);usedB.add(z);const dd=Math.hypot(z[0]-c[0],z[1]-c[1]);add('m'+f1(c[2]*2)+'|'+f1(dd),n=>(n>1?n+' отверстия':'отверстие')+' Ø'+f1(c[2]*2)+' смещено на '+f1(dd)+' мм');continue;}
      }
      for(const c of ra)if(!usedA.has(c)){usedA.add(c);add('a'+f1(c[2]*2),n=>(n>1?n+' отверстия':'отверстие')+' Ø'+f1(c[2]*2)+' — только слева');}
      for(const c of rb)if(!usedB.has(c)){usedB.add(c);add('b'+f1(c[2]*2),n=>(n>1?n+' отверстия':'отверстие')+' Ø'+f1(c[2]*2)+' — только справа');}
      for(const g of grp.values())items.push(g.t(g.n));
      // участки контура, не объяснённые отверстиями
      const runLen=(rs,circ)=>{let L=0;for(const r of rs){const x0=r.x[0],y0=r.y[0];if(r.x.length<2)continue;
          let inb=false;for(let i=0;i<r.x.length;i++)if(r.x[i]>=bb[0]-1e-6&&r.x[i]<=bb[2]+1e-6&&r.y[i]>=bb[1]-1e-6&&r.y[i]<=bb[3]+1e-6){inb=true;break;}
          if(!inb)continue;let mid=Math.floor(r.x.length/2),onC=circ.some(c=>Math.abs(Math.hypot(r.x[mid]-c[0],r.y[mid]-c[1])-c[2])<=tol*2);if(onC)continue;
          for(let i=1;i<r.x.length;i++)L+=Math.hypot(r.x[i]-r.x[i-1],r.y[i]-r.y[i-1]);}return L;};
      const la=runLen(d.a.runs,ca),lb=runLen(d.b.runs,cb.map(c=>c));
      if(la>tol*5||lb>tol*5){
        if(la>tol*5&&lb>tol*5){ // насколько разошлись: среднее расстояние от участка B до участка A
          let s=0,n=0;const pa=[];for(const r of d.a.runs)for(let i=0;i<r.x.length;i++)if(r.x[i]>=bb[0]&&r.x[i]<=bb[2]&&r.y[i]>=bb[1]&&r.y[i]<=bb[3])pa.push(r.x[i],r.y[i]);
          for(const r of d.b.runs)for(let i=0;i<r.x.length;i+=3){if(!(r.x[i]>=bb[0]&&r.x[i]<=bb[2]&&r.y[i]>=bb[1]&&r.y[i]<=bb[3]))continue;let m=Infinity;for(let j=0;j<pa.length;j+=2)m=Math.min(m,Math.hypot(pa[j]-r.x[i],pa[j+1]-r.y[i]));if(isFinite(m)){s+=m;n++;}}
          const sh=n?s/n:0;
          const mx=Math.max(la,lb);items.push(sh<=Math.max(1,mx*0.05)&&Math.abs(la-lb)<0.3*mx?'контур изменён: сдвиг ≈ '+f1(sh)+' мм на участке '+f1(Math.max(la,lb))+' мм':'контур изменён: слева '+f1(la)+' мм, справа '+f1(lb)+' мм');
        }else if(la>tol*5)items.push('участок контура '+f1(la)+' мм — только слева');
        else items.push('участок контура '+f1(lb)+' мм — только справа');
      }
      if(!items.length)items.push('мелкое отличие');
      return {bb,text:items.join('; ')};
    });
  }
  function compare(docA,docB,tol,M0){ // M0 — положение B задано вручную (без автоподбора)
    const A=prep(docA,tol),B=prep(docB,tol);
    if(!A.n||!B.n)return {A,B,M:[1,0,0,1,0,0],fail:'Нет геометрии для сравнения'};
    const al=M0?{M:M0,mir:M0[0]*M0[3]-M0[1]*M0[2]<0}:align(A,B,tol);const M=al?al.M:[1,0,0,1,0,0];
    const d=diff(A,B,M,tol);let desc=[];try{desc=describe(A,B,M,d,tol);}catch(e){desc=d.clusters.map(bb=>({bb,text:'отличие'}));}
    return Object.assign({A,B,M,mir:al&&al.mir,sizeA:[A.bbox[2]-A.bbox[0],A.bbox[3]-A.bbox[1]],sizeB:[B.bbox[2]-B.bbox[0],B.bbox[3]-B.bbox[1]],desc},d);
  }
  /* =====================================================================
     АНАЛИЗ ДЕТАЛИ для таблицы и проверки перед резкой: контуры, площадь, длина реза, врезки, замечания.
     R — правила: {s (толщина), join, minLen, gapMax, holeK, holeAbs, webK, webAbs, chk:{open,gap,dup,small,hole,web,text,out}}
     Каждое замечание: {k (вид), text, x, y, bb}
     ===================================================================== */
  function analyze(doc,R){
    R=R||{};const eps=R.join||0.01,chord=Math.min(0.01,eps);
    const issues=[],add=(k,text,x,y,bb)=>issues.push({k,text,x,y,bb:bb||[x-1,y-1,x+1,y+1]});
    const f=v=>{const r=Math.round(v*100)/100;return String(r).replace('.',',');};
    // 1) элементы как ломаные; одинаковые (двойные линии) — убрать и отметить
    const P=[],seen=new Map();let nText=0;
    for(const G of doc.groups||[]){if(G.off)continue;if(G.texts)nText+=G.texts.length;
      for(const p of G.prims){
        let o=[];
        if(p[0]==='L')o=[p[1],p[2],p[3],p[4]];
        else if(p[0]==='C')arcPts(o,p[1],p[2],p[3],0,TAU,true,chord,true);
        else if(p[0]==='A')arcPts(o,p[1],p[2],p[3],p[4],p[5],true,chord,true);
        else if(p[0]==='P'){const a=p[2],n=a.length/3,segs=p[1]?n:n-1;if(n<2)continue;o=[a[0],a[1]];
          for(let i=0;i<segs;i++){const j=(i+1)%n,x1=a[i*3],y1=a[i*3+1],x2=a[j*3],y2=a[j*3+1],b=a[i*3+2],A=b?bulgeArc(x1,y1,x2,y2,b):null;
            if(A)arcPts(o,A.cx,A.cy,A.r,A.a0,A.a1,A.ccw,chord,false);else o.push(x2,y2);}}
        if(o.length<4)continue;
        let len=0;for(let i=2;i<o.length;i+=2)len+=Math.hypot(o[i]-o[i-2],o[i+1]-o[i-1]);
        const q=v=>Math.round(v/0.01),e1=q(o[0])+','+q(o[1]),e2=q(o[o.length-2])+','+q(o[o.length-1]),
          mid=Math.floor(o.length/4)*2,key=[e1,e2].sort().join('|')+'|'+Math.round(len*100)+'|'+q(o[mid])+','+q(o[mid+1]);
        if(seen.has(key)){if(R.chk&&R.chk.dup)add('dup','двойная линия (лежит точно поверх другой)',o[mid],o[mid+1]);continue;}
        seen.set(key,1);
        if(R.chk&&R.chk.small&&len<(R.minLen||0.1))add('small',len<0.005?'элемент нулевой длины':'очень мелкий элемент: '+f(len)+' мм',o[0],o[1]);
        P.push({o,len,circle:p[0]==='C'?p[3]:0});
      }}
    // 2) сборка контуров: концы ближе eps — один узел
    const nodes=[],grid=new Map(),cell=eps*2;
    const node=(x,y)=>{const gx=Math.floor(x/cell),gy=Math.floor(y/cell);
      for(let i=-1;i<=1;i++)for(let j=-1;j<=1;j++){const L=grid.get((gx+i)+','+(gy+j));if(L)for(const n of L){const N=nodes[n];if(Math.hypot(N.x-x,N.y-y)<=eps)return n;}}
      const id=nodes.length;nodes.push({x,y,e:[]});const k=gx+','+gy;(grid.get(k)||grid.set(k,[]).get(k)).push(id);return id;};
    const E=P.map((p,i)=>{const o=p.o,a=node(o[0],o[1]),b=node(o[o.length-2],o[o.length-1]);nodes[a].e.push(i);nodes[b].e.push(i);return {a,b,p};});
    // компоненты
    const comp=new Int32Array(E.length).fill(-1),C=[];
    for(let i=0;i<E.length;i++){if(comp[i]>=0)continue;const id=C.length,st=[i],es=[];comp[i]=id;
      while(st.length){const k=st.pop();es.push(k);for(const n of [E[k].a,E[k].b])for(const j of nodes[n].e)if(comp[j]<0){comp[j]=id;st.push(j);}}
      C.push(es);}
    const contours=[];
    for(const es of C){
      const ns=new Map();for(const k of es)for(const n of [E[k].a,E[k].b])ns.set(n,(ns.get(n)||0)+(E[k].a===E[k].b?2:1)/(E[k].a===E[k].b?2:1));
      let deg=new Map();for(const k of es){deg.set(E[k].a,(deg.get(E[k].a)||0)+1);deg.set(E[k].b,(deg.get(E[k].b)||0)+1);}
      const ends=[...deg].filter(([n,d])=>d===1).map(([n])=>n),branch=[...deg].filter(([n,d])=>d>2).map(([n])=>n);
      let len=0,x0=Infinity,y0=Infinity,x1=-Infinity,y1=-Infinity;
      for(const k of es){const o=E[k].p.o;len+=E[k].p.len;for(let i=0;i<o.length;i+=2){const x=o[i],y=o[i+1];if(x<x0)x0=x;if(x>x1)x1=x;if(y<y0)y0=y;if(y>y1)y1=y;}}
      const c={es,len,bb:[x0,y0,x1,y1],closed:!ends.length&&!branch.length,ends,branch,area:0,poly:null,circle:es.length===1?E[es[0]].p.circle:0};
      if(c.closed){ // обход по кругу — многоугольник для площади и «внутри / снаружи»
        const pts=[];let k=es[0],at=E[k].a;const used=new Set();
        for(let guard=0;guard<es.length;guard++){used.add(k);const o=E[k].p.o,fw=E[k].a===at;
          if(fw)for(let i=0;i<o.length-2;i+=2)pts.push(o[i],o[i+1]);else for(let i=o.length-2;i>0;i-=2)pts.push(o[i],o[i+1]);
          at=fw?E[k].b:E[k].a;const nx=nodes[at].e.find(j=>!used.has(j)&&comp[j]===comp[k]);if(nx===undefined)break;k=nx;}
        let A=0;for(let i=0;i<pts.length;i+=2){const j=(i+2)%pts.length;A+=pts[i]*pts[j+1]-pts[j]*pts[i+1];}
        c.area=Math.abs(A)/2;c.poly=pts;
      }
      contours.push(c);
    }
    const closed=contours.filter(c=>c.closed&&c.area>0);
    const inside=(poly,x,y)=>{let r=false;for(let i=0,j=poly.length-2;i<poly.length;j=i,i+=2){const xi=poly[i],yi=poly[i+1],xj=poly[j],yj=poly[j+1];if(((yi>y)!==(yj>y))&&(x<(xj-xi)*(y-yi)/(yj-yi)+xi))r=!r;}return r;};
    const outer=closed.reduce((m,c)=>!m||c.area>m.area?c:m,null);
    let area=0,holes=[];
    if(outer){area=outer.area;
      for(const c of closed){if(c===outer)continue;const x=c.poly[0],y=c.poly[1];
        if(inside(outer.poly,x,y)){c.hole=true;holes.push(c);}else{c.out=true;}}
      for(const h of holes){h.top=!holes.some(o=>o!==h&&o.area>h.area&&inside(o.poly,h.poly[0],h.poly[1]));if(h.top)area-=h.area;}
    }
    // 3) незамкнутые контуры и разрывы
    const openC=contours.filter(c=>!c.closed);
    if(R.chk&&(R.chk.open||R.chk.gap)){
      const endPts=[];for(const c of openC)for(const n of c.ends)endPts.push({c,n,x:nodes[n].x,y:nodes[n].y});
      const gm=R.gapMax||2,EG=new Map(),gk=(x,y)=>Math.floor(x/gm)+','+Math.floor(y/gm);
      for(const e of endPts){const k=gk(e.x,e.y);(EG.get(k)||EG.set(k,[]).get(k)).push(e);}
      const done=new Set(),doneN=new Set();let ng=0;
      for(const e of endPts){if(done.has(e))continue;let best=null,bd=gm;const gx=Math.floor(e.x/gm),gy=Math.floor(e.y/gm);
        for(let i=-1;i<=1;i++)for(let j=-1;j<=1;j++){const L=EG.get((gx+i)+','+(gy+j));if(L)for(const q of L){if(q===e||done.has(q))continue;const d=Math.hypot(q.x-e.x,q.y-e.y);if(d<bd){bd=d;best=q;}}}
        if(best&&R.chk.gap){done.add(e);done.add(best);doneN.add(e.n);doneN.add(best.n);if(++ng<=200)add('gap','разрыв контура '+f(bd)+' мм',(e.x+best.x)/2,(e.y+best.y)/2,[Math.min(e.x,best.x),Math.min(e.y,best.y),Math.max(e.x,best.x),Math.max(e.y,best.y)]);}}
      if(R.chk.open){let no=0;for(const c of openC){if(no>=200)break;const free=c.ends.filter(n=>!doneN.has(n));no++;
        if(c.branch.length)add('open','контур с ответвлением (наложенные линии)',nodes[c.branch[0]].x,nodes[c.branch[0]].y,c.bb);
        else if(free.length)add('open','незамкнутый контур ('+(c.es.length===1&&E[c.es[0]].p.o.length===4?'отрезок ':'')+f(c.len)+' мм)',nodes[free[0]].x,nodes[free[0]].y,c.bb);}
        if(openC.length>200)add('open','и ещё незамкнутых контуров: '+(openC.length-200),0,0);}
    }
    // 4) лишнее: надписи, элементы вне детали
    if(R.chk&&R.chk.text&&nText)add('text','в файле есть надписи: '+nText+' (на резку не нужны?)',outer?outer.bb[0]:0,outer?outer.bb[3]:0,outer?outer.bb:null);
    if(R.chk&&R.chk.out&&outer)for(const c of contours)if(c!==outer&&(c.out||(!c.closed&&!(c.bb[0]>=outer.bb[0]-eps&&c.bb[2]<=outer.bb[2]+eps&&c.bb[1]>=outer.bb[1]-eps&&c.bb[3]<=outer.bb[3]+eps))))
      add('out','элемент вне контура детали',(c.bb[0]+c.bb[2])/2,(c.bb[1]+c.bb[3])/2,c.bb);
    // 5) отверстия и перемычки — от толщины
    const s=+R.s||0,dMin=Math.max(R.holeAbs||0,(R.holeK||0)*s),wMin=Math.max(R.webAbs||0,(R.webK||0)*s);
    if(R.chk&&R.chk.hole&&dMin>0)for(const h of holes){if(!h.top)continue;const d=h.circle?h.circle*2:Math.min(h.bb[2]-h.bb[0],h.bb[3]-h.bb[1]);
      if(d<dMin-1e-6)add('hole',(h.circle?'отверстие Ø'+f(d):'вырез шириной '+f(d)+' мм')+' меньше '+f(dMin)+(s?' (толщина '+f(s)+')':''),(h.bb[0]+h.bb[2])/2,(h.bb[1]+h.bb[3])/2,h.bb);}
    if(R.chk&&R.chk.web&&wMin>0&&outer){
      const cs=[outer,...holes.filter(h=>h.top)],segs=[];
      cs.forEach((c,ci)=>{for(let i=0;i<c.poly.length;i+=2){const j=(i+2)%c.poly.length;segs.push([c.poly[i],c.poly[i+1],c.poly[j],c.poly[j+1],ci]);}});
      const cl=Math.max(wMin*2,1),G=new Map();
      segs.forEach((g,si)=>{const i0=Math.floor(Math.min(g[0],g[2])/cl),i1=Math.floor(Math.max(g[0],g[2])/cl),j0=Math.floor(Math.min(g[1],g[3])/cl),j1=Math.floor(Math.max(g[1],g[3])/cl);
        for(let i=i0;i<=i1;i++)for(let j=j0;j<=j1;j++){const k=i+','+j;(G.get(k)||G.set(k,[]).get(k)).push(si);}});
      const pair=new Map();
      cs.forEach((c,ci)=>{const P=c.poly,st=Math.max(wMin/3,0.2);
        for(let i=0;i<P.length;i+=2){const j=(i+2)%P.length,L=Math.hypot(P[j]-P[i],P[j+1]-P[i+1]),n=Math.max(1,Math.ceil(L/st));
          for(let t=0;t<n;t++){const x=P[i]+(P[j]-P[i])*t/n,y=P[i+1]+(P[j+1]-P[i+1])*t/n,gx=Math.floor(x/cl),gy=Math.floor(y/cl);
            for(let a=-1;a<=1;a++)for(let b=-1;b<=1;b++){const L2=G.get((gx+a)+','+(gy+b));if(!L2)continue;
              for(const si of L2){const g=segs[si];if(g[4]<=ci)continue;const dx=g[2]-g[0],dy=g[3]-g[1],l=dx*dx+dy*dy;let u=l?((x-g[0])*dx+(y-g[1])*dy)/l:0;u=u<0?0:u>1?1:u;
                const d=Math.hypot(x-g[0]-u*dx,y-g[1]-u*dy);if(d<wMin-1e-6){const k=ci+'|'+g[4],o=pair.get(k);if(!o||d<o.d)pair.set(k,{d,x,y,px:g[0]+u*dx,py:g[1]+u*dy});}}}}}});
      for(const [k,o] of pair)add('web','перемычка '+f(o.d)+' мм меньше '+f(wMin)+(s?' (толщина '+f(s)+')':''),(o.x+o.px)/2,(o.y+o.py)/2,[Math.min(o.x,o.px),Math.min(o.y,o.py),Math.max(o.x,o.px),Math.max(o.y,o.py)]);
    }
    let cut=0;for(const c of contours)cut+=c.len;
    return {area,outerArea:outer?outer.area:0,holes:holes.filter(h=>h.top).length,cut,pierces:contours.length,open:openC.length,
      bb:outer?outer.bb:null,size:outer?[outer.bb[2]-outer.bb[0],outer.bb[3]-outer.bb[1]]:null,issues};
  }
  return {prep,align,diff,compare,mul,bulgeArc,analyze};
}
const GEO=GEOCORE();
/* сравнение в отдельном потоке, чтобы окно не замирало на больших файлах */
const geoCompare=(()=>{
  let w=null,seq=0;const wait=new Map();
  function start(){
    try{
      const src='const GEO=('+GEOCORE.toString()+')();onmessage=e=>{const {id,a,b,tol,M,ana}=e.data;let r,err=null;if(ana){try{r=GEO.analyze(a,ana);}catch(x){err=String(x&&x.message||x);}postMessage({id,r,err});return;}try{r=GEO.compare(a,b,tol,M);'+
        'r={M:r.M,mir:r.mir,same:r.same,fail:r.fail,clusters:r.clusters||[],a:r.a?{runs:r.a.runs,bad:r.a.bad,frac:r.a.frac}:null,b:r.b?{runs:r.b.runs,bad:r.b.bad,frac:r.b.frac}:null,'+
        'LA:r.A.L,LB:r.LB||[],sizeA:r.sizeA,sizeB:r.sizeB,bbA:r.A.bbox,desc:r.desc||[]};}catch(x){err=String(x&&x.message||x);}postMessage({id,r,err});};';
      w=new Worker(URL.createObjectURL(new Blob([src],{type:'text/javascript'})));
      w.onmessage=e=>{const p=wait.get(e.data.id);if(!p)return;wait.delete(e.data.id);e.data.err?p.rej(new Error(e.data.err)):p.res(e.data.r);};
      w.onerror=()=>{for(const p of wait.values())p.rej(new Error('Сбой потока сравнения'));wait.clear();w=null;};
    }catch(e){w=null;}
  }
  const slim=d=>({groups:(d.groups||[]).map(G=>({off:!!G.off,prims:G.prims,texts:G.texts?G.texts.map(()=>0):undefined}))});
  const fn=(docA,docB,tol,M)=>{
    if(!w)start();
    if(!w){const r=GEO.compare(docA,docB,tol,M);return Promise.resolve(Object.assign(r,{LA:r.A.L,bbA:r.A.bbox}));}
    const id=++seq;return new Promise((res,rej)=>{wait.set(id,{res,rej});w.postMessage({id,a:slim(docA),b:slim(docB),tol,M:M||null});});
  };
  fn.analyze=(doc,R)=>{ // анализ детали (площадь, рез, проверка) — тоже в потоке
    if(!w)start();
    if(!w)return Promise.resolve(GEO.analyze(doc,R));
    const id=++seq;return new Promise((res,rej)=>{wait.set(id,{res,rej});w.postMessage({id,a:slim(doc),ana:R});});
  };
  return fn;
})();

